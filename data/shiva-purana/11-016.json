{"book":"shiva-purana","n":397,"title":"वायवीयसंहिता, पूर्वभाग · अध्याय १६","src":"https://sa.wikisource.org/wiki/%E0%A4%B6%E0%A4%BF%E0%A4%B5%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%B8%E0%A4%82%E0%A4%B9%E0%A4%BF%E0%A4%A4%E0%A4%BE_%E0%A5%AD_%28%E0%A4%B5%E0%A4%BE%E0%A4%AF%E0%A4%B5%E0%A5%80%E0%A4%AF%E0%A4%B8%E0%A4%82%E0%A4%B9%E0%A4%BF%E0%A4%A4%E0%A4%BE%29/%E0%A4%AA%E0%A5%82%E0%A4%B0%E0%A5%8D%E0%A4%B5_%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%83/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%AC","items":[{"id":"397.1","n":"१","text":"वायुरुवाच\nअथ देवो महादेवो महाजलदनादया ॥ १","tr":"vāyuruvāca\natha devo mahādevo mahājaladanādayā || 1"},{"id":"397.2","n":"१","text":"वाचा मधुरगंभीरशिवदश्लक्ष्णवर्णया ॥ १","tr":"vācā madhuragaṃbhīraśivadaślakṣṇavarṇayā || 1"},{"id":"397.3","n":"२","text":"अर्थसंपन्नपदया राजलक्षणयुक्तया ॥ २","tr":"arthasaṃpannapadayā rājalakṣaṇayuktayā || 2"},{"id":"397.4","n":"२","text":"अशेषविषयारंभरक्षाविमलदक्षया ॥ २","tr":"aśeṣaviṣayāraṃbharakṣāvimaladakṣayā || 2"},{"id":"397.5","n":"३","text":"मनोहरतरोदारमधुरस्मितपूर्वया ॥ ३","tr":"manoharatarodāramadhurasmitapūrvayā || 3"},{"id":"397.6","n":"३","text":"संबभाषे सुसंपीतो विश्वकर्माणमीश्वरः ॥ ३","tr":"saṃbabhāṣe susaṃpīto viśvakarmāṇamīśvaraḥ || 3"},{"id":"397.7","n":"४","speaker":"ईश्वर उवाच","text":"वत्स वत्स महाभाग मम पुत्र पितामह ॥ ४","tr":"vatsa vatsa mahābhāga mama putra pitāmaha || 4"},{"id":"397.8","n":"४","text":"ज्ञातमेव मया सर्वं तव वाक्यस्य गौरवम् ॥ ४","tr":"jñātameva mayā sarvaṃ tava vākyasya gauravam || 4"},{"id":"397.9","n":"५","text":"प्रजानामेव बृद्ध्यर्थं तपस्तप्तं त्वयाधुना ॥ ५","tr":"prajānāmeva bṛddhyarthaṃ tapastaptaṃ tvayādhunā || 5"},{"id":"397.10","n":"५","text":"तपसा ऽनेन तुष्टोस्मि ददामि च तवेप्सितम् ॥ ५","tr":"tapasā 'nena tuṣṭosmi dadāmi ca tavepsitam || 5"},{"id":"397.11","n":"६","text":"इत्युक्त्वा परमोदारं स्वभावमधुरं वचः ॥ ६","tr":"ityuktvā paramodāraṃ svabhāvamadhuraṃ vacaḥ || 6"},{"id":"397.12","n":"६","text":"ससर्ज वपुषो भागाद्देवीं देववरो हरः ॥ ६","tr":"sasarja vapuṣo bhāgāddevīṃ devavaro haraḥ || 6"},{"id":"397.13","n":"७","text":"यामाहुर्ब्रह्मविद्वांसो देवीं दिव्यगुणान्विताम् ॥ ७","tr":"yāmāhurbrahmavidvāṃso devīṃ divyaguṇānvitām || 7"},{"id":"397.14","n":"७","text":"परस्य परमां शक्तिं भवस्य परमात्मनः ॥ ७","tr":"parasya paramāṃ śaktiṃ bhavasya paramātmanaḥ || 7"},{"id":"397.15","n":"८","text":"यस्यां न खलु विद्यंते जन्म मृत्युजरादयः ॥ ८","tr":"yasyāṃ na khalu vidyaṃte janma mṛtyujarādayaḥ || 8"},{"id":"397.16","n":"८","text":"या भवानी भवस्यांगात्समाविरभवत्किल ॥ ८","tr":"yā bhavānī bhavasyāṃgātsamāvirabhavatkila || 8"},{"id":"397.17","n":"९","text":"यस्या वाचो निवर्तन्ते मनसा चेंद्रियैः सह ॥ ९","tr":"yasyā vāco nivartante manasā ceṃdriyaiḥ saha || 9"},{"id":"397.18","n":"९","text":"सा भर्तुर्वपुषो भागाज्जातेव समदृश्यत ॥ ९","tr":"sā bharturvapuṣo bhāgājjāteva samadṛśyata || 9"},{"id":"397.19","n":"१०","text":"या सा जगदिदं कृत्स्नं महिम्ना व्याप्य तिष्ठति ॥ १०","tr":"yā sā jagadidaṃ kṛtsnaṃ mahimnā vyāpya tiṣṭhati || 10"},{"id":"397.20","n":"१०","text":"शरीरिणीव स देवी विचित्रं समलक्ष्यत ॥ १०","tr":"śarīriṇīva sa devī vicitraṃ samalakṣyata || 10"},{"id":"397.21","n":"११","text":"सर्वं जगदिदं चैषा संमोहयति मायया ॥ ११","tr":"sarvaṃ jagadidaṃ caiṣā saṃmohayati māyayā || 11"},{"id":"397.22","n":"११","text":"ईश्वरात्सैव जाताभूदजाता परमार्थतः ॥ ११","tr":"īśvarātsaiva jātābhūdajātā paramārthataḥ || 11"},{"id":"397.23","n":"१२","text":"न यस्या परमो भावः सुराणामपि गोचरः ॥ १२","tr":"na yasyā paramo bhāvaḥ surāṇāmapi gocaraḥ || 12"},{"id":"397.24","n":"१२","text":"विश्वामरेश्वरी चैव विभक्ता भर्तुरंगतः ॥ १२","tr":"viśvāmareśvarī caiva vibhaktā bharturaṃgataḥ || 12"},{"id":"397.25","n":"१३","text":"तां दृष्ट्वा परमेशानीं सर्वलोकमहेश्वरीम् ॥ १३","tr":"tāṃ dṛṣṭvā parameśānīṃ sarvalokamaheśvarīm || 13"},{"id":"397.26","n":"१३","text":"सर्वज्ञां सर्वगां सूक्ष्मां सदसद्व्यक्तिवर्जिताम् ॥ १३","tr":"sarvajñāṃ sarvagāṃ sūkṣmāṃ sadasadvyaktivarjitām || 13"},{"id":"397.27","n":"१४","text":"परमां निखिलं भासा भासयन्तीमिदं जगत् ॥ १४","tr":"paramāṃ nikhilaṃ bhāsā bhāsayantīmidaṃ jagat || 14"},{"id":"397.28","n":"१४","text":"प्रणिपत्य महादेवीं प्रार्थयामास वै विराट् ॥ १४","tr":"praṇipatya mahādevīṃ prārthayāmāsa vai virāṭ || 14"},{"id":"397.29","n":"१५","text":"ब्रह्मोवाच\nदेवि देवेन सृष्टो ऽहमादौ सर्वजगन्मयि ॥ १५","tr":"brahmovāca\ndevi devena sṛṣṭo 'hamādau sarvajaganmayi || 15"},{"id":"397.30","n":"१५","text":"प्रजासर्गे नियुक्तश्च सृजामि सकलं जगत् ॥ १५","tr":"prajāsarge niyuktaśca sṛjāmi sakalaṃ jagat || 15"},{"id":"397.31","n":"१६","text":"मनसा निर्मिताः सर्वे देवि देवादयो मया ॥ १६","tr":"manasā nirmitāḥ sarve devi devādayo mayā || 16"},{"id":"397.32","n":"१६","text":"न वृद्धिमुपगच्छन्ति सृज्यमानाः पुनः पुनः ॥ १६","tr":"na vṛddhimupagacchanti sṛjyamānāḥ punaḥ punaḥ || 16"},{"id":"397.33","n":"१७","text":"मिथुनप्रभवामेव कृत्वा सृष्टिमतः परम् ॥ १७","tr":"mithunaprabhavāmeva kṛtvā sṛṣṭimataḥ param || 17"},{"id":"397.34","n":"१७","text":"संवर्धयितुमिच्छामि सर्वा एव मम प्रजाः ॥ १७","tr":"saṃvardhayitumicchāmi sarvā eva mama prajāḥ || 17"},{"id":"397.35","n":"१८","text":"न निर्गतं पुरा त्वत्तो नारीणां कुलमव्ययम् ॥ १८","tr":"na nirgataṃ purā tvatto nārīṇāṃ kulamavyayam || 18"},{"id":"397.36","n":"१८","text":"तेन नारीकुलं स्रष्टुं शक्तिर्मम न विद्यते ॥ १८","tr":"tena nārīkulaṃ sraṣṭuṃ śaktirmama na vidyate || 18"},{"id":"397.37","n":"१९","text":"सर्वासामेव शक्तीनां त्वत्तः खलु समुद्भवः ॥ १९","tr":"sarvāsāmeva śaktīnāṃ tvattaḥ khalu samudbhavaḥ || 19"},{"id":"397.38","n":"१९","text":"तस्मात्सर्वत्र सर्वेषां सर्वशक्तिप्रदायिनीम् ॥ १९","tr":"tasmātsarvatra sarveṣāṃ sarvaśaktipradāyinīm || 19"},{"id":"397.39","n":"२०","text":"त्वामेव वरदां मायां प्रार्थयामि सुरेश्वरीम् ॥ २०","tr":"tvāmeva varadāṃ māyāṃ prārthayāmi sureśvarīm || 20"},{"id":"397.40","n":"२०","text":"चराचरविवृद्ध्यर्थमंशेनैकेन सर्वगे ॥ २०","tr":"carācaravivṛddhyarthamaṃśenaikena sarvage || 20"},{"id":"397.41","n":"२१","text":"दक्षस्य मम पुत्रस्य पुत्री भव भवार्दिनि ॥ २१","tr":"dakṣasya mama putrasya putrī bhava bhavārdini || 21"},{"id":"397.42","n":"२१","text":"एवं सा याचिता देवी ब्रह्मणा ब्रह्मयोनिना ॥ २१","tr":"evaṃ sā yācitā devī brahmaṇā brahmayoninā || 21"},{"id":"397.43","n":"२२","text":"शक्तिमेकां भ्रुवोर्मध्यात्ससर्जात्मसमप्रभाम् ॥ २२","tr":"śaktimekāṃ bhruvormadhyātsasarjātmasamaprabhām || 22"},{"id":"397.44","n":"२२","text":"तामाह प्रहसन्प्रेक्ष्य देवदेववरो हरः ॥ २२","tr":"tāmāha prahasanprekṣya devadevavaro haraḥ || 22"},{"id":"397.45","n":"२३","text":"ब्रह्माणं तपसाराध्य कुरु तस्य यथेप्सितम् ॥ २३","tr":"brahmāṇaṃ tapasārādhya kuru tasya yathepsitam || 23"},{"id":"397.46","n":"२३","text":"तामाज्ञां परमेशस्य शिरसा प्रतिगृह्य सा ॥ २३","tr":"tāmājñāṃ parameśasya śirasā pratigṛhya sā || 23"},{"id":"397.47","n":"२४","text":"ब्रह्मणो वचनाद्देवी दक्षस्य दुहिताभवत् ॥ २४","tr":"brahmaṇo vacanāddevī dakṣasya duhitābhavat || 24"},{"id":"397.48","n":"२४","text":"दत्त्वैवमतुलां शक्तिं ब्रह्मणे ब्रह्मरूपिणीम् ॥ २४","tr":"dattvaivamatulāṃ śaktiṃ brahmaṇe brahmarūpiṇīm || 24"},{"id":"397.49","n":"२५","text":"विवेश देहं देवस्य देवश्चांतरधीयत ॥ २५","tr":"viveśa dehaṃ devasya devaścāṃtaradhīyata || 25"},{"id":"397.50","n":"२५","text":"तदा प्रभृति लोके ऽस्मिन् स्त्रियां भोगः प्रतिष्ठितः ॥ २५","tr":"tadā prabhṛti loke 'smin striyāṃ bhogaḥ pratiṣṭhitaḥ || 25"},{"id":"397.51","n":"२६","text":"प्रजासृष्टिश्च विप्रेंद्रा मैथुनेन प्रवर्तते ॥ २६","tr":"prajāsṛṣṭiśca vipreṃdrā maithunena pravartate || 26"},{"id":"397.52","n":"२६","text":"ब्रह्मापि प्राप सानन्दं सन्तोषं मुनिपुंगवाः ॥ २६","tr":"brahmāpi prāpa sānandaṃ santoṣaṃ munipuṃgavāḥ || 26"},{"id":"397.53","n":"२७","text":"एतद्वस्सर्वमाख्यातं देव्याः शक्तिसमुद्भवम् ॥ २७","tr":"etadvassarvamākhyātaṃ devyāḥ śaktisamudbhavam || 27"},{"id":"397.54","n":"२७","text":"पुण्यवृद्धिकरं श्राव्यं भूतसर्गानुपंगतः ॥ २७","tr":"puṇyavṛddhikaraṃ śrāvyaṃ bhūtasargānupaṃgataḥ || 27"},{"id":"397.55","n":"२८","text":"य इदं कीर्तयेन्नित्यं देव्याः शक्तिसमुद्भवम् ॥ २८","tr":"ya idaṃ kīrtayennityaṃ devyāḥ śaktisamudbhavam || 28"},{"id":"397.56","n":"२८","text":"पुण्यं सर्वमवाप्नोति पुत्रांश्च लभते शुभान् ॥ २८","tr":"puṇyaṃ sarvamavāpnoti putrāṃśca labhate śubhān || 28"}]}