{"book":"shiva-purana","n":454,"title":"वायवीयसंहिता, उत्तरभाग · अध्याय ३८","src":"https://sa.wikisource.org/wiki/%E0%A4%B6%E0%A4%BF%E0%A4%B5%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%B8%E0%A4%82%E0%A4%B9%E0%A4%BF%E0%A4%A4%E0%A4%BE_%E0%A5%AD_%28%E0%A4%B5%E0%A4%BE%E0%A4%AF%E0%A4%B5%E0%A5%80%E0%A4%AF%E0%A4%B8%E0%A4%82%E0%A4%B9%E0%A4%BF%E0%A4%A4%E0%A4%BE%29/%E0%A4%89%E0%A4%A4%E0%A5%8D%E0%A4%A4%E0%A4%B0_%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%83/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A9%E0%A5%AE","items":[{"id":"454.1","n":"१","text":"उपमन्युरुवाच\nआलस्यं व्याधयस्तीव्राः प्रमादः स्थानसंशयः ॥ १","tr":"upamanyuruvāca\nālasyaṃ vyādhayastīvrāḥ pramādaḥ sthānasaṃśayaḥ || 1"},{"id":"454.2","n":"१","text":"अनवस्थितचित्तत्वमश्रद्धा भ्रांतिदर्शनम् ॥ १","tr":"anavasthitacittatvamaśraddhā bhrāṃtidarśanam || 1"},{"id":"454.3","n":"२","text":"दुःखानि दौर्मनस्यं च विषयेषु च लोलता ॥ २","tr":"duḥkhāni daurmanasyaṃ ca viṣayeṣu ca lolatā || 2"},{"id":"454.4","n":"२","text":"दशैते युञ्जतां पुंसामन्तरायाः प्रकीर्तिताः ॥ २","tr":"daśaite yuñjatāṃ puṃsāmantarāyāḥ prakīrtitāḥ || 2"},{"id":"454.5","n":"३","text":"आलस्यमलसत्त्वं तु योगिनां देहचेतनोः ॥ ३","tr":"ālasyamalasattvaṃ tu yogināṃ dehacetanoḥ || 3"},{"id":"454.6","n":"३","text":"धातुवैषम्यजा दोषा व्याधयः कर्मदोषजाः ॥ ३","tr":"dhātuvaiṣamyajā doṣā vyādhayaḥ karmadoṣajāḥ || 3"},{"id":"454.7","n":"४","text":"प्रमादो नाम योगस्य साधना नाम भावना ॥ ४","tr":"pramādo nāma yogasya sādhanā nāma bhāvanā || 4"},{"id":"454.8","n":"४","text":"इदं वेत्युभयाक्रान्तं विज्ञानं स्थानसंशयः ॥ ४","tr":"idaṃ vetyubhayākrāntaṃ vijñānaṃ sthānasaṃśayaḥ || 4"},{"id":"454.9","n":"५","text":"अप्रतिष्ठा हि मनसस्त्वनवस्थितिरुच्यते ॥ ५","tr":"apratiṣṭhā hi manasastvanavasthitirucyate || 5"},{"id":"454.10","n":"५","text":"अश्रद्धा भावरहिता वृत्तिर्वै योगवर्त्मनि ॥ ५","tr":"aśraddhā bhāvarahitā vṛttirvai yogavartmani || 5"},{"id":"454.11","n":"६","text":"विपर्यस्ता मतिर्या सा भ्रांतिरित्यभिधीयते ॥ ६","tr":"viparyastā matiryā sā bhrāṃtirityabhidhīyate || 6"},{"id":"454.12","n":"६","text":"दुःखमज्ञानजं पुंसां चित्तस्याध्यात्मिकं विदुः ॥ ६","tr":"duḥkhamajñānajaṃ puṃsāṃ cittasyādhyātmikaṃ viduḥ || 6"},{"id":"454.13","n":"७","text":"आधिभौतिकमंगोत्थं यच्च दुःखं पुरा कृतैः ॥ ७","tr":"ādhibhautikamaṃgotthaṃ yacca duḥkhaṃ purā kṛtaiḥ || 7"},{"id":"454.14","n":"७","text":"आधिदैविकमाख्यातमशन्यस्त्रविषादिकम् ॥ ७","tr":"ādhidaivikamākhyātamaśanyastraviṣādikam || 7"},{"id":"454.15","n":"८","text":"इच्छाविघातजं मोक्षं दौर्मनस्यं प्रचक्षते ॥ ८","tr":"icchāvighātajaṃ mokṣaṃ daurmanasyaṃ pracakṣate || 8"},{"id":"454.16","n":"८","text":"विषयेषु विचित्रेषु विभ्रमस्तत्र लोलता ॥ ८","tr":"viṣayeṣu vicitreṣu vibhramastatra lolatā || 8"},{"id":"454.17","n":"९","text":"शान्तेष्वेतेषु विघ्नेषु योगासक्तस्य योगिनः ॥ ९","tr":"śānteṣveteṣu vighneṣu yogāsaktasya yoginaḥ || 9"},{"id":"454.18","n":"९","text":"उपसर्गाः प्रवर्तंते दिव्यास्ते सिद्धिसूचकाः ॥ ९","tr":"upasargāḥ pravartaṃte divyāste siddhisūcakāḥ || 9"},{"id":"454.19","n":"१०","text":"प्रतिभा श्रवणं वार्ता दर्शनास्वादवेदनाः ॥ १०","tr":"pratibhā śravaṇaṃ vārtā darśanāsvādavedanāḥ || 10"},{"id":"454.20","n":"१०","text":"उपसर्गाः षडित्येते व्यये योगस्य सिद्धयः ॥ १०","tr":"upasargāḥ ṣaḍityete vyaye yogasya siddhayaḥ || 10"},{"id":"454.21","n":"११","text":"सूक्ष्मे व्यवहिते ऽतीते विप्रकृष्टे त्वनागते ॥ ११","tr":"sūkṣme vyavahite 'tīte viprakṛṣṭe tvanāgate || 11"},{"id":"454.22","n":"११","text":"प्रतिभा कथ्यते यो ऽर्थे प्रतिभासो यथातथम् ॥ ११","tr":"pratibhā kathyate yo 'rthe pratibhāso yathātatham || 11"},{"id":"454.23","n":"१२","text":"श्रवणं सर्वशब्दानां श्रवणे चाप्रयत्नतः ॥ १२","tr":"śravaṇaṃ sarvaśabdānāṃ śravaṇe cāprayatnataḥ || 12"},{"id":"454.24","n":"१२","text":"वार्त्ता वार्त्तासु विज्ञानं सर्वेषामेव देहिनाम् ॥ १२","tr":"vārttā vārttāsu vijñānaṃ sarveṣāmeva dehinām || 12"},{"id":"454.25","n":"१३","text":"दर्शनं नाम दिव्यानां दर्शनं चाप्रयत्नतः ॥ १३","tr":"darśanaṃ nāma divyānāṃ darśanaṃ cāprayatnataḥ || 13"},{"id":"454.26","n":"१३","text":"तथास्वादश्च दिव्येषु रसेष्वास्वाद उच्यते ॥ १३","tr":"tathāsvādaśca divyeṣu raseṣvāsvāda ucyate || 13"},{"id":"454.27","n":"१४","text":"स्पर्शनाधिगमस्तद्वद्वेदना नाम विश्रुता ॥ १४","tr":"sparśanādhigamastadvadvedanā nāma viśrutā || 14"},{"id":"454.28","n":"१४","text":"गन्धादीनां च दिव्यानामाब्रह्मभुवनाधिपाः ॥ १४","tr":"gandhādīnāṃ ca divyānāmābrahmabhuvanādhipāḥ || 14"},{"id":"454.29","n":"१५","text":"संतिष्ठन्ते च रत्नानि प्रयच्छंति बहूनि च ॥ १५","tr":"saṃtiṣṭhante ca ratnāni prayacchaṃti bahūni ca || 15"},{"id":"454.30","n":"१५","text":"स्वच्छन्दमधुरा वाणी विविधास्यात्प्रवर्तते ॥ १५","tr":"svacchandamadhurā vāṇī vividhāsyātpravartate || 15"},{"id":"454.31","n":"१६","text":"रसायनानि सर्वाणि दिव्याश्चौषधयस्तथा ॥ १६","tr":"rasāyanāni sarvāṇi divyāścauṣadhayastathā || 16"},{"id":"454.32","n":"१६","text":"सिध्यंति प्रणिपत्यैनं दिशंति सुरयोषितः ॥ १६","tr":"sidhyaṃti praṇipatyainaṃ diśaṃti surayoṣitaḥ || 16"},{"id":"454.33","n":"१७","text":"योगसिद्ध्यैकदेशे ऽपि दृष्टे मोक्षे भवेन्मतिः ॥ १७","tr":"yogasiddhyaikadeśe 'pi dṛṣṭe mokṣe bhavenmatiḥ || 17"},{"id":"454.34","n":"१७","text":"दृष्टमेतन्मया यद्वत्तद्वन्मोक्षो भवेदिति ॥ १७","tr":"dṛṣṭametanmayā yadvattadvanmokṣo bhavediti || 17"},{"id":"454.35","n":"१८","text":"कृशता स्थूलता बाल्यं वार्धक्यं चैव यौवनम् ॥ १८","tr":"kṛśatā sthūlatā bālyaṃ vārdhakyaṃ caiva yauvanam || 18"},{"id":"454.36","n":"१८","text":"नानाचातिस्वरूपं च चतुर्णां देहधारणम् ॥ १८","tr":"nānācātisvarūpaṃ ca caturṇāṃ dehadhāraṇam || 18"},{"id":"454.37","n":"१९","text":"पार्थिवांशं विना नित्यं सुरभिर्गन्धसंग्रहः ॥ १९","tr":"pārthivāṃśaṃ vinā nityaṃ surabhirgandhasaṃgrahaḥ || 19"},{"id":"454.38","n":"१९","text":"एवमष्टगुणं प्राहुः पैशाचं पार्थिवं पदम् ॥ १९","tr":"evamaṣṭaguṇaṃ prāhuḥ paiśācaṃ pārthivaṃ padam || 19"},{"id":"454.39","n":"२०","text":"जले निवसनं चैव भूम्यामेवं विनिर्गमः ॥ २०","tr":"jale nivasanaṃ caiva bhūmyāmevaṃ vinirgamaḥ || 20"},{"id":"454.40","n":"२०","text":"इच्छेच्छक्तः स्वयं पातुं समुद्रमपि नातुरः ॥ २०","tr":"icchecchaktaḥ svayaṃ pātuṃ samudramapi nāturaḥ || 20"},{"id":"454.41","n":"२१","text":"यत्रेच्छति जगत्यस्मिंस्तत्रैव जलदर्शनम् ॥ २१","tr":"yatrecchati jagatyasmiṃstatraiva jaladarśanam || 21"},{"id":"454.42","n":"२१","text":"विना कुम्भादिकं पाणौ जलसञ्चयधारणम् ॥ २१","tr":"vinā kumbhādikaṃ pāṇau jalasañcayadhāraṇam || 21"},{"id":"454.43","n":"२२","text":"यद्वस्तु विरसञ्चापि भोक्तुमिच्छति तत्क्षणात् ॥ २२","tr":"yadvastu virasañcāpi bhoktumicchati tatkṣaṇāt || 22"},{"id":"454.44","n":"२२","text":"रसादिकं भवेच्चान्यत्त्रयाणां देहधारणम् ॥ २२","tr":"rasādikaṃ bhaveccānyattrayāṇāṃ dehadhāraṇam || 22"},{"id":"454.45","n":"२३","text":"निर्व्रणत्वं शरीरस्य पार्थिवैश्च समन्वितम् ॥ २३","tr":"nirvraṇatvaṃ śarīrasya pārthivaiśca samanvitam || 23"},{"id":"454.46","n":"२३","text":"तदिदं षोडशगुणमाप्यमैश्वर्यमद्भुतम् ॥ २३","tr":"tadidaṃ ṣoḍaśaguṇamāpyamaiśvaryamadbhutam || 23"},{"id":"454.47","n":"२४","text":"शरीरादग्निनिर्माणं तत्तापभयवर्जनम् ॥ २४","tr":"śarīrādagninirmāṇaṃ tattāpabhayavarjanam || 24"},{"id":"454.48","n":"२४","text":"शक्तिर्जगदिदं दग्धुं यदीच्छेदप्रयत्नतः ॥ २४","tr":"śaktirjagadidaṃ dagdhuṃ yadīcchedaprayatnataḥ || 24"},{"id":"454.49","n":"२५","text":"स्थापनं वानलस्या ऽप्सु पाणौ पावकधारणम् ॥ २५","tr":"sthāpanaṃ vānalasyā 'psu pāṇau pāvakadhāraṇam || 25"},{"id":"454.50","n":"२५","text":"दग्धे सर्गे यथापूर्वं मुखे चान्नादिपाचनम् ॥ २५","tr":"dagdhe sarge yathāpūrvaṃ mukhe cānnādipācanam || 25"},{"id":"454.51","n":"२५","text":"द्वाभ्यां देहविनिर्माणमाप्यैश्वर्यसमन्वितम् ॥ २५","tr":"dvābhyāṃ dehavinirmāṇamāpyaiśvaryasamanvitam || 25"},{"id":"454.52","n":"२६","text":"एतच्चतुर्विंशतिधा तैजसं परिचक्षते ॥ २६","tr":"etaccaturviṃśatidhā taijasaṃ paricakṣate || 26"},{"id":"454.53","n":"२६","text":"मनोजवत्वं भूतानां क्षणादन्तःप्रवेशनम् ॥ २६","tr":"manojavatvaṃ bhūtānāṃ kṣaṇādantaḥpraveśanam || 26"},{"id":"454.54","n":"२७","text":"पर्वतादिमहाभारधारणञ्चाप्रयत्नतः ॥ २७","tr":"parvatādimahābhāradhāraṇañcāprayatnataḥ || 27"},{"id":"454.55","n":"२७","text":"गुरुत्वञ्च लघुत्वञ्च पाणावनिलधारणम् ॥ २७","tr":"gurutvañca laghutvañca pāṇāvaniladhāraṇam || 27"},{"id":"454.56","n":"२८","text":"अंगुल्यग्रनिपाताद्यैर्भूमेरपि च कम्पनम् ॥ २८","tr":"aṃgulyagranipātādyairbhūmerapi ca kampanam || 28"},{"id":"454.57","n":"२८","text":"एकेन देहनिष्पत्तिर्युक्तं भोगैश्च तैजसैः ॥ २८","tr":"ekena dehaniṣpattiryuktaṃ bhogaiśca taijasaiḥ || 28"},{"id":"454.58","n":"२९","text":"द्वात्रिंशद्गुणमैश्वर्यं मारुतं कवयो विदुः ॥ २९","tr":"dvātriṃśadguṇamaiśvaryaṃ mārutaṃ kavayo viduḥ || 29"},{"id":"454.59","n":"२९","text":"छायाहीनविनिष्पत्तिरिन्द्रियाणामदर्शनम् ॥ २९","tr":"chāyāhīnaviniṣpattirindriyāṇāmadarśanam || 29"},{"id":"454.60","n":"३०","text":"खेचरत्वं यथाकाममिन्द्रियार्थसमन्वयः ॥ ३०","tr":"khecaratvaṃ yathākāmamindriyārthasamanvayaḥ || 30"},{"id":"454.61","n":"३०","text":"आकाशलंघनं चैव स्वदेहे तन्निवेशनम् ॥ ३०","tr":"ākāśalaṃghanaṃ caiva svadehe tanniveśanam || 30"},{"id":"454.62","n":"३१","text":"आकाशपिण्डीकरणमशरीरत्वमेव च ॥ ३१","tr":"ākāśapiṇḍīkaraṇamaśarīratvameva ca || 31"},{"id":"454.63","n":"३१","text":"अनिलैश्वर्यसंयुक्तं चत्वारिंशद्गुणं महत् ॥ ३१","tr":"anilaiśvaryasaṃyuktaṃ catvāriṃśadguṇaṃ mahat || 31"},{"id":"454.64","n":"३२","text":"ऐन्द्रमैश्वर्यमाख्यातमाम्बरं तत्प्रचक्षते ॥ ३२","tr":"aindramaiśvaryamākhyātamāmbaraṃ tatpracakṣate || 32"},{"id":"454.65","n":"३२","text":"यथाकामोपलब्धिश्च यथाकामविनिर्गमः ॥ ३२","tr":"yathākāmopalabdhiśca yathākāmavinirgamaḥ || 32"},{"id":"454.66","n":"३३","text":"सर्वस्याभिभवश्चैव सर्वगुह्यार्थदर्शनम् ॥ ३३","tr":"sarvasyābhibhavaścaiva sarvaguhyārthadarśanam || 33"},{"id":"454.67","n":"३३","text":"कर्मानुरूपनिर्माणं वशित्वं प्रियदर्शनम् ॥ ३३","tr":"karmānurūpanirmāṇaṃ vaśitvaṃ priyadarśanam || 33"},{"id":"454.68","n":"३४","text":"संसारदर्शनं चैव भोगैरैन्द्रैस्समन्वितम् ॥ ३४","tr":"saṃsāradarśanaṃ caiva bhogairaindraissamanvitam || 34"},{"id":"454.69","n":"३४","text":"एतच्चांद्रमसैश्वर्यं मानसं गुणतो ऽधिकम् ॥ ३४","tr":"etaccāṃdramasaiśvaryaṃ mānasaṃ guṇato 'dhikam || 34"},{"id":"454.70","n":"३५","text":"छेदनं ताडनं चैव बंधनं मोचनं तथा ॥ ३५","tr":"chedanaṃ tāḍanaṃ caiva baṃdhanaṃ mocanaṃ tathā || 35"},{"id":"454.71","n":"३५","text":"ग्रहणं सर्वभूतानां संसारवशवर्तिनाम् ॥ ३५","tr":"grahaṇaṃ sarvabhūtānāṃ saṃsāravaśavartinām || 35"},{"id":"454.72","n":"३६","text":"प्रसादश्चापि सर्वेषां मृत्युकालजयस्तथा ॥ ३६","tr":"prasādaścāpi sarveṣāṃ mṛtyukālajayastathā || 36"},{"id":"454.73","n":"३६","text":"आभिमानिकमैश्वर्यं प्राजापत्यं प्रचक्षते ॥ ३६","tr":"ābhimānikamaiśvaryaṃ prājāpatyaṃ pracakṣate || 36"},{"id":"454.74","n":"३७","text":"एतच्चान्द्रमसैर्भोगैः षट्पञ्चाशद्गुणं महत् ॥ ३७","tr":"etaccāndramasairbhogaiḥ ṣaṭpañcāśadguṇaṃ mahat || 37"},{"id":"454.75","n":"३७","text":"सर्गः संकल्पमात्रेण त्राणं संहरणं तथा ॥ ३७","tr":"sargaḥ saṃkalpamātreṇa trāṇaṃ saṃharaṇaṃ tathā || 37"},{"id":"454.76","n":"३८","text":"स्वाधिकारश्च सर्वेषां भूतचित्तप्रवर्तनम् ॥ ३८","tr":"svādhikāraśca sarveṣāṃ bhūtacittapravartanam || 38"},{"id":"454.77","n":"३८","text":"असादृश्यं च सर्वस्य निर्माणं जगतः पृथक् ॥ ३८","tr":"asādṛśyaṃ ca sarvasya nirmāṇaṃ jagataḥ pṛthak || 38"},{"id":"454.78","n":"३९","text":"शुभाशुभस्य करणं प्राजापत्यैश्च संयुतम् ॥ ३९","tr":"śubhāśubhasya karaṇaṃ prājāpatyaiśca saṃyutam || 39"},{"id":"454.79","n":"३९","text":"चतुष्षष्ठिगुणं ब्राह्ममैश्वर्यं च प्रचक्षते ॥ ३९","tr":"catuṣṣaṣṭhiguṇaṃ brāhmamaiśvaryaṃ ca pracakṣate || 39"},{"id":"454.80","n":"४०","text":"बौद्धादस्मात्परं गौणमैश्वर्यं प्राकृतं विदुः ॥ ४०","tr":"bauddhādasmātparaṃ gauṇamaiśvaryaṃ prākṛtaṃ viduḥ || 40"},{"id":"454.81","n":"४०","text":"वैष्णवं तत्समाख्यातं तस्यैव भुवनस्थितिः ॥ ४०","tr":"vaiṣṇavaṃ tatsamākhyātaṃ tasyaiva bhuvanasthitiḥ || 40"},{"id":"454.82","n":"४०","text":"ब्रह्मणा तत्पदं सर्वं वक्तुमन्यैर्न शक्यते ॥ ४०","tr":"brahmaṇā tatpadaṃ sarvaṃ vaktumanyairna śakyate || 40"},{"id":"454.83","n":"४१","text":"तत्पौरुषं च गौणं च गणेशं पदमैश्वरम् ॥ ४१","tr":"tatpauruṣaṃ ca gauṇaṃ ca gaṇeśaṃ padamaiśvaram || 41"},{"id":"454.84","n":"४१","text":"विष्णुना तत्पदं किंचिज्ज्ञातुमन्यैर्न शक्यते ॥ ४१","tr":"viṣṇunā tatpadaṃ kiṃcijjñātumanyairna śakyate || 41"},{"id":"454.85","n":"४२","text":"विज्ञानसिद्धयश्चैव सर्वा एवौपसर्गिकाः ॥ ४२","tr":"vijñānasiddhayaścaiva sarvā evaupasargikāḥ || 42"},{"id":"454.86","n":"४२","text":"निरोद्धव्या प्रयत्नेन वैराग्येण परेण तु ॥ ४२","tr":"niroddhavyā prayatnena vairāgyeṇa pareṇa tu || 42"},{"id":"454.87","n":"४३","text":"प्रतिभासेष्वशुद्धेषु गुणेष्वासक्तचेतसः ॥ ४३","tr":"pratibhāseṣvaśuddheṣu guṇeṣvāsaktacetasaḥ || 43"},{"id":"454.88","n":"४३","text":"न सिध्येत्परमैश्वर्यमभयं सार्वकामिकम् ॥ ४३","tr":"na sidhyetparamaiśvaryamabhayaṃ sārvakāmikam || 43"},{"id":"454.89","n":"४४","text":"तस्माद्गुणांश्च भोगांश्च देवासुरमहीभृताम् ॥ ४४","tr":"tasmādguṇāṃśca bhogāṃśca devāsuramahībhṛtām || 44"},{"id":"454.90","n":"४४","text":"तृणवद्यस्त्यजेत्तस्य योगसिद्धिः परा भवेत् ॥ ४४","tr":"tṛṇavadyastyajettasya yogasiddhiḥ parā bhavet || 44"},{"id":"454.91","n":"४५","text":"अथवानुग्रहेच्छायां जगतो विचरेन्मुनिः ॥ ४५","tr":"athavānugrahecchāyāṃ jagato vicarenmuniḥ || 45"},{"id":"454.92","n":"४५","text":"यथाकामंगुणान्भोगान्भुक्त्वा मुक्तिं प्रयास्यति ॥ ४५","tr":"yathākāmaṃguṇānbhogānbhuktvā muktiṃ prayāsyati || 45"},{"id":"454.93","n":"४६","text":"अथ प्रयोगं योगस्य वक्ष्ये शृणु समाहितः ॥ ४६","tr":"atha prayogaṃ yogasya vakṣye śṛṇu samāhitaḥ || 46"},{"id":"454.94","n":"४६","text":"शुभे काले शुभे देशे शिवक्षेत्रादिके पुनः ॥ ४६","tr":"śubhe kāle śubhe deśe śivakṣetrādike punaḥ || 46"},{"id":"454.95","n":"४६","text":"विजने जंतुरहिते निःशब्दे बाधवर्जिते ॥ ४६","tr":"vijane jaṃturahite niḥśabde bādhavarjite || 46"},{"id":"454.96","n":"४७","text":"सुप्रलिप्ते स्थले सौम्ये गन्धधूपादिवासिते ॥ ४७","tr":"supralipte sthale saumye gandhadhūpādivāsite || 47"},{"id":"454.97","n":"४७","text":"मुक्तपुष्पसमाकीर्णे वितानादि विचित्रिते ॥ ४७","tr":"muktapuṣpasamākīrṇe vitānādi vicitrite || 47"},{"id":"454.98","n":"४८","text":"कुशपुष्पसमित्तोयफलमूलसमन्विते ॥ ४८","tr":"kuśapuṣpasamittoyaphalamūlasamanvite || 48"},{"id":"454.99","n":"४८","text":"नाग्न्यभ्याशे जलाभ्याशे शुष्कपर्णचये ऽपि वा ॥ ४८","tr":"nāgnyabhyāśe jalābhyāśe śuṣkaparṇacaye 'pi vā || 48"},{"id":"454.100","n":"४९","text":"न दंशमशकाकीर्णे सर्पश्वापदसंकुले ॥ ४९","tr":"na daṃśamaśakākīrṇe sarpaśvāpadasaṃkule || 49"},{"id":"454.101","n":"४९","text":"न च दुष्टमृगाकीर्णे न भये दुर्जनावृते ॥ ४९","tr":"na ca duṣṭamṛgākīrṇe na bhaye durjanāvṛte || 49"},{"id":"454.102","n":"५०","text":"श्मशाने चैत्यवल्मीके जीर्णागारे चतुष्पथे ॥ ५०","tr":"śmaśāne caityavalmīke jīrṇāgāre catuṣpathe || 50"},{"id":"454.103","n":"५०","text":"नदीनदसमुद्राणां तीरे रथ्यांतरे ऽपि वा ॥ ५०","tr":"nadīnadasamudrāṇāṃ tīre rathyāṃtare 'pi vā || 50"},{"id":"454.104","n":"५१","text":"न जीर्णोद्यानगोष्ठादौ नानिष्टे न च निंदिते ॥ ५१","tr":"na jīrṇodyānagoṣṭhādau nāniṣṭe na ca niṃdite || 51"},{"id":"454.105","n":"५१","text":"नाजीर्णाम्लरसोद्गारे न च विण्मूत्रदूषिते ॥ ५१","tr":"nājīrṇāmlarasodgāre na ca viṇmūtradūṣite || 51"},{"id":"454.106","n":"५२","text":"नच्छर्द्यामातिसारे वा नातिभुक्तौ श्रमान्विते ॥ ५२","tr":"nacchardyāmātisāre vā nātibhuktau śramānvite || 52"},{"id":"454.107","n":"५२","text":"न चातिचिंताकुलितो न चातिक्षुत्पिपासितः ॥ ५२","tr":"na cāticiṃtākulito na cātikṣutpipāsitaḥ || 52"},{"id":"454.108","n":"५३","text":"नापि स्वगुरुकर्मादौ प्रसक्तो योगमाचरेत् ॥ ५३","tr":"nāpi svagurukarmādau prasakto yogamācaret || 53"},{"id":"454.109","n":"५३","text":"युक्ताहारविहारश्च युक्तचेष्टश्च कर्मसु ॥ ५३","tr":"yuktāhāravihāraśca yuktaceṣṭaśca karmasu || 53"},{"id":"454.110","n":"५४","text":"युक्तनिद्राप्रबोधश्च सर्वायासविवर्जितः ॥ ५४","tr":"yuktanidrāprabodhaśca sarvāyāsavivarjitaḥ || 54"},{"id":"454.111","n":"५४","text":"आसनं मृदुलं रम्यं विपुलं सुसमं शुचि ॥ ५४","tr":"āsanaṃ mṛdulaṃ ramyaṃ vipulaṃ susamaṃ śuci || 54"},{"id":"454.112","n":"५५","text":"पद्मकस्वस्तिकादीनामभ्यसेदासनेषु च ॥ ५५","tr":"padmakasvastikādīnāmabhyasedāsaneṣu ca || 55"},{"id":"454.113","n":"५५","text":"अभिवंद्य स्वगुर्वंतानभिवाद्याननुक्रमात् ॥ ५५","tr":"abhivaṃdya svagurvaṃtānabhivādyānanukramāt || 55"},{"id":"454.114","n":"५६","text":"ऋजुग्रीवशिरोवक्षा नातिष्ठेच्छिष्टलोचनः ॥ ५६","tr":"ṛjugrīvaśirovakṣā nātiṣṭhecchiṣṭalocanaḥ || 56"},{"id":"454.115","n":"५६","text":"किंचिदुन्नामितशिरा दंतैर्दंतान्न संस्पृशेत् ॥ ५६","tr":"kiṃcidunnāmitaśirā daṃtairdaṃtānna saṃspṛśet || 56"},{"id":"454.116","n":"५७","text":"दंताग्रसंस्थिता जिह्वामचलां सन्निवेश्य च ॥ ५७","tr":"daṃtāgrasaṃsthitā jihvāmacalāṃ sanniveśya ca || 57"},{"id":"454.117","n":"५७","text":"पार्ष्णिभ्यां वृषणौ रक्षंस्तथा प्रजननं पुनः ॥ ५७","tr":"pārṣṇibhyāṃ vṛṣaṇau rakṣaṃstathā prajananaṃ punaḥ || 57"},{"id":"454.118","n":"५८","text":"ऊर्वोरुपरि संस्थाप्य बाहू तिर्यगयत्नतः ॥ ५८","tr":"ūrvorupari saṃsthāpya bāhū tiryagayatnataḥ || 58"},{"id":"454.119","n":"५८","text":"दक्षिणं करपृष्ठं तु न्यस्य वामतलोपरि ॥ ५८","tr":"dakṣiṇaṃ karapṛṣṭhaṃ tu nyasya vāmatalopari || 58"},{"id":"454.120","n":"५९","text":"उन्नाम्य शनकैः पृष्ठमुरो विष्टभ्य चाग्रतः ॥ ५९","tr":"unnāmya śanakaiḥ pṛṣṭhamuro viṣṭabhya cāgrataḥ || 59"},{"id":"454.121","n":"५९","text":"संप्रेक्ष्य नासिकाग्रं स्वं दिशश्चानवलोकयन् ॥ ५९","tr":"saṃprekṣya nāsikāgraṃ svaṃ diśaścānavalokayan || 59"},{"id":"454.122","n":"६०","text":"संभृतप्राणसंचारः पाषाण इव निश्चलः ॥ ६०","tr":"saṃbhṛtaprāṇasaṃcāraḥ pāṣāṇa iva niścalaḥ || 60"},{"id":"454.123","n":"६०","text":"स्वदेहायतनस्यांतर्विचिंत्य शिवमंबया ॥ ६०","tr":"svadehāyatanasyāṃtarviciṃtya śivamaṃbayā || 60"},{"id":"454.124","n":"६१","text":"हृत्पद्मपीठिकामध्ये ध्यानयज्ञेन पूजयेत् ॥ ६१","tr":"hṛtpadmapīṭhikāmadhye dhyānayajñena pūjayet || 61"},{"id":"454.125","n":"६१","text":"मूले नासाग्रतो नाभौ कंठे वा तालुरंध्रयोः ॥ ६१","tr":"mūle nāsāgrato nābhau kaṃṭhe vā tāluraṃdhrayoḥ || 61"},{"id":"454.126","n":"६२","text":"भ्रूमध्ये द्वारदेशे वा ललाटे मूर्ध्नि वा स्मरेत् ॥ ६२","tr":"bhrūmadhye dvāradeśe vā lalāṭe mūrdhni vā smaret || 62"},{"id":"454.127","n":"६२","text":"परिकल्प्य यथान्यायं शिवयोः परमासनम् ॥ ६२","tr":"parikalpya yathānyāyaṃ śivayoḥ paramāsanam || 62"},{"id":"454.128","n":"६३","text":"तत्र सावरणं वापि निरावरणमेव वा ॥ ६३","tr":"tatra sāvaraṇaṃ vāpi nirāvaraṇameva vā || 63"},{"id":"454.129","n":"६३","text":"द्विदले षोडशारे वा द्वादशारे यथाविधि ॥ ६३","tr":"dvidale ṣoḍaśāre vā dvādaśāre yathāvidhi || 63"},{"id":"454.130","n":"६४","text":"दशारे वा षडस्रे वा चतुरस्रे शिवं स्मरेत् ॥ ६४","tr":"daśāre vā ṣaḍasre vā caturasre śivaṃ smaret || 64"},{"id":"454.131","n":"६४","text":"भ्रुवोरंतरतः पद्मं द्विदलं तडिदुज्ज्वलम् ॥ ६४","tr":"bhruvoraṃtarataḥ padmaṃ dvidalaṃ taḍidujjvalam || 64"},{"id":"454.132","n":"६५","text":"भ्रूमध्यस्थारविन्दस्य क्रमाद्वै दक्षिणोत्तरे ॥ ६५","tr":"bhrūmadhyasthāravindasya kramādvai dakṣiṇottare || 65"},{"id":"454.133","n":"६५","text":"विद्युत्समानवर्णे च पर्णे वर्णावसानके ॥ ६५","tr":"vidyutsamānavarṇe ca parṇe varṇāvasānake || 65"},{"id":"454.134","n":"६६","text":"षोडशारस्य पत्राणि स्वराः षोडश तानि वै ॥ ६६","tr":"ṣoḍaśārasya patrāṇi svarāḥ ṣoḍaśa tāni vai || 66"},{"id":"454.135","n":"६६","text":"पूर्वादीनि क्रमादेतत्पद्मं कन्दस्य मूलतः ॥ ६६","tr":"pūrvādīni kramādetatpadmaṃ kandasya mūlataḥ || 66"},{"id":"454.136","n":"६७","text":"ककारादिटकारांता वर्णाः पर्णान्यनुक्रमात् ॥ ६७","tr":"kakārādiṭakārāṃtā varṇāḥ parṇānyanukramāt || 67"},{"id":"454.137","n":"६७","text":"भानुवर्णस्य पद्मस्य ध्येयं तद्१ हृदयान्तरे ॥ ६७","tr":"bhānuvarṇasya padmasya dhyeyaṃ tad1 hṛdayāntare || 67"},{"id":"454.138","n":"६८","text":"गोक्षीरधवलस्योक्ता डादिफान्ता यथाक्रमम् ॥ ६८","tr":"gokṣīradhavalasyoktā ḍādiphāntā yathākramam || 68"},{"id":"454.139","n":"६८","text":"अधो दलस्याम्बुजस्य एतस्य २ च दलानि षट् ॥ ६८","tr":"adho dalasyāmbujasya etasya 2 ca dalāni ṣaṭ || 68"},{"id":"454.140","n":"६९","text":"विधूमांगारवर्णस्य वर्णा वाद्याश्च लान्तिमाः ॥ ६९","tr":"vidhūmāṃgāravarṇasya varṇā vādyāśca lāntimāḥ || 69"},{"id":"454.141","n":"६९","text":"मूलाधारारविंदस्य हेमाभस्य यथाक्रमम् ॥ ६९","tr":"mūlādhārāraviṃdasya hemābhasya yathākramam || 69"},{"id":"454.142","n":"६९","text":"वकारादिसकारान्ता वर्णाः पर्णमयाः स्थिताः ॥ ६९","tr":"vakārādisakārāntā varṇāḥ parṇamayāḥ sthitāḥ || 69"},{"id":"454.143","n":"७०","text":"एतेष्वथारविंदेषु यत्रैवाभिरतं मनः ॥ ७०","tr":"eteṣvathāraviṃdeṣu yatraivābhirataṃ manaḥ || 70"},{"id":"454.144","n":"७०","text":"तत्रैव देवं देवीं च चिंतयेद्धीरया धिया ॥ ७०","tr":"tatraiva devaṃ devīṃ ca ciṃtayeddhīrayā dhiyā || 70"},{"id":"454.145","n":"७१","text":"अंगुष्ठमात्रममलं दीप्यमानं समंततः ॥ ७१","tr":"aṃguṣṭhamātramamalaṃ dīpyamānaṃ samaṃtataḥ || 71"},{"id":"454.146","n":"७१","text":"शुद्धदीपशिखाकारं स्वशक्त्या पूर्णमण्डितम् ॥ ७१","tr":"śuddhadīpaśikhākāraṃ svaśaktyā pūrṇamaṇḍitam || 71"},{"id":"454.147","n":"७२","text":"इन्दुरेखासमाकारं तारारूपमथापि वा ॥ ७२","tr":"indurekhāsamākāraṃ tārārūpamathāpi vā || 72"},{"id":"454.148","n":"७२","text":"नीवारशूकस्सदृशं बिससुत्राभमेव वा ॥ ७२","tr":"nīvāraśūkassadṛśaṃ bisasutrābhameva vā || 72"},{"id":"454.149","n":"७३","text":"कदम्बगोलकाकारं तुषारकणिकोपमम् ॥ ७३","tr":"kadambagolakākāraṃ tuṣārakaṇikopamam || 73"},{"id":"454.150","n":"७३","text":"क्षित्यादितत्त्वविजयं ध्याता यद्यपि वाञ्छति ॥ ७३","tr":"kṣityāditattvavijayaṃ dhyātā yadyapi vāñchati || 73"},{"id":"454.151","n":"७४","text":"तत्तत्तत्त्वाधिपामेव मूर्तिं स्थूलां विचिंतयेत् ॥ ७४","tr":"tattattattvādhipāmeva mūrtiṃ sthūlāṃ viciṃtayet || 74"},{"id":"454.152","n":"७४","text":"सदाशिवांता ब्रह्माद्यभवाद्याश्चाष्टमूर्तयः ॥ ७४","tr":"sadāśivāṃtā brahmādyabhavādyāścāṣṭamūrtayaḥ || 74"},{"id":"454.153","n":"७५","text":"शिवस्य मूर्तयः स्थूलाः शिवशास्त्रे विनिश्चिताः ॥ ७५","tr":"śivasya mūrtayaḥ sthūlāḥ śivaśāstre viniścitāḥ || 75"},{"id":"454.154","n":"७५","text":"घोरा मिश्रा प्रशान्ताश्च मूर्तयस्ता मुनीश्वरैः ॥ ७५","tr":"ghorā miśrā praśāntāśca mūrtayastā munīśvaraiḥ || 75"},{"id":"454.155","n":"७६","text":"फलाभिलाषरहितैश्चिन्त्याश्चिन्ताविशारदैः ॥ ७६","tr":"phalābhilāṣarahitaiścintyāścintāviśāradaiḥ || 76"},{"id":"454.156","n":"७६","text":"घोराश्चेच्चिंतिताः कुर्युः पापरोगपरिक्षयम् ॥ ७६","tr":"ghorāścecciṃtitāḥ kuryuḥ pāparogaparikṣayam || 76"},{"id":"454.157","n":"७७","text":"चिरेण मिश्रे सौम्ये तु न सद्यो न चिरादपि ॥ ७७","tr":"cireṇa miśre saumye tu na sadyo na cirādapi || 77"},{"id":"454.158","n":"७७","text":"सौम्ये मुक्तिर्विशेषेण शांतिः प्रज्ञा प्रसिध्यति ॥ ७७","tr":"saumye muktirviśeṣeṇa śāṃtiḥ prajñā prasidhyati || 77"},{"id":"454.159","n":"७८","text":"सिध्यंति सिद्धयश्चात्र क्रमशो नात्र संशयः ॥ ७८","tr":"sidhyaṃti siddhayaścātra kramaśo nātra saṃśayaḥ || 78"}]}