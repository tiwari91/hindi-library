{"book":"shiva-purana","n":410,"title":"वायवीयसंहिता, पूर्वभाग · अध्याय २९","src":"https://sa.wikisource.org/wiki/%E0%A4%B6%E0%A4%BF%E0%A4%B5%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%B8%E0%A4%82%E0%A4%B9%E0%A4%BF%E0%A4%A4%E0%A4%BE_%E0%A5%AD_%28%E0%A4%B5%E0%A4%BE%E0%A4%AF%E0%A4%B5%E0%A5%80%E0%A4%AF%E0%A4%B8%E0%A4%82%E0%A4%B9%E0%A4%BF%E0%A4%A4%E0%A4%BE%29/%E0%A4%AA%E0%A5%82%E0%A4%B0%E0%A5%8D%E0%A4%B5_%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%83/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A8%E0%A5%AF","items":[{"id":"410.1","n":"१","text":"वायुरुवाच\nनिवेदयामि जगतो वागर्थात्म्यं कृतं यथा ॥ १","tr":"vāyuruvāca\nnivedayāmi jagato vāgarthātmyaṃ kṛtaṃ yathā || 1"},{"id":"410.2","n":"१","text":"षडध्ववेदनं सम्यक्समासान्न तु विस्तरात् ॥ १","tr":"ṣaḍadhvavedanaṃ samyaksamāsānna tu vistarāt || 1"},{"id":"410.3","n":"२","text":"नास्ति कश्चिदशब्दार्थो नापि शब्दो निरर्थकः ॥ २","tr":"nāsti kaścidaśabdārtho nāpi śabdo nirarthakaḥ || 2"},{"id":"410.4","n":"२","text":"ततो हि समये शब्दस्सर्वस्सर्वार्थबोधकः ॥ २","tr":"tato hi samaye śabdassarvassarvārthabodhakaḥ || 2"},{"id":"410.5","n":"३","text":"प्रकृतेः परिणामो ऽयं द्विधा शब्दार्थभावना ॥ ३","tr":"prakṛteḥ pariṇāmo 'yaṃ dvidhā śabdārthabhāvanā || 3"},{"id":"410.6","n":"३","text":"तामाहुः प्राकृतीं मूर्तिं शिवयोः परमात्मनोः ॥ ३","tr":"tāmāhuḥ prākṛtīṃ mūrtiṃ śivayoḥ paramātmanoḥ || 3"},{"id":"410.7","n":"४","text":"शब्दात्मिका विभूतिर्या सा त्रिधा कथ्यते बुधैः ॥ ४","tr":"śabdātmikā vibhūtiryā sā tridhā kathyate budhaiḥ || 4"},{"id":"410.8","n":"४","text":"स्थूला सूक्ष्मा परा चेति स्थूला या श्रुतिगोचरा ॥ ४","tr":"sthūlā sūkṣmā parā ceti sthūlā yā śrutigocarā || 4"},{"id":"410.9","n":"५","text":"सूक्ष्मा चिन्तामयी प्रोक्ता चिंतया रहिता परा ॥ ५","tr":"sūkṣmā cintāmayī proktā ciṃtayā rahitā parā || 5"},{"id":"410.10","n":"५","text":"या शक्तिः सा परा शक्तिश्शिवतत्त्वसमाश्रया ॥ ५","tr":"yā śaktiḥ sā parā śaktiśśivatattvasamāśrayā || 5"},{"id":"410.11","n":"६","text":"ज्ञानशक्तिसमायोगादिच्छोपोद्बलिका तथा ॥ ६","tr":"jñānaśaktisamāyogādicchopodbalikā tathā || 6"},{"id":"410.12","n":"६","text":"सर्वशक्तिसमष्ट्यात्मा शक्तितत्त्वसमाख्यया ॥ ६","tr":"sarvaśaktisamaṣṭyātmā śaktitattvasamākhyayā || 6"},{"id":"410.13","n":"७","text":"समस्तकार्यजातस्य मूलप्रकृतितां गता ॥ ७","tr":"samastakāryajātasya mūlaprakṛtitāṃ gatā || 7"},{"id":"410.14","n":"७","text":"सैव कुण्डलिनी माया शुद्धाध्वपरमा सती ॥ ७","tr":"saiva kuṇḍalinī māyā śuddhādhvaparamā satī || 7"},{"id":"410.15","n":"८","text":"सा विभागस्वरूपैव षडध्वात्मा विजृंभते ॥ ८","tr":"sā vibhāgasvarūpaiva ṣaḍadhvātmā vijṛṃbhate || 8"},{"id":"410.16","n":"८","text":"तत्र शब्दास्त्रयो ऽध्वानस्त्रयश्चार्थाः समीरिताः ॥ ८","tr":"tatra śabdāstrayo 'dhvānastrayaścārthāḥ samīritāḥ || 8"},{"id":"410.17","n":"९","text":"सर्वेषामपि वै पुंसां नैजशुद्ध्यनुरूपतः ॥ ९","tr":"sarveṣāmapi vai puṃsāṃ naijaśuddhyanurūpataḥ || 9"},{"id":"410.18","n":"९","text":"लयभोगाधिकारास्स्युस्सर्वतत्त्वविभागतः ॥ ९","tr":"layabhogādhikārāssyussarvatattvavibhāgataḥ || 9"},{"id":"410.19","n":"१०","text":"कलाभिस्तानि तत्त्वानि व्याप्तान्येव यथातथम् ॥ १०","tr":"kalābhistāni tattvāni vyāptānyeva yathātatham || 10"},{"id":"410.20","n":"१०","text":"परस्याः प्रकृतेरादौ पञ्चधा परिणामतः ॥ १०","tr":"parasyāḥ prakṛterādau pañcadhā pariṇāmataḥ || 10"},{"id":"410.21","n":"११","text":"कलाश्च ता निवृत्त्याद्याः पर्याप्ता इति निश्चयः ॥ ११","tr":"kalāśca tā nivṛttyādyāḥ paryāptā iti niścayaḥ || 11"},{"id":"410.22","n":"११","text":"मंत्राध्वा च पदाध्वा च वर्णाध्वा चेति शब्दतः ॥ ११","tr":"maṃtrādhvā ca padādhvā ca varṇādhvā ceti śabdataḥ || 11"},{"id":"410.23","n":"१२","text":"भुवनाध्वा च तत्त्वाध्वा कलाध्वा चार्थतः क्रमात् ॥ १२","tr":"bhuvanādhvā ca tattvādhvā kalādhvā cārthataḥ kramāt || 12"},{"id":"410.24","n":"१२","text":"अत्रान्योन्यं च सर्वेषां व्याप्यव्यापकतोच्यते ॥ १२","tr":"atrānyonyaṃ ca sarveṣāṃ vyāpyavyāpakatocyate || 12"},{"id":"410.25","n":"१३","text":"मंत्राः सर्वैः पदैर्व्याप्ता वाक्यभावात्पदानि च ॥ १३","tr":"maṃtrāḥ sarvaiḥ padairvyāptā vākyabhāvātpadāni ca || 13"},{"id":"410.26","n":"१३","text":"वर्णैर्वर्णसमूहं हि पदमाहुर्विपश्चितः ॥ १३","tr":"varṇairvarṇasamūhaṃ hi padamāhurvipaścitaḥ || 13"},{"id":"410.27","n":"१४","text":"वर्णास्तु भुवनैर्व्याप्तास्तेषां तेषूपलंभनात् ॥ १४","tr":"varṇāstu bhuvanairvyāptāsteṣāṃ teṣūpalaṃbhanāt || 14"},{"id":"410.28","n":"१४","text":"भुवनान्यपि तत्त्वौघैरुत्पत्त्यांतर्बहिष्क्रमात् ॥ १४","tr":"bhuvanānyapi tattvaughairutpattyāṃtarbahiṣkramāt || 14"},{"id":"410.29","n":"१५","text":"व्याप्तानि कारणैस्तत्त्वैरारब्धत्वादनेकशः ॥ १५","tr":"vyāptāni kāraṇaistattvairārabdhatvādanekaśaḥ || 15"},{"id":"410.30","n":"१५","text":"अंतरादुत्थितानीह भुवनानि तु कानिचित् ॥ १५","tr":"aṃtarādutthitānīha bhuvanāni tu kānicit || 15"},{"id":"410.31","n":"१६","text":"पौराणिकानि चान्यानि विज्ञेयानि शिवागमे ॥ १६","tr":"paurāṇikāni cānyāni vijñeyāni śivāgame || 16"},{"id":"410.32","n":"१६","text":"सांख्ययोगप्रसिद्धानि तत्त्वान्यपि च कानिचित् ॥ १६","tr":"sāṃkhyayogaprasiddhāni tattvānyapi ca kānicit || 16"},{"id":"410.33","n":"१७","text":"शिवशास्त्रप्रसिद्धानि ततोन्यान्यपि कृत्स्नशः ॥ १७","tr":"śivaśāstraprasiddhāni tatonyānyapi kṛtsnaśaḥ || 17"},{"id":"410.34","n":"१७","text":"कलाभिस्तानि तत्त्वानि व्याप्तान्येव यथातथम् ॥ १७","tr":"kalābhistāni tattvāni vyāptānyeva yathātatham || 17"},{"id":"410.35","n":"१८","text":"परस्याः प्रकृतेरादौ पञ्चधा परिणामतः ॥ १८","tr":"parasyāḥ prakṛterādau pañcadhā pariṇāmataḥ || 18"},{"id":"410.36","n":"१८","text":"कलाश्च ता निवृत्त्याद्या व्याप्ताः पञ्च यथोत्तरम् ॥ १८","tr":"kalāśca tā nivṛttyādyā vyāptāḥ pañca yathottaram || 18"},{"id":"410.37","n":"१९","text":"व्यापिकातः परा शक्तिरविभक्ता षडध्वनाम् ॥ १९","tr":"vyāpikātaḥ parā śaktiravibhaktā ṣaḍadhvanām || 19"},{"id":"410.38","n":"१९","text":"परप्रकृतिभावस्य तत्सत्त्वाच्छिवतत्त्वतः ॥ १९","tr":"paraprakṛtibhāvasya tatsattvācchivatattvataḥ || 19"},{"id":"410.39","n":"२०","text":"शक्त्यादि च पृथिव्यन्तं शिवतत्त्वसमुद्भवम् ॥ २०","tr":"śaktyādi ca pṛthivyantaṃ śivatattvasamudbhavam || 20"},{"id":"410.40","n":"२०","text":"व्याप्तमेकेन तेनैव मृदा कुंभादिकं यथा ॥ २०","tr":"vyāptamekena tenaiva mṛdā kuṃbhādikaṃ yathā || 20"},{"id":"410.41","n":"२१","text":"शैवं तत्परमं धाम यत्प्राप्यं षड्भिरध्वभिः ॥ २१","tr":"śaivaṃ tatparamaṃ dhāma yatprāpyaṃ ṣaḍbhiradhvabhiḥ || 21"},{"id":"410.42","n":"२१","text":"व्यापिका ऽव्यापिका शक्तिः पञ्चतत्त्वविशोधनात् ॥ २१","tr":"vyāpikā 'vyāpikā śaktiḥ pañcatattvaviśodhanāt || 21"},{"id":"410.43","n":"२२","text":"निवृत्त्या रुद्रपर्यन्तं स्थितिरण्डस्य शोध्यते ॥ २२","tr":"nivṛttyā rudraparyantaṃ sthitiraṇḍasya śodhyate || 22"},{"id":"410.44","n":"२२","text":"प्रतिष्ठया तदूर्ध्वं तु यावदव्यक्तगोचरम् ॥ २२","tr":"pratiṣṭhayā tadūrdhvaṃ tu yāvadavyaktagocaram || 22"},{"id":"410.45","n":"२३","text":"तदूर्ध्वं विद्यया मध्ये यावद्विश्वेश्वरावधि ॥ २३","tr":"tadūrdhvaṃ vidyayā madhye yāvadviśveśvarāvadhi || 23"},{"id":"410.46","n":"२३","text":"शान्त्या तदूर्ध्वं मध्वान्ते विशुद्धिः शान्त्यतीतया ॥ २३","tr":"śāntyā tadūrdhvaṃ madhvānte viśuddhiḥ śāntyatītayā || 23"},{"id":"410.47","n":"२४","text":"यामाहुः परमं व्योम परप्रकृतियोगतः ॥ २४","tr":"yāmāhuḥ paramaṃ vyoma paraprakṛtiyogataḥ || 24"},{"id":"410.48","n":"२४","text":"एतानि पञ्चतत्त्वानि यैर्व्याप्तमखिलं जगत् ॥ २४","tr":"etāni pañcatattvāni yairvyāptamakhilaṃ jagat || 24"},{"id":"410.49","n":"२५","text":"तत्रैव सर्वमेवेदं द्रष्टव्यं खलु साधकैः ॥ २५","tr":"tatraiva sarvamevedaṃ draṣṭavyaṃ khalu sādhakaiḥ || 25"},{"id":"410.50","n":"२५","text":"अध्वव्याप्तिमविज्ञाय शुद्धिं यः कर्तुमिच्छति ॥ २५","tr":"adhvavyāptimavijñāya śuddhiṃ yaḥ kartumicchati || 25"},{"id":"410.51","n":"२६","text":"स विप्रलम्भकः शुद्धेर्नालम्प्रापयितुं फलम् ॥ २६","tr":"sa vipralambhakaḥ śuddhernālamprāpayituṃ phalam || 26"},{"id":"410.52","n":"२६","text":"वृथा परिश्रमस्तस्य निरयायैव केवलम् ॥ २६","tr":"vṛthā pariśramastasya nirayāyaiva kevalam || 26"},{"id":"410.53","n":"२७","text":"शक्तिपातसमायोगादृते तत्त्वानि तत्त्वतः ॥ २७","tr":"śaktipātasamāyogādṛte tattvāni tattvataḥ || 27"},{"id":"410.54","n":"२७","text":"तद्व्याप्तिस्तद्विवृद्धिश्च ज्ञातुमेवं न शक्यते ॥ २७","tr":"tadvyāptistadvivṛddhiśca jñātumevaṃ na śakyate || 27"},{"id":"410.55","n":"२८","text":"शक्तिराज्ञा परा शैवी चिद्रूपा मरमेश्वरी ॥ २८","tr":"śaktirājñā parā śaivī cidrūpā marameśvarī || 28"},{"id":"410.56","n":"२८","text":"शिवो ऽधितिष्ठत्यखिलं यया कारणभूतया ॥ २८","tr":"śivo 'dhitiṣṭhatyakhilaṃ yayā kāraṇabhūtayā || 28"},{"id":"410.57","n":"२९","text":"नात्मनो नैव मायैषा न विकारो विचारतः ॥ २९","tr":"nātmano naiva māyaiṣā na vikāro vicārataḥ || 29"},{"id":"410.58","n":"२९","text":"न बंधो नापि मुक्तिश्च बंधमुक्तिविधायिनी ॥ २९","tr":"na baṃdho nāpi muktiśca baṃdhamuktividhāyinī || 29"},{"id":"410.59","n":"३०","text":"सर्वैश्वर्यपराकाष्टा शिवस्य व्यभिचारिणी ॥ ३०","tr":"sarvaiśvaryaparākāṣṭā śivasya vyabhicāriṇī || 30"},{"id":"410.60","n":"३०","text":"समानधर्मिणी तस्य तैस्तैर्भावैर्विशेषतः ॥ ३०","tr":"samānadharmiṇī tasya taistairbhāvairviśeṣataḥ || 30"},{"id":"410.61","n":"३१","text":"स तयैव गृही सापि तेनैव गृहिणी सदा ॥ ३१","tr":"sa tayaiva gṛhī sāpi tenaiva gṛhiṇī sadā || 31"},{"id":"410.62","n":"३१","text":"तयोरपत्यं यत्कार्यं परप्रकृतिजं जगत् ॥ ३१","tr":"tayorapatyaṃ yatkāryaṃ paraprakṛtijaṃ jagat || 31"},{"id":"410.63","n":"३२","text":"स कर्ता कारणं सेति तयोर्भेदो व्यवस्थितः ॥ ३२","tr":"sa kartā kāraṇaṃ seti tayorbhedo vyavasthitaḥ || 32"},{"id":"410.64","n":"३२","text":"एक एव शिवः साक्षाद्द्विधा ऽसौ समवस्थितः ॥ ३२","tr":"eka eva śivaḥ sākṣāddvidhā 'sau samavasthitaḥ || 32"},{"id":"410.65","n":"३३","text":"स्त्रीपुंसभावेन तयोर्भेद इत्यपि केचन ॥ ३३","tr":"strīpuṃsabhāvena tayorbheda ityapi kecana || 33"},{"id":"410.66","n":"३३","text":"अपरे तु परा शक्तिः शिवस्य समवायिनी ॥ ३३","tr":"apare tu parā śaktiḥ śivasya samavāyinī || 33"},{"id":"410.67","n":"३४","text":"प्रभेव भानोश्चिद्रूपा भिन्नैवेति व्यवस्थितः ॥ ३४","tr":"prabheva bhānościdrūpā bhinnaiveti vyavasthitaḥ || 34"},{"id":"410.68","n":"३४","text":"तस्माच्छिवः परो हेतुस्तस्याज्ञा परमेश्वरी ॥ ३४","tr":"tasmācchivaḥ paro hetustasyājñā parameśvarī || 34"},{"id":"410.69","n":"३५","text":"तयैव प्रेरिता शैवी मूलप्रकृतिरव्यया ॥ ३५","tr":"tayaiva preritā śaivī mūlaprakṛtiravyayā || 35"},{"id":"410.70","n":"३५","text":"महामाया च माया च प्रकृतिस्त्रिगुणेति च ॥ ३५","tr":"mahāmāyā ca māyā ca prakṛtistriguṇeti ca || 35"},{"id":"410.71","n":"३६","text":"त्रिविधा कार्यवेधेन सा प्रसूते षडध्वनः ॥ ३६","tr":"trividhā kāryavedhena sā prasūte ṣaḍadhvanaḥ || 36"},{"id":"410.72","n":"३६","text":"स वागर्थमयश्चाध्वा षड्विधो निखिलं जगत् ॥ ३६","tr":"sa vāgarthamayaścādhvā ṣaḍvidho nikhilaṃ jagat || 36"},{"id":"410.73","n":"३७","text":"अस्यैव विस्तरं प्राहुः शास्त्रजातमशेषतः ॥ ३७","tr":"asyaiva vistaraṃ prāhuḥ śāstrajātamaśeṣataḥ || 37"}]}