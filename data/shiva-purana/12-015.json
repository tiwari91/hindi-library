{"book":"shiva-purana","n":431,"title":"वायवीयसंहिता, उत्तरभाग · अध्याय १५","src":"https://sa.wikisource.org/wiki/%E0%A4%B6%E0%A4%BF%E0%A4%B5%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%B8%E0%A4%82%E0%A4%B9%E0%A4%BF%E0%A4%A4%E0%A4%BE_%E0%A5%AD_%28%E0%A4%B5%E0%A4%BE%E0%A4%AF%E0%A4%B5%E0%A5%80%E0%A4%AF%E0%A4%B8%E0%A4%82%E0%A4%B9%E0%A4%BF%E0%A4%A4%E0%A4%BE%29/%E0%A4%89%E0%A4%A4%E0%A5%8D%E0%A4%A4%E0%A4%B0_%E0%A4%AD%E0%A4%BE%E0%A4%97%E0%A4%83/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%AB","items":[{"id":"431.1","n":"१","speaker":"श्रीकृष्ण उवाच","text":"भगवान्मंत्रमाहात्म्यं भवता कथितं प्रभो ॥ १","tr":"bhagavānmaṃtramāhātmyaṃ bhavatā kathitaṃ prabho || 1"},{"id":"431.2","n":"१","text":"तत्प्रयोगविधानं च साक्षाच्छ्रुतिसमं यथा ॥ १","tr":"tatprayogavidhānaṃ ca sākṣācchrutisamaṃ yathā || 1"},{"id":"431.3","n":"२","text":"इदानीं श्रोतुमिच्छामि शिवसंस्कारमुत्तमम् ॥ २","tr":"idānīṃ śrotumicchāmi śivasaṃskāramuttamam || 2"},{"id":"431.4","n":"२","text":"मंत्रसंग्रहणे किंचित्सूचितन्न तु विस्मृतम् ॥ २","tr":"maṃtrasaṃgrahaṇe kiṃcitsūcitanna tu vismṛtam || 2"},{"id":"431.5","n":"३","text":"उपमन्युरुवाच\nहन्त ते कथयिष्यामि सर्वपापविशोधनम् ॥ ३","tr":"upamanyuruvāca\nhanta te kathayiṣyāmi sarvapāpaviśodhanam || 3"},{"id":"431.6","n":"३","text":"संस्कारं परमं पुण्यं शिवेन पतिभाषितम् ॥ ३","tr":"saṃskāraṃ paramaṃ puṇyaṃ śivena patibhāṣitam || 3"},{"id":"431.7","n":"४","text":"सम्यक्कृताधिकारः स्यात्पूजादिषु नरो यतः ॥ ४","tr":"samyakkṛtādhikāraḥ syātpūjādiṣu naro yataḥ || 4"},{"id":"431.8","n":"४","text":"संस्कारः कथ्यते तेन षडध्वपरिशोधनम् ॥ ४","tr":"saṃskāraḥ kathyate tena ṣaḍadhvapariśodhanam || 4"},{"id":"431.9","n":"५","text":"दीयते येन विज्ञानं क्षीयते पाशबंधनम् ॥ ५","tr":"dīyate yena vijñānaṃ kṣīyate pāśabaṃdhanam || 5"},{"id":"431.10","n":"५","text":"तस्मात्संस्कार एवायं दीक्षेत्यपि च कथ्यते ॥ ५","tr":"tasmātsaṃskāra evāyaṃ dīkṣetyapi ca kathyate || 5"},{"id":"431.11","n":"६","text":"शांभवी चैव शाक्ती च मांत्री चैव शिवागमे ॥ ६","tr":"śāṃbhavī caiva śāktī ca māṃtrī caiva śivāgame || 6"},{"id":"431.12","n":"६","text":"दीक्षोपदिश्यते त्रेधा शिवेन परमात्मना ॥ ६","tr":"dīkṣopadiśyate tredhā śivena paramātmanā || 6"},{"id":"431.13","n":"७","text":"गुरोरालोकमात्रेण स्पर्शात्संभाषणादपि ॥ ७","tr":"gurorālokamātreṇa sparśātsaṃbhāṣaṇādapi || 7"},{"id":"431.14","n":"७","text":"सद्यस्संज्ञा भवेज्जंतोः पाशोपक्षयकारिणी ॥ ७","tr":"sadyassaṃjñā bhavejjaṃtoḥ pāśopakṣayakāriṇī || 7"},{"id":"431.15","n":"८","text":"सा दीक्षा शांभवी प्रोक्ता सा पुनर्भिद्यते द्विधा ॥ ८","tr":"sā dīkṣā śāṃbhavī proktā sā punarbhidyate dvidhā || 8"},{"id":"431.16","n":"८","text":"तीव्रा तीव्रतरा चेति पाशो पक्षयभेदतः ॥ ८","tr":"tīvrā tīvratarā ceti pāśo pakṣayabhedataḥ || 8"},{"id":"431.17","n":"९","text":"यया स्यान्निर्वृतिः सद्यस्सैव तीव्रतरा मता ॥ ९","tr":"yayā syānnirvṛtiḥ sadyassaiva tīvratarā matā || 9"},{"id":"431.18","n":"९","text":"तीव्रा तु जीवतोत्यंतं पुंसः पापविशोधिका ॥ ९","tr":"tīvrā tu jīvatotyaṃtaṃ puṃsaḥ pāpaviśodhikā || 9"},{"id":"431.19","n":"१०","text":"शक्ती ज्ञानवती दीक्षा शिष्यदेहं प्रविश्य तु ॥ १०","tr":"śaktī jñānavatī dīkṣā śiṣyadehaṃ praviśya tu || 10"},{"id":"431.20","n":"१०","text":"गुरुणा योगमार्गेण क्रियते ज्ञानचक्षुषा ॥ १०","tr":"guruṇā yogamārgeṇa kriyate jñānacakṣuṣā || 10"},{"id":"431.21","n":"११","text":"मांत्री क्रियावती दीक्षा कुंडमंडलपूर्विका ॥ ११","tr":"māṃtrī kriyāvatī dīkṣā kuṃḍamaṃḍalapūrvikā || 11"},{"id":"431.22","n":"११","text":"मंदमंदतरोद्देशात्कर्तव्या गुरुणा बहिः ॥ ११","tr":"maṃdamaṃdataroddeśātkartavyā guruṇā bahiḥ || 11"},{"id":"431.23","n":"१२","text":"शक्तिपातानुसारेण शिष्यो ऽनुग्रहमर्हति ॥ १२","tr":"śaktipātānusāreṇa śiṣyo 'nugrahamarhati || 12"},{"id":"431.24","n":"१२","text":"शैवधर्मानुसारस्य तन्मूलत्वात्समासतः ॥ १२","tr":"śaivadharmānusārasya tanmūlatvātsamāsataḥ || 12"},{"id":"431.25","n":"१३","text":"यत्र शक्तिर्न पतिता तत्र शुद्धिर्न जायते ॥ १३","tr":"yatra śaktirna patitā tatra śuddhirna jāyate || 13"},{"id":"431.26","n":"१३","text":"न विद्या न शिवाचारो न मुक्तिर्न च सिद्धयः ॥ १३","tr":"na vidyā na śivācāro na muktirna ca siddhayaḥ || 13"},{"id":"431.27","n":"१४","text":"तस्माल्लिंगानि संवीक्ष्य शक्तिपातस्य भूयसः ॥ १४","tr":"tasmālliṃgāni saṃvīkṣya śaktipātasya bhūyasaḥ || 14"},{"id":"431.28","n":"१४","text":"ज्ञानेन क्रियया वाथ गुरुश्शिष्यं विशोधयेत् ॥ १४","tr":"jñānena kriyayā vātha guruśśiṣyaṃ viśodhayet || 14"},{"id":"431.29","n":"१५","text":"यो ऽन्यथा कुरुते मोहात्स विनश्यति दुर्मतिः ॥ १५","tr":"yo 'nyathā kurute mohātsa vinaśyati durmatiḥ || 15"},{"id":"431.30","n":"१५","text":"तस्मात्सर्वप्रकारेण गुरुः शिष्यं परीक्षयेत् ॥ १५","tr":"tasmātsarvaprakāreṇa guruḥ śiṣyaṃ parīkṣayet || 15"},{"id":"431.31","n":"१६","text":"लक्षणं शक्तिपातस्य प्रबोधानंदसंभवः ॥ १६","tr":"lakṣaṇaṃ śaktipātasya prabodhānaṃdasaṃbhavaḥ || 16"},{"id":"431.32","n":"१६","text":"सा यस्मात्परमा शक्तिः प्रबोधानंदरूपिणी ॥ १६","tr":"sā yasmātparamā śaktiḥ prabodhānaṃdarūpiṇī || 16"},{"id":"431.33","n":"१७","text":"आनंदबोधयोर्लिंगमंतःकरणविक्रियाः ॥ १७","tr":"ānaṃdabodhayorliṃgamaṃtaḥkaraṇavikriyāḥ || 17"},{"id":"431.34","n":"१७","text":"यथा स्यात्कंपरोमांचस्वरनेत्रांगविक्रियाः ॥ १७","tr":"yathā syātkaṃparomāṃcasvaranetrāṃgavikriyāḥ || 17"},{"id":"431.35","n":"१८","text":"शिष्योपि लक्षणैरेभिः कुर्याद्गुरुपरीक्षणम् ॥ १८","tr":"śiṣyopi lakṣaṇairebhiḥ kuryādguruparīkṣaṇam || 18"},{"id":"431.36","n":"१८","text":"तत्संपर्कैः शिवार्चादौ संगतैर्वाथ तद्गतैः ॥ १८","tr":"tatsaṃparkaiḥ śivārcādau saṃgatairvātha tadgataiḥ || 18"},{"id":"431.37","n":"१९","text":"शिष्यस्तु शिक्षणीयत्वाद्गुरोर्गौरवकारणात् ॥ १९","tr":"śiṣyastu śikṣaṇīyatvādgurorgauravakāraṇāt || 19"},{"id":"431.38","n":"१९","text":"तस्मात्सर्वप्रयत्नेन गुरोर्गौरवमाचरेत् ॥ १९","tr":"tasmātsarvaprayatnena gurorgauravamācaret || 19"},{"id":"431.39","n":"२०","text":"यो गुरुस्स शिवः प्रोक्तो यः शिवः स गुरुः स्मृतः ॥ २०","tr":"yo gurussa śivaḥ prokto yaḥ śivaḥ sa guruḥ smṛtaḥ || 20"},{"id":"431.40","n":"२०","text":"गुरुर्वा शिव एवाथ विद्याकारेण संस्थितः ॥ २०","tr":"gururvā śiva evātha vidyākāreṇa saṃsthitaḥ || 20"},{"id":"431.41","n":"२१","text":"यथा शिवस्तथा विद्या यथा विद्या तथा गुरुः ॥ २१","tr":"yathā śivastathā vidyā yathā vidyā tathā guruḥ || 21"},{"id":"431.42","n":"२१","text":"शिवविद्या गुरूणां च पूजया सदृशं फलम् ॥ २१","tr":"śivavidyā gurūṇāṃ ca pūjayā sadṛśaṃ phalam || 21"},{"id":"431.43","n":"२२","text":"सर्वदेवात्मकश्चासौ सर्वमंत्रमयो गुरुः ॥ २२","tr":"sarvadevātmakaścāsau sarvamaṃtramayo guruḥ || 22"},{"id":"431.44","n":"२२","text":"तस्मात्सर्वप्रयत्नेन यस्याज्ञां शिरसा वहेत् ॥ २२","tr":"tasmātsarvaprayatnena yasyājñāṃ śirasā vahet || 22"},{"id":"431.45","n":"२३","text":"श्रेयो ऽर्थी यदि गुर्वाज्ञां मनसापि न लंघयेत् ॥ २३","tr":"śreyo 'rthī yadi gurvājñāṃ manasāpi na laṃghayet || 23"},{"id":"431.46","n":"२३","text":"गुर्वाज्ञापालको यस्माज्ज्ञानसंपत्तिमश्नुते ॥ २३","tr":"gurvājñāpālako yasmājjñānasaṃpattimaśnute || 23"},{"id":"431.47","n":"२४","text":"गच्छंस्तिष्ठन्स्वपन्भुंजन्नान्यत्कर्म समाचरेत् ॥ २४","tr":"gacchaṃstiṣṭhansvapanbhuṃjannānyatkarma samācaret || 24"},{"id":"431.48","n":"२४","text":"समक्षं यदि कुर्वीत सर्वं चानुज्ञया गुरोः ॥ २४","tr":"samakṣaṃ yadi kurvīta sarvaṃ cānujñayā guroḥ || 24"},{"id":"431.49","n":"२५","text":"गुरोर्गृहे समक्षं वा न यथेष्टासनो भवेत् ॥ २५","tr":"gurorgṛhe samakṣaṃ vā na yatheṣṭāsano bhavet || 25"},{"id":"431.50","n":"२५","text":"गुरुर्देवो यतः साक्षात्तद्गृहं देवमन्दिरम् ॥ २५","tr":"gururdevo yataḥ sākṣāttadgṛhaṃ devamandiram || 25"},{"id":"431.51","n":"२६","text":"पापिनां च यथा संगात्तत्पापात्पतितो भवेत् ॥ २६","tr":"pāpināṃ ca yathā saṃgāttatpāpātpatito bhavet || 26"},{"id":"431.52","n":"२६","text":"यथेह वह्निसंपर्कान्मलं त्यजति कांचनम् ॥ २६","tr":"yatheha vahnisaṃparkānmalaṃ tyajati kāṃcanam || 26"},{"id":"431.53","n":"२७","text":"तथैव गुरुसंपर्कात्पापं त्यजति मानवः ॥ २७","tr":"tathaiva gurusaṃparkātpāpaṃ tyajati mānavaḥ || 27"},{"id":"431.54","n":"२७","text":"यथा वह्निसमीपस्थो घृतकुम्भो विलीयते ॥ २७","tr":"yathā vahnisamīpastho ghṛtakumbho vilīyate || 27"},{"id":"431.55","n":"२८","text":"तथा पापं विलीयेत ह्याचार्यस्य समीपतः ॥ २८","tr":"tathā pāpaṃ vilīyeta hyācāryasya samīpataḥ || 28"},{"id":"431.56","n":"२८","text":"यथा प्रज्वलितो वह्निः शुष्कमार्द्रं च निर्दहेत् ॥ २८","tr":"yathā prajvalito vahniḥ śuṣkamārdraṃ ca nirdahet || 28"},{"id":"431.57","n":"२९","text":"तथायमपि संतुष्टो गुरुः पापं क्षणाद्दहेत् ॥ २९","tr":"tathāyamapi saṃtuṣṭo guruḥ pāpaṃ kṣaṇāddahet || 29"},{"id":"431.58","n":"२९","text":"मनसा कर्मणा वाचा गुरोः क्रोधं न कारयेत् ॥ २९","tr":"manasā karmaṇā vācā guroḥ krodhaṃ na kārayet || 29"},{"id":"431.59","n":"३०","text":"तस्य क्रोधेन दह्यंते ह्यायुःश्रीज्ञानसत्क्रियाः ॥ ३०","tr":"tasya krodhena dahyaṃte hyāyuḥśrījñānasatkriyāḥ || 30"},{"id":"431.60","n":"३०","text":"तत्क्रोधकारिणो ये स्युस्तेषां यज्ञाश्च निष्फलाः ॥ ३०","tr":"tatkrodhakāriṇo ye syusteṣāṃ yajñāśca niṣphalāḥ || 30"},{"id":"431.61","n":"३१","text":"यमश्च नियमाश्चैव नात्र कार्या विचारणा ॥ ३१","tr":"yamaśca niyamāścaiva nātra kāryā vicāraṇā || 31"},{"id":"431.62","n":"३१","text":"गुरोर्विरुद्धं यद्वाक्यं न वदेज्जातुचिन्नरः ॥ ३१","tr":"gurorviruddhaṃ yadvākyaṃ na vadejjātucinnaraḥ || 31"},{"id":"431.63","n":"३२","text":"वदेद्यदि महामोहाद्रौरवं नरकं व्रजेत् ॥ ३२","tr":"vadedyadi mahāmohādrauravaṃ narakaṃ vrajet || 32"},{"id":"431.64","n":"३२","text":"मनसा कर्मणा वाचा गुरुमुद्दिश्य यत्नतः ॥ ३२","tr":"manasā karmaṇā vācā gurumuddiśya yatnataḥ || 32"},{"id":"431.65","n":"३३","text":"श्रेयोर्थी चेन्नरो धीमान्न मिथ्याचारमाचरेत् ॥ ३३","tr":"śreyorthī cennaro dhīmānna mithyācāramācaret || 33"},{"id":"431.66","n":"३३","text":"गुरोर्हितं प्रियं कुर्यादादिष्टो वा न वा सदा ॥ ३३","tr":"gurorhitaṃ priyaṃ kuryādādiṣṭo vā na vā sadā || 33"},{"id":"431.67","n":"३४","text":"असमक्षं समक्षं वा तस्य कार्यं समाचरेत् ॥ ३४","tr":"asamakṣaṃ samakṣaṃ vā tasya kāryaṃ samācaret || 34"},{"id":"431.68","n":"३४","text":"इत्थमाचारवान्भक्तो नित्यमुद्युक्तमानसः ॥ ३४","tr":"itthamācāravānbhakto nityamudyuktamānasaḥ || 34"},{"id":"431.69","n":"३५","text":"गुरुप्रियकरः शिष्यः शैवधर्मांस्ततो ऽर्हति ॥ ३५","tr":"gurupriyakaraḥ śiṣyaḥ śaivadharmāṃstato 'rhati || 35"},{"id":"431.70","n":"३५","text":"गुरुश्चेद्गुणवान्प्राज्ञः परमानंदभासकः ॥ ३५","tr":"guruścedguṇavānprājñaḥ paramānaṃdabhāsakaḥ || 35"},{"id":"431.71","n":"३६","text":"तत्त्वविच्छिवसंसक्तो मुक्तिदो न तु चापरः ॥ ३६","tr":"tattvavicchivasaṃsakto muktido na tu cāparaḥ || 36"},{"id":"431.72","n":"३६","text":"संवित्संजननं तत्त्वं परमानंदसंभवम् ॥ ३६","tr":"saṃvitsaṃjananaṃ tattvaṃ paramānaṃdasaṃbhavam || 36"},{"id":"431.73","n":"३७","text":"तत्तत्त्वं विदितं येन स एवानंददर्शकः ॥ ३७","tr":"tattattvaṃ viditaṃ yena sa evānaṃdadarśakaḥ || 37"},{"id":"431.74","n":"३७","text":"न पुनर्नाममात्रेण संविदारहितस्तु यः ॥ ३७","tr":"na punarnāmamātreṇa saṃvidārahitastu yaḥ || 37"},{"id":"431.75","n":"३८","text":"अन्योन्यं तारयेन्नौका किं शिला तारयेच्छिलाम् ॥ ३८","tr":"anyonyaṃ tārayennaukā kiṃ śilā tārayecchilām || 38"},{"id":"431.76","n":"३८","text":"एतस्या नाममात्रेण मुक्तिर्वै नाममात्रिका ॥ ३८","tr":"etasyā nāmamātreṇa muktirvai nāmamātrikā || 38"},{"id":"431.77","n":"३९","text":"यैः पुनर्विदितं तत्त्वं ते मुक्ता मोचयन्त्यपि ॥ ३९","tr":"yaiḥ punarviditaṃ tattvaṃ te muktā mocayantyapi || 39"},{"id":"431.78","n":"३९","text":"तत्त्वहीने कुतो बोधः कुतो ह्यात्मपरिग्रहः ॥ ३९","tr":"tattvahīne kuto bodhaḥ kuto hyātmaparigrahaḥ || 39"},{"id":"431.79","n":"४०","text":"परिग्रहविनिर्मुक्तः पशुरित्यभिधीयते ॥ ४०","tr":"parigrahavinirmuktaḥ paśurityabhidhīyate || 40"},{"id":"431.80","n":"४०","text":"पशुभिः प्रेरितश्चापि पशुत्वं नातिवर्तते ॥ ४०","tr":"paśubhiḥ preritaścāpi paśutvaṃ nātivartate || 40"},{"id":"431.81","n":"४१","text":"तस्मात्तत्त्वविदेवेह मुक्तो मोचक इष्यते ॥ ४१","tr":"tasmāttattvavideveha mukto mocaka iṣyate || 41"},{"id":"431.82","n":"४१","text":"सर्वलक्षणसंयुक्तः सर्वशास्त्रविदप्ययम् ॥ ४१","tr":"sarvalakṣaṇasaṃyuktaḥ sarvaśāstravidapyayam || 41"},{"id":"431.83","n":"४२","text":"सर्वोपायविधिज्ञो ऽपि तत्त्वहीनस्तु निष्फलः ॥ ४२","tr":"sarvopāyavidhijño 'pi tattvahīnastu niṣphalaḥ || 42"},{"id":"431.84","n":"४२","text":"यस्यानुभवपर्यंता बुद्धिस्तत्त्वे प्रवर्तते ॥ ४२","tr":"yasyānubhavaparyaṃtā buddhistattve pravartate || 42"},{"id":"431.85","n":"४३","text":"तस्यावलोकनाद्यैश्च परानन्दो ऽभिजायते ॥ ४३","tr":"tasyāvalokanādyaiśca parānando 'bhijāyate || 43"},{"id":"431.86","n":"४३","text":"तस्माद्यस्यैव संपर्कात्प्रबोधानंदसंभवः ॥ ४३","tr":"tasmādyasyaiva saṃparkātprabodhānaṃdasaṃbhavaḥ || 43"},{"id":"431.87","n":"४४","text":"गुरुं तमेव वृणुयान्नापरं मतिमान्नरः ॥ ४४","tr":"guruṃ tameva vṛṇuyānnāparaṃ matimānnaraḥ || 44"},{"id":"431.88","n":"४४","text":"स शिष्यैर्विनयाचारचतुरैरुचितो गुरुः ॥ ४४","tr":"sa śiṣyairvinayācāracaturairucito guruḥ || 44"},{"id":"431.89","n":"४५","text":"यावद्विज्ञायते तावत्सेवनीयो मुमुक्षुभिः ॥ ४५","tr":"yāvadvijñāyate tāvatsevanīyo mumukṣubhiḥ || 45"},{"id":"431.90","n":"४५","text":"ज्ञाते तस्मिन्स्थिरा भक्तिर्यावत्तत्त्वं समाश्रयेत् ॥ ४५","tr":"jñāte tasminsthirā bhaktiryāvattattvaṃ samāśrayet || 45"},{"id":"431.91","n":"४६","text":"न तु तत्त्वं त्यजेज्जातु नोपेक्षेत कथंचन ॥ ४६","tr":"na tu tattvaṃ tyajejjātu nopekṣeta kathaṃcana || 46"},{"id":"431.92","n":"४६","text":"यत्रानंदः प्रबोधो वा नाल्पमप्युपलभ्यते ॥ ४६","tr":"yatrānaṃdaḥ prabodho vā nālpamapyupalabhyate || 46"},{"id":"431.93","n":"४७","text":"वत्सरादपि शिष्येण सो ऽन्यं गुरुमुपाश्रयेत् ॥ ४७","tr":"vatsarādapi śiṣyeṇa so 'nyaṃ gurumupāśrayet || 47"},{"id":"431.94","n":"४७","text":"गुरुमन्यं प्रपन्ने ऽपि नावमन्येत पौर्विकम् ॥ ४७","tr":"gurumanyaṃ prapanne 'pi nāvamanyeta paurvikam || 47"},{"id":"431.95","n":"४७","text":"गुरोर्भ्रात्ःंस्तथा पुत्रान्बोधकान्प्रेरकानपि ॥ ४७","tr":"gurorbhrātḥṃstathā putrānbodhakānprerakānapi || 47"},{"id":"431.96","n":"४८","text":"तत्रादावुपसंगम्य ब्राह्मणं वेदपारगम् ॥ ४८","tr":"tatrādāvupasaṃgamya brāhmaṇaṃ vedapāragam || 48"},{"id":"431.97","n":"४८","text":"गुरुमाराधयेत्प्राज्ञं शुभगं प्रियदर्शनम् ॥ ४८","tr":"gurumārādhayetprājñaṃ śubhagaṃ priyadarśanam || 48"},{"id":"431.98","n":"४९","text":"सर्वाभयप्रदातारं करुणाक्रांतमानसम् ॥ ४९","tr":"sarvābhayapradātāraṃ karuṇākrāṃtamānasam || 49"},{"id":"431.99","n":"४९","text":"तोषयेत्तं प्रयत्नेन मनसा कर्मणा गिरा ॥ ४९","tr":"toṣayettaṃ prayatnena manasā karmaṇā girā || 49"},{"id":"431.100","n":"५०","text":"तावदाराधयेच्छिष्यः प्रसन्नोसौ भवेद्यथा ॥ ५०","tr":"tāvadārādhayecchiṣyaḥ prasannosau bhavedyathā || 50"},{"id":"431.101","n":"५०","text":"तस्मिन्प्रसन्ने शिष्यस्य सद्यः पापक्षयो भवेत् ॥ ५०","tr":"tasminprasanne śiṣyasya sadyaḥ pāpakṣayo bhavet || 50"},{"id":"431.102","n":"५१","text":"तस्माद्धनानि रत्नानि क्षेत्राणि च गृहाणि च ॥ ५१","tr":"tasmāddhanāni ratnāni kṣetrāṇi ca gṛhāṇi ca || 51"},{"id":"431.103","n":"५१","text":"भूषणानि च वासांसि यानशय्यासनानि च ॥ ५१","tr":"bhūṣaṇāni ca vāsāṃsi yānaśayyāsanāni ca || 51"},{"id":"431.104","n":"५२","text":"एतानि गुरवे दद्याद्भक्त्या वित्तानुसारतः ॥ ५२","tr":"etāni gurave dadyādbhaktyā vittānusārataḥ || 52"},{"id":"431.105","n":"५२","text":"वित्तशाठ्यं न कुर्वीत यदीच्छेत्परमां गतिम् ॥ ५२","tr":"vittaśāṭhyaṃ na kurvīta yadīcchetparamāṃ gatim || 52"},{"id":"431.106","n":"५३","text":"स एव जनको माता भर्ता बन्धुर्धनं सुखम् ॥ ५३","tr":"sa eva janako mātā bhartā bandhurdhanaṃ sukham || 53"},{"id":"431.107","n":"५३","text":"सखा मित्रं च यत्तस्मात्सर्वं तस्मै निवेदयेत् ॥ ५३","tr":"sakhā mitraṃ ca yattasmātsarvaṃ tasmai nivedayet || 53"},{"id":"431.108","n":"५४","text":"निवेद्य पश्चात्स्वात्मानं सान्वयं सपरिग्रहम् ॥ ५४","tr":"nivedya paścātsvātmānaṃ sānvayaṃ saparigraham || 54"},{"id":"431.109","n":"५४","text":"समर्प्य सोदकं तस्मै नित्यं तद्वशगो भवेत् ॥ ५४","tr":"samarpya sodakaṃ tasmai nityaṃ tadvaśago bhavet || 54"},{"id":"431.110","n":"५५","text":"यदा शिवाय स्वात्मानं दत्तवान् देशिकात्मने ॥ ५५","tr":"yadā śivāya svātmānaṃ dattavān deśikātmane || 55"},{"id":"431.111","n":"५५","text":"तदा शैवो भवेद्देही न ततो ऽस्ति पुनर्भवः ॥ ५५","tr":"tadā śaivo bhaveddehī na tato 'sti punarbhavaḥ || 55"},{"id":"431.112","n":"५६","text":"गुरुश्च स्वाश्रितं शिष्यं वर्षमेकं परीक्षयेत् ॥ ५६","tr":"guruśca svāśritaṃ śiṣyaṃ varṣamekaṃ parīkṣayet || 56"},{"id":"431.113","n":"५६","text":"ब्राह्मणं क्षत्रियं वैश्यं द्विवर्षं च त्रिवर्षकम् ॥ ५६","tr":"brāhmaṇaṃ kṣatriyaṃ vaiśyaṃ dvivarṣaṃ ca trivarṣakam || 56"},{"id":"431.114","n":"५७","text":"प्राणद्रव्यप्रदानाद्यैरादेशैश्च समासमैः ॥ ५७","tr":"prāṇadravyapradānādyairādeśaiśca samāsamaiḥ || 57"},{"id":"431.115","n":"५७","text":"उत्तमांश्चाधमे कृत्वा नीचानुत्तमकर्मणि ॥ ५७","tr":"uttamāṃścādhame kṛtvā nīcānuttamakarmaṇi || 57"},{"id":"431.116","n":"५८","text":"आक्रुष्टास्ताडिता वापि ये विषादं न यान्त्यपि ॥ ५८","tr":"ākruṣṭāstāḍitā vāpi ye viṣādaṃ na yāntyapi || 58"},{"id":"431.117","n":"५८","text":"ते योग्याः संयताः शुद्धाः शिवसंस्कारकर्मणि ॥ ५८","tr":"te yogyāḥ saṃyatāḥ śuddhāḥ śivasaṃskārakarmaṇi || 58"},{"id":"431.118","n":"५९","text":"अहिंसका दयावंतो नित्यमुद्युक्तचेतसः ॥ ५९","tr":"ahiṃsakā dayāvaṃto nityamudyuktacetasaḥ || 59"},{"id":"431.119","n":"५९","text":"अमानिनो बुद्धिमंतस्त्यक्तस्पर्धाः प्रियंवदाः ॥ ५९","tr":"amānino buddhimaṃtastyaktaspardhāḥ priyaṃvadāḥ || 59"},{"id":"431.120","n":"६०","text":"ऋजवो मृदवः स्वच्छा विनीताः स्थिरचेतसः ॥ ६०","tr":"ṛjavo mṛdavaḥ svacchā vinītāḥ sthiracetasaḥ || 60"},{"id":"431.121","n":"६०","text":"शौचाचारसमायुक्ताः शिवभक्ता द्विजातयः ॥ ६०","tr":"śaucācārasamāyuktāḥ śivabhaktā dvijātayaḥ || 60"},{"id":"431.122","n":"६१","text":"एवं वृत्तसमोपेता वाङ्मनःकायकर्मभिः ॥ ६१","tr":"evaṃ vṛttasamopetā vāṅmanaḥkāyakarmabhiḥ || 61"},{"id":"431.123","n":"६१","text":"शोध्या बोध्या यथान्यायमिति शास्त्रेषु निश्चयः ॥ ६१","tr":"śodhyā bodhyā yathānyāyamiti śāstreṣu niścayaḥ || 61"},{"id":"431.124","n":"६२","text":"नाधिकारः स्वतो नार्याः शिवसंस्कारकर्मणि ॥ ६२","tr":"nādhikāraḥ svato nāryāḥ śivasaṃskārakarmaṇi || 62"},{"id":"431.125","n":"६२","text":"नियोगाद्भर्तुरस्त्येव भक्तियुक्ता यदीश्वरे ॥ ६२","tr":"niyogādbharturastyeva bhaktiyuktā yadīśvare || 62"},{"id":"431.126","n":"६३","text":"तथैव भर्तृहीनाया पुत्रादेरभ्यनुज्ञया ॥ ६३","tr":"tathaiva bhartṛhīnāyā putrāderabhyanujñayā || 63"},{"id":"431.127","n":"६३","text":"अधिकारो भवत्येव कन्यायाः पितुराज्ञया ॥ ६३","tr":"adhikāro bhavatyeva kanyāyāḥ piturājñayā || 63"},{"id":"431.128","n":"६३","text":"शूद्राणां मर्त्यजातीनां पतितानां विशेषतः ॥ ६३","tr":"śūdrāṇāṃ martyajātīnāṃ patitānāṃ viśeṣataḥ || 63"},{"id":"431.129","n":"६४","text":"तथा संकरजातीनां नाध्वशुद्धिर्विधीयते ॥ ६४","tr":"tathā saṃkarajātīnāṃ nādhvaśuddhirvidhīyate || 64"},{"id":"431.130","n":"६४","text":"तैप्यकृत्रिमभावश्चेच्छिवे परमकारणे ॥ ६४","tr":"taipyakṛtrimabhāvaścecchive paramakāraṇe || 64"},{"id":"431.131","n":"६५","text":"पादोदकप्रदानाद्यैः कुर्युः पापविशोधनम् ॥ ६५","tr":"pādodakapradānādyaiḥ kuryuḥ pāpaviśodhanam || 65"},{"id":"431.132","n":"६५","text":"अत्रानुलोमजाता ये युक्ता एव द्विजातिषु ॥ ६५","tr":"atrānulomajātā ye yuktā eva dvijātiṣu || 65"},{"id":"431.133","n":"६६","text":"तेषामध्वविशुद्ध्यादि कुर्यान्मातृकुलोचितम् ॥ ६६","tr":"teṣāmadhvaviśuddhyādi kuryānmātṛkulocitam || 66"},{"id":"431.134","n":"६६","text":"या तु कन्या स्वपित्राद्यैश्शिवधर्मे नियोजिता ॥ ६६","tr":"yā tu kanyā svapitrādyaiśśivadharme niyojitā || 66"},{"id":"431.135","n":"६७","text":"सा भक्ताय प्रदातव्या नापराय विरोधिने ॥ ६७","tr":"sā bhaktāya pradātavyā nāparāya virodhine || 67"},{"id":"431.136","n":"६७","text":"दत्ता चेत्प्रतिकूलाय प्रमादाद्बोधयेत्पतिम् ॥ ६७","tr":"dattā cetpratikūlāya pramādādbodhayetpatim || 67"},{"id":"431.137","n":"६८","text":"अशक्ता तं परित्यज्य मनसा धर्ममाचरेत् ॥ ६८","tr":"aśaktā taṃ parityajya manasā dharmamācaret || 68"},{"id":"431.138","n":"६८","text":"यथा मुनिवरं त्यक्त्वा पतिमत्रिं पतिव्रता ॥ ६८","tr":"yathā munivaraṃ tyaktvā patimatriṃ pativratā || 68"},{"id":"431.139","n":"६९","text":"कृतकृत्या ऽभवत्पूर्वं तपसाराध्य शङ्करम् ॥ ६९","tr":"kṛtakṛtyā 'bhavatpūrvaṃ tapasārādhya śaṅkaram || 69"},{"id":"431.140","n":"६९","text":"यथा नारायणं देवं तपसाराध्य पांडवान् ॥ ६९","tr":"yathā nārāyaṇaṃ devaṃ tapasārādhya pāṃḍavān || 69"},{"id":"431.141","n":"७०","text":"पतींल्लब्धवती धर्मे गुरुभिर्न नियोजिता ॥ ७०","tr":"patīṃllabdhavatī dharme gurubhirna niyojitā || 70"},{"id":"431.142","n":"७०","text":"अस्वातन्त्र्यकृतो दोषो नेहास्ति परमार्थतः ॥ ७०","tr":"asvātantryakṛto doṣo nehāsti paramārthataḥ || 70"},{"id":"431.143","n":"७१","text":"शिवधर्मे नियुक्तायाश्शिवशासनगौरवात् ॥ ७१","tr":"śivadharme niyuktāyāśśivaśāsanagauravāt || 71"},{"id":"431.144","n":"७१","text":"बहुनात्र किमुक्तेन यो ऽपि को ऽपि शिवाश्रयः ॥ ७१","tr":"bahunātra kimuktena yo 'pi ko 'pi śivāśrayaḥ || 71"},{"id":"431.145","n":"७२","text":"संस्कार्यो गुर्वधीनश्चेत्संस्क्रिया न प्रभिद्यते ॥ ७२","tr":"saṃskāryo gurvadhīnaścetsaṃskriyā na prabhidyate || 72"},{"id":"431.146","n":"७२","text":"गुरोरालोकनादेव स्पर्शात्संभाषणादपि ॥ ७२","tr":"gurorālokanādeva sparśātsaṃbhāṣaṇādapi || 72"},{"id":"431.147","n":"७३","text":"यस्य संजायते प्रज्ञा तस्य नास्ति पराजयः ॥ ७३","tr":"yasya saṃjāyate prajñā tasya nāsti parājayaḥ || 73"},{"id":"431.148","n":"७३","text":"मनसा यस्तु संस्कारः क्रियते योगवर्त्मना ॥ ७३","tr":"manasā yastu saṃskāraḥ kriyate yogavartmanā || 73"},{"id":"431.149","n":"७४","text":"स नेह कथितो गुह्यो गुरुवक्त्रैकगोचरः ॥ ७४","tr":"sa neha kathito guhyo guruvaktraikagocaraḥ || 74"},{"id":"431.150","n":"७४","text":"क्रियावान्यस्तु संस्कारः कुंडमंडपपूर्वकः ॥ ७४","tr":"kriyāvānyastu saṃskāraḥ kuṃḍamaṃḍapapūrvakaḥ || 74"},{"id":"431.151","n":"७४","text":"स वक्ष्यते समासेन तस्य शक्यो न विस्तरः ॥ ७४","tr":"sa vakṣyate samāsena tasya śakyo na vistaraḥ || 74"}]}