{"book":"agni-purana","n":109,"title":"अध्याय १०९","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%A6%E0%A5%AF","items":[{"id":"109.1","n":"००१","text":"अग्निरुवाच\nमाहात्म्यं सर्वतीर्थानां वक्ष्ये यद्भक्तिमुक्तिदं ।१०९.००१","tr":"agniruvāca\nmāhātmyaṃ sarvatīrthānāṃ vakṣye yadbhaktimuktidaṃ |109.001"},{"id":"109.2","n":"००१","text":"यस्य हस्तौ च पादौ च मनश्चैव सुसंयतं(१) ॥१०९.००१","tr":"yasya hastau ca pādau ca manaścaiva susaṃyataṃ(1) ||109.001"},{"id":"109.3","n":"००२","text":"विद्या तपश्च कीर्तिश्च स तीर्थफलमश्नुते ।१०९.००२","tr":"vidyā tapaśca kīrtiśca sa tīrthaphalamaśnute |109.002"},{"id":"109.4","n":"००२","text":"-- - - - - -- - - -- - - --- - - -- - -\nटिप्पणी\n१ स्वसंयतमिति घ..\n- - - - -- - - - -- - -- - -- -- --- -\nप्रतिग्राहादुपावृत्तो लघ्वाहारो जितेन्द्रियः ॥१०९.००२","tr":"-- - - - - -- - - -- - - --- - - -- - -\nṭippaṇī\n1 svasaṃyatamiti gha..\n- - - - -- - - - -- - -- - -- -- --- -\npratigrāhādupāvṛtto laghvāhāro jitendriyaḥ ||109.002"},{"id":"109.5","n":"००३","text":"निष्पापस्तीर्थयात्री तु सर्वयज्ञफलं लभेत् ।१०९.००३","tr":"niṣpāpastīrthayātrī tu sarvayajñaphalaṃ labhet |109.003"},{"id":"109.6","n":"००३","text":"अनुपोष्य त्रिरात्रीणि तीर्थान्यनभिगम्य च ॥१०९.००३","tr":"anupoṣya trirātrīṇi tīrthānyanabhigamya ca ||109.003"},{"id":"109.7","n":"००४","text":"अदत्वा काञ्चनं गाश्च दरिद्रो नाम जायते ।१०९.००४","tr":"adatvā kāñcanaṃ gāśca daridro nāma jāyate |109.004"},{"id":"109.8","n":"००४","text":"तीर्थाभिगमने(१) तत्स्याद्यद्यज्ञेनाप्यते फलं ॥१०९.००४","tr":"tīrthābhigamane(1) tatsyādyadyajñenāpyate phalaṃ ||109.004"},{"id":"109.9","n":"००५","text":"पुष्करं परमं तीर्थं सान्निध्यं हि त्रिसन्ध्यकं ।१०९.००५","tr":"puṣkaraṃ paramaṃ tīrthaṃ sānnidhyaṃ hi trisandhyakaṃ |109.005"},{"id":"109.10","n":"००५","text":"दशकोटिसहस्राणि तीर्थानां विप्र पुष्करे ॥१०९.००५","tr":"daśakoṭisahasrāṇi tīrthānāṃ vipra puṣkare ||109.005"},{"id":"109.11","n":"००६","text":"ब्रह्मा सह सुरैरास्ते मुनयः सर्वमिच्छवः ।१०९.००६","tr":"brahmā saha surairāste munayaḥ sarvamicchavaḥ |109.006"},{"id":"109.12","n":"००६","text":"देवाः प्राप्ताः सिद्धिमत्र स्नाताः पितृसुरार्चकाः(२) ॥१०९.००६","tr":"devāḥ prāptāḥ siddhimatra snātāḥ pitṛsurārcakāḥ(2) ||109.006"},{"id":"109.13","n":"००७","text":"अश्वमेधफलं प्राप्य(३) ब्रह्मलोकं प्रयान्ति ते ।१०९.००७","tr":"aśvamedhaphalaṃ prāpya(3) brahmalokaṃ prayānti te |109.007"},{"id":"109.14","n":"००७","text":"कार्त्तिक्यामन्नदानाच्च निर्मलो ब्रह्मलोकभाक्(४) ॥१०९.००७","tr":"kārttikyāmannadānācca nirmalo brahmalokabhāk(4) ||109.007"},{"id":"109.15","n":"००८","text":"पुष्करे दुष्करं गन्तुं(५) पुष्करे दुष्करं तपः ।१०९.००८","tr":"puṣkare duṣkaraṃ gantuṃ(5) puṣkare duṣkaraṃ tapaḥ |109.008"},{"id":"109.16","n":"००८","text":"दुष्करं पुष्करे दानं वस्तुं चैव सुदुष्करं(६) ॥१०९.००८","tr":"duṣkaraṃ puṣkare dānaṃ vastuṃ caiva suduṣkaraṃ(6) ||109.008"},{"id":"109.17","n":"००९","text":"तत्र वासाज्जपच्छ्राद्धात्कुलानां शतमुद्धरेत् ।१०९.००९","tr":"tatra vāsājjapacchrāddhātkulānāṃ śatamuddharet |109.009"},{"id":"109.18","n":"००९","text":"जम्बुमार्गं च तत्रैव तीर्थन्तण्डुलिकाश्रमं ॥१०९.००९","tr":"jambumārgaṃ ca tatraiva tīrthantaṇḍulikāśramaṃ ||109.009"},{"id":"109.19","n":"०१०","text":"कर्णाश्रमं(७) कोटितीर्थं नर्मदा चार्वुदं परं ।१०९.०१०","tr":"karṇāśramaṃ(7) koṭitīrthaṃ narmadā cārvudaṃ paraṃ |109.010"},{"id":"109.20","n":"०१०","text":"तीर्थञ्चर्मण्वती सिन्धुः सोमनाथः प्रभासकं ॥१०९.०१०","tr":"tīrthañcarmaṇvatī sindhuḥ somanāthaḥ prabhāsakaṃ ||109.010"},{"id":"109.21","n":"०११","text":"सरस्वत्यब्धिसङ्गश्च(८) सागरन्तीर्थमुत्तमं ।१०९.०११","tr":"sarasvatyabdhisaṅgaśca(8) sāgarantīrthamuttamaṃ |109.011"},{"id":"109.22","text":"- - -- -- - - -- - - -- - - -- - - - - - -- -\nटिप्पणी\n१ तीर्थादिगमने इति घ..\n२ पितृसुरार्चिता इति ख..\n३ अश्वमेधफलश्चास्येति ख.. , ग.. , छ.. च । अश्वमेधफलं चाप्येति घ..\n४ ब्रह्मलोककमिति ख.. , ग.. , ङ.. , छ.. च","tr":"- - -- -- - - -- - - -- - - -- - - - - - -- -\nṭippaṇī\n1 tīrthādigamane iti gha..\n2 pitṛsurārcitā iti kha..\n3 aśvamedhaphalaścāsyeti kha.. , ga.. , cha.. ca | aśvamedhaphalaṃ cāpyeti gha..\n4 brahmalokakamiti kha.. , ga.. , ṅa.. , cha.. ca"},{"id":"109.23","n":"०११","text":"५ दुष्करं गन्तुमिति ख..\n६ वस्तुं तत्र सुदुष्करमिति ज..\n७ कण्वाश्रममिति घ..\n८ सरस्वत्यब्धिसञ्ज्ञयेति ग.. , घ.. , ज.. च\n- -- - - -- - -- - - -- - -- - -- -- -- -- - -\nपिण्डारकं द्वारका च गोमती सर्वसिद्धिदा ॥१०९.०११","tr":"5 duṣkaraṃ gantumiti kha..\n6 vastuṃ tatra suduṣkaramiti ja..\n7 kaṇvāśramamiti gha..\n8 sarasvatyabdhisañjñayeti ga.. , gha.. , ja.. ca\n- -- - - -- - -- - - -- - -- - -- -- -- -- - -\npiṇḍārakaṃ dvārakā ca gomatī sarvasiddhidā ||109.011"},{"id":"109.24","n":"०१२","text":"भूमितीर्थं ब्रह्मतुङ्गं(१) तीर्थं पञ्चनदं परं ।१०९.०१२","tr":"bhūmitīrthaṃ brahmatuṅgaṃ(1) tīrthaṃ pañcanadaṃ paraṃ |109.012"},{"id":"109.25","n":"०१२","text":"भीमतीर्थं(२) गिरीन्द्रञ्च देविका पापनाशिनी ॥१०९.०१२","tr":"bhīmatīrthaṃ(2) girīndrañca devikā pāpanāśinī ||109.012"},{"id":"109.26","n":"०१३","text":"तीर्थं विनशनं पुण्यं नागोद्भेदमघार्दनं ।१०९.०१३","tr":"tīrthaṃ vinaśanaṃ puṇyaṃ nāgodbhedamaghārdanaṃ |109.013"},{"id":"109.27","n":"०१३","text":"तीर्थं कुमारकोटिश्च सर्वदानीरितानि च ॥१०९.०१३","tr":"tīrthaṃ kumārakoṭiśca sarvadānīritāni ca ||109.013"},{"id":"109.28","n":"०१४","text":"कुरुक्षेत्रं गमिष्यामि कुरुक्षेत्रे वसाम्यहं ।१०९.०१४","tr":"kurukṣetraṃ gamiṣyāmi kurukṣetre vasāmyahaṃ |109.014"},{"id":"109.29","n":"०१४","text":"य एवं सततं ब्रूयात्सोऽमलः प्राप्नुयाद्दिवं ॥१०९.०१४","tr":"ya evaṃ satataṃ brūyātso'malaḥ prāpnuyāddivaṃ ||109.014"},{"id":"109.30","n":"०१५","text":"तत्र विष्ण्वादयो देवास्तत्र वासाद्धरिं व्रजेत्(३) ।१०९.०१५","tr":"tatra viṣṇvādayo devāstatra vāsāddhariṃ vrajet(3) |109.015"},{"id":"109.31","n":"०१५","text":"सरस्वत्यां सन्निहित्यां स्नानकृद्ब्रह्मलोकभाक्(४) ॥१०९.०१५","tr":"sarasvatyāṃ sannihityāṃ snānakṛdbrahmalokabhāk(4) ||109.015"},{"id":"109.32","n":"०१६","text":"पांशवोपि कुरुक्षेत्रे नयन्ति परमां गतिं ।१०९.०१६","tr":"pāṃśavopi kurukṣetre nayanti paramāṃ gatiṃ |109.016"},{"id":"109.33","n":"०१६","text":"धर्मतीर्थं सुवर्णाख्यं गङ्गाद्वारमनुत्तमं ॥१०९.०१६","tr":"dharmatīrthaṃ suvarṇākhyaṃ gaṅgādvāramanuttamaṃ ||109.016"},{"id":"109.34","n":"०१७","text":"तीर्थं कणखलं पुण्यं भद्रकर्णह्रदन्तथा(५) ।१०९.०१७","tr":"tīrthaṃ kaṇakhalaṃ puṇyaṃ bhadrakarṇahradantathā(5) |109.017"},{"id":"109.35","n":"०१७","text":"गङ्गासरस्वतीसङ्गं ब्रह्मावर्तमघार्दनं ॥१०९.०१७","tr":"gaṅgāsarasvatīsaṅgaṃ brahmāvartamaghārdanaṃ ||109.017"},{"id":"109.36","n":"०१८","text":"भृगुतुङ्गञ्च कुब्जाम्रं गङ्गोद्भेदमघान्तकं(६) ।१०९.०१८","tr":"bhṛgutuṅgañca kubjāmraṃ gaṅgodbhedamaghāntakaṃ(6) |109.018"},{"id":"109.37","n":"०१८","text":"वाराणसी वरन्तीर्थमविमुक्तमनुत्तमं ॥१०९.०१८","tr":"vārāṇasī varantīrthamavimuktamanuttamaṃ ||109.018"},{"id":"109.38","n":"०१९","text":"कपालमोचनं तीर्थन्तीर्थराजं प्रयागकं ।१०९.०१९","tr":"kapālamocanaṃ tīrthantīrtharājaṃ prayāgakaṃ |109.019"},{"id":"109.39","n":"०१९","text":"गोमतीगङ्गयोः सङ्गं गङ्गा सर्वत्र नाकदा ॥१०९.०१९","tr":"gomatīgaṅgayoḥ saṅgaṃ gaṅgā sarvatra nākadā ||109.019"},{"id":"109.40","n":"०२०","text":"तीर्थं राजगृहं पुण्यं शालग्राममघान्तकं ।१०९.०२०","tr":"tīrthaṃ rājagṛhaṃ puṇyaṃ śālagrāmamaghāntakaṃ |109.020"},{"id":"109.41","text":"- - - -- - - -- - - -- - - -- - -- - - -- - - -\nटिप्पणी\n१ ऋषितीर्थं ब्रह्मतुङ्गमिति घ.. । भूमितीर्थं ब्रह्मसञ्ज्ञमिति छ..\n२ भीमातीर्थमिति घ..\n३ वामाद्दिवं ब्रजेदिति ज..\n४ ब्रह्मलोकग इति ख.. , ग.. , घ.. , ङ.. , छ.. , ज.. च","tr":"- - - -- - - -- - - -- - - -- - -- - - -- - - -\nṭippaṇī\n1 ṛṣitīrthaṃ brahmatuṅgamiti gha.. | bhūmitīrthaṃ brahmasañjñamiti cha..\n2 bhīmātīrthamiti gha..\n3 vāmāddivaṃ brajediti ja..\n4 brahmalokaga iti kha.. , ga.. , gha.. , ṅa.. , cha.. , ja.. ca"},{"id":"109.42","n":"०२०","text":"५ तत्र कर्णह्रदं तथेति ख.. । भद्रकं तु ह्रदं तथेति ग.. , ङ.. च\n६ गङ्गोद्भेदमवन्तिकमिति ज..\n- - - - - - - -- - - - -- - -- - - -- - -- - - -\nवटेशं वामन्न्तीर्थं कालिकासङ्गमुत्तमं(१) ॥१०९.०२०","tr":"5 tatra karṇahradaṃ tatheti kha.. | bhadrakaṃ tu hradaṃ tatheti ga.. , ṅa.. ca\n6 gaṅgodbhedamavantikamiti ja..\n- - - - - - - -- - - - -- - -- - - -- - -- - - -\nvaṭeśaṃ vāmanntīrthaṃ kālikāsaṅgamuttamaṃ(1) ||109.020"},{"id":"109.43","n":"०२१","text":"लौहित्यं करतोयाख्यं शोणञ्चाथर्षभं परं ।१०९.०२१","tr":"lauhityaṃ karatoyākhyaṃ śoṇañcātharṣabhaṃ paraṃ |109.021"},{"id":"109.44","n":"०२१","text":"श्रीपर्वतं कोल्वगिरिं(२) सह्याद्रिर्मलयो गिरिः ॥१०९.०२१","tr":"śrīparvataṃ kolvagiriṃ(2) sahyādrirmalayo giriḥ ||109.021"},{"id":"109.45","n":"०२२","text":"गोदावरी तुङ्गभद्रा कावेरो वरदा नदी ।१०९.०२२","tr":"godāvarī tuṅgabhadrā kāvero varadā nadī |109.022"},{"id":"109.46","n":"०२२","text":"तापी पयोष्णी रेवा च दण्डकारण्यमुत्तमं ॥१०९.०२२","tr":"tāpī payoṣṇī revā ca daṇḍakāraṇyamuttamaṃ ||109.022"},{"id":"109.47","n":"०२३","text":"कालञ्जरं मुञ्जवटन्तीर्थं सूर्पारकं परं ।१०९.०२३","tr":"kālañjaraṃ muñjavaṭantīrthaṃ sūrpārakaṃ paraṃ |109.023"},{"id":"109.48","n":"०२३","text":"मन्दाकिनी चित्रकूटं शृङ्गवेरपुरं परं(३) ॥१०९.०२३","tr":"mandākinī citrakūṭaṃ śṛṅgaverapuraṃ paraṃ(3) ||109.023"},{"id":"109.49","n":"०२४","text":"अवन्ती परमं तीर्थमयोध्या पापनाशनी ।१०९.०२४","tr":"avantī paramaṃ tīrthamayodhyā pāpanāśanī |109.024"},{"id":"109.50","n":"०२४","text":"नैमिषं परमं तीर्थं भुक्तिमुक्तिप्रदायकं(४) ॥१०९.०२४","tr":"naimiṣaṃ paramaṃ tīrthaṃ bhuktimuktipradāyakaṃ(4) ||109.024"},{"id":"109.51","text":"इत्याग्नेये महापुराणे तीर्थयात्रा माहात्म्यं नाम नवाधिकशततमोऽध्यायः","tr":"ityāgneye mahāpurāṇe tīrthayātrā māhātmyaṃ nāma navādhikaśatatamo'dhyāyaḥ"}]}