{"book":"agni-purana","n":232,"title":"अध्याय २३२","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A8%E0%A5%A9%E0%A5%A8","items":[{"id":"232.1","n":"०१","speaker":"पुष्कर उवाच","text":"विशन्ति येन मार्गेण वायसा बहवः पुरं ।०१","tr":"viśanti yena mārgeṇa vāyasā bahavaḥ puraṃ |01"},{"id":"232.2","n":"०१","text":"तेन मार्गेण रुद्धस्य पुरस्य ग्रहणं भवेत् ॥०१","tr":"tena mārgeṇa ruddhasya purasya grahaṇaṃ bhavet ||01"},{"id":"232.3","n":"०२","text":"सेनायां यदि वासार्थे निविष्टो वायसो रुवन् ।०२","tr":"senāyāṃ yadi vāsārthe niviṣṭo vāyaso ruvan |02"},{"id":"232.4","n":"०२","text":"वामो भयातुरस्त्रस्तो भयं वदति दुस्तरं(१) ॥०२","tr":"vāmo bhayāturastrasto bhayaṃ vadati dustaraṃ(1) ||02"},{"id":"232.5","n":"०३","text":"छायाङ्गवाहनोपानच्छत्रवस्त्रादिकुट्टने ।०३","tr":"chāyāṅgavāhanopānacchatravastrādikuṭṭane |03"},{"id":"232.6","n":"०३","text":"मृत्युस्तत्पूजने पूजा तदिष्टकरणे शुभं ॥०३","tr":"mṛtyustatpūjane pūjā tadiṣṭakaraṇe śubhaṃ ||03"},{"id":"232.7","n":"०४","text":"प्रोषितागमकृत्काकः कुर्वन् द्वारि गतागतं ।०४","tr":"proṣitāgamakṛtkākaḥ kurvan dvāri gatāgataṃ |04"},{"id":"232.8","n":"०४","text":"रक्तं दग्धं गृहे द्रव्यं क्षिपन्वह्निवेदकः ॥०४","tr":"raktaṃ dagdhaṃ gṛhe dravyaṃ kṣipanvahnivedakaḥ ||04"},{"id":"232.9","n":"०५","text":"न्यसेद्रक्तं पुरस्ताच्च निवेदयति बन्धनं ।०५","tr":"nyasedraktaṃ purastācca nivedayati bandhanaṃ |05"},{"id":"232.10","n":"०५","text":"पीतं द्रव्यं तथा रुक्म रूप्यमेव तु भार्गव ॥०५","tr":"pītaṃ dravyaṃ tathā rukma rūpyameva tu bhārgava ||05"},{"id":"232.11","n":"०६","text":"यच्चैवोपनयेद्द्रव्यं तस्य लब्धिं विनिर्दिशेत् ।०६","tr":"yaccaivopanayeddravyaṃ tasya labdhiṃ vinirdiśet |06"},{"id":"232.12","n":"०६","text":"द्रव्यं वापनयेद्यत्तु तस्य हानिं विनिर्दिशेत् ॥०६","tr":"dravyaṃ vāpanayedyattu tasya hāniṃ vinirdiśet ||06"},{"id":"232.13","n":"०७","text":"पुरतो धनलब्धिः स्यादाममांसस्य छर्दने ।०७","tr":"purato dhanalabdhiḥ syādāmamāṃsasya chardane |07"},{"id":"232.14","n":"०७","text":"भूलब्धिः स्यान्मृदः क्षेपे राज्यं रत्नार्पणे महत् ॥०७","tr":"bhūlabdhiḥ syānmṛdaḥ kṣepe rājyaṃ ratnārpaṇe mahat ||07"},{"id":"232.15","n":"०८","text":"यातुः काकोऽनुकूलस्तु क्षेमः कर्मक्षमो भवेत् ।०८","tr":"yātuḥ kāko'nukūlastu kṣemaḥ karmakṣamo bhavet |08"},{"id":"232.16","n":"०८","text":"न त्वर्थसाधको ज्ञेयः प्रतिकूलो भयावहः ॥०८","tr":"na tvarthasādhako jñeyaḥ pratikūlo bhayāvahaḥ ||08"},{"id":"232.17","n":"०९","text":"सम्मुखेऽभ्येति विरुवन् यात्राघातकरो भवेत् ।०९","tr":"sammukhe'bhyeti viruvan yātrāghātakaro bhavet |09"},{"id":"232.18","n":"०९","text":"वामः काकः स्मृतो धन्यो दक्षिणोऽर्थविनाशकृत्(२) ॥०९","tr":"vāmaḥ kākaḥ smṛto dhanyo dakṣiṇo'rthavināśakṛt(2) ||09"},{"id":"232.19","n":"१०","text":"वामोऽनुलोमगः श्रेष्ठो मध्यमो दक्षिणः स्मृतः ।१०","tr":"vāmo'nulomagaḥ śreṣṭho madhyamo dakṣiṇaḥ smṛtaḥ |10"},{"id":"232.20","n":"१०","text":"प्रतिलोमगतिर्वामो गमनप्रतिषेधकृत् ॥१०","tr":"pratilomagatirvāmo gamanapratiṣedhakṛt ||10"},{"id":"232.21","n":"११","text":"निवेदयति यात्रार्थमभिप्रेतं गृहे गतः(१) ।११","tr":"nivedayati yātrārthamabhipretaṃ gṛhe gataḥ(1) |11"},{"id":"232.22","n":"११","text":"एकाक्षरचरणस्त्वर्कं वीक्षमाणो भयावहः ॥११","tr":"ekākṣaracaraṇastvarkaṃ vīkṣamāṇo bhayāvahaḥ ||11"},{"id":"232.23","n":"१२","text":"कोटरे वासमानश्च महानर्थकरो भवेत् ।१२","tr":"koṭare vāsamānaśca mahānarthakaro bhavet |12"},{"id":"232.24","n":"१२","text":"न शुभस्तूषरे काकः पङ्काङ्कः स तु शस्यते ॥१२","tr":"na śubhastūṣare kākaḥ paṅkāṅkaḥ sa tu śasyate ||12"},{"id":"232.25","n":"१३","text":"अमेध्यपूर्णवदनः काकः सर्वार्थसाधकः(२) ।१३","tr":"amedhyapūrṇavadanaḥ kākaḥ sarvārthasādhakaḥ(2) |13"},{"id":"232.26","n":"१३","text":"ज्ञेयाः पतत्रिणोऽन्येऽपि काकवद्भृगुनन्दन ॥१३","tr":"jñeyāḥ patatriṇo'nye'pi kākavadbhṛgunandana ||13"},{"id":"232.27","n":"१४","text":"स्कन्धावारापसव्यस्थाः श्वानो विप्रविनाशकाः ।१४","tr":"skandhāvārāpasavyasthāḥ śvāno vipravināśakāḥ |14"},{"id":"232.28","n":"१४","text":"इन्द्रस्थाने नरेन्द्रस्य पुरेशस्य तु गोपुरे ॥१४","tr":"indrasthāne narendrasya pureśasya tu gopure ||14"},{"id":"232.29","n":"१५","text":"अन्तर्गृहे गृहेशस्य मरणाय भवेद्भषन् ।१५","tr":"antargṛhe gṛheśasya maraṇāya bhavedbhaṣan |15"},{"id":"232.30","n":"१५","text":"यस्य जिघ्रति वामाङ्गं तस्य स्यादर्थसिद्धये ॥१५","tr":"yasya jighrati vāmāṅgaṃ tasya syādarthasiddhaye ||15"},{"id":"232.31","n":"१६","text":"भयाय दक्षिणं चाङ्गं तथा भुजमदक्षिणं ।१६","tr":"bhayāya dakṣiṇaṃ cāṅgaṃ tathā bhujamadakṣiṇaṃ |16"},{"id":"232.32","n":"१६","text":"यात्राघातकरो यातुर्भवेत्प्रतिमुखागतः ॥१६","tr":"yātrāghātakaro yāturbhavetpratimukhāgataḥ ||16"},{"id":"232.33","n":"१७","text":"मार्गावरोधको मार्गे चौरान् वदति भार्गव ।१७","tr":"mārgāvarodhako mārge caurān vadati bhārgava |17"},{"id":"232.34","n":"१७","text":"अलाभोऽस्थिमुखः पापो रज्जुचीरमुखस्तथा ॥१७","tr":"alābho'sthimukhaḥ pāpo rajjucīramukhastathā ||17"},{"id":"232.35","n":"१८","text":"सोपानत्कमुखो धन्यो मांसपूर्णमुखोऽपि च ।१८","tr":"sopānatkamukho dhanyo māṃsapūrṇamukho'pi ca |18"},{"id":"232.36","n":"१८","text":"अमङ्गल्यमुखद्रव्यं केशञ्चैवाशुभं तथा ॥१८","tr":"amaṅgalyamukhadravyaṃ keśañcaivāśubhaṃ tathā ||18"},{"id":"232.37","n":"१९","text":"अवमूत्र्याग्रतो याति यस्य तस्य भयं भवेत् ।१९","tr":"avamūtryāgrato yāti yasya tasya bhayaṃ bhavet |19"},{"id":"232.38","n":"१९","text":"यस्यावमूत्र्य व्रजति शुभं देशन्तथा द्रुमं ॥१९","tr":"yasyāvamūtrya vrajati śubhaṃ deśantathā drumaṃ ||19"},{"id":"232.39","n":"२०","text":"मङ्गलञ्च तथा द्रव्यं तस्य स्यादर्थसिद्धये ।२०","tr":"maṅgalañca tathā dravyaṃ tasya syādarthasiddhaye |20"},{"id":"232.40","n":"२०","text":"श्ववच्च राम विज्ञेयास्तथा वै जम्बुकादयः ॥२०","tr":"śvavacca rāma vijñeyāstathā vai jambukādayaḥ ||20"},{"id":"232.41","n":"२१","text":"भयाय स्वामिनि ज्ञेयमनिमित्तं रुतङ्गवां ।२१","tr":"bhayāya svāmini jñeyamanimittaṃ rutaṅgavāṃ |21"},{"id":"232.42","n":"२१","text":"निशि चौरभयाय स्याद्विकृतं मृत्यवे तथा ॥२१","tr":"niśi caurabhayāya syādvikṛtaṃ mṛtyave tathā ||21"},{"id":"232.43","n":"२२","text":"शिवाय स्वामिनो रात्रौ बलीवर्दो नदन् भवेत् ।२२","tr":"śivāya svāmino rātrau balīvardo nadan bhavet |22"},{"id":"232.44","n":"२२","text":"उत्सृष्टवृषभो राज्ञो विजयं सम्प्रयच्छति ॥२२","tr":"utsṛṣṭavṛṣabho rājño vijayaṃ samprayacchati ||22"},{"id":"232.45","n":"२३","text":"अभयं भक्षयन्त्यश्च गावो दत्तास्तथा स्वकाः ।२३","tr":"abhayaṃ bhakṣayantyaśca gāvo dattāstathā svakāḥ |23"},{"id":"232.46","n":"२३","text":"त्यक्तस्नेहाः स्ववत्सेषु गर्भक्षयकरा मताः ॥२३","tr":"tyaktasnehāḥ svavatseṣu garbhakṣayakarā matāḥ ||23"},{"id":"232.47","n":"२४","text":"भूमिं पादैर्विनिघ्नन्त्यो दीना भीता भयावहाः ।२४","tr":"bhūmiṃ pādairvinighnantyo dīnā bhītā bhayāvahāḥ |24"},{"id":"232.48","n":"२४","text":"आर्द्राङ्ग्यो हृष्टरोमाश्च शृगलग्नमृदः शुभाः ॥२४","tr":"ārdrāṅgyo hṛṣṭaromāśca śṛgalagnamṛdaḥ śubhāḥ ||24"},{"id":"232.49","n":"२५","text":"महिष्यादिषु चाप्येतत्सर्वं वाच्यं विजानता ।२५","tr":"mahiṣyādiṣu cāpyetatsarvaṃ vācyaṃ vijānatā |25"},{"id":"232.50","n":"२५","text":"आरोहणं तथान्येन सपर्याणस्य(१) वाजिनः ॥२५","tr":"ārohaṇaṃ tathānyena saparyāṇasya(1) vājinaḥ ||25"},{"id":"232.51","n":"२६","text":"जलोपवेशनं नेष्टं भूमौ च परिवर्तनं ।२६","tr":"jalopaveśanaṃ neṣṭaṃ bhūmau ca parivartanaṃ |26"},{"id":"232.52","n":"२६","text":"विपत्करन्तुरङ्गस्य सुप्तं वाप्यनिमित्ततः ॥२६","tr":"vipatkaranturaṅgasya suptaṃ vāpyanimittataḥ ||26"},{"id":"232.53","n":"२७","text":"यवमोदकयोर्द्वेषस्त्वकस्माच्च न शस्यते ।२७","tr":"yavamodakayordveṣastvakasmācca na śasyate |27"},{"id":"232.54","n":"२७","text":"वदनाद्रुधिरोत्पत्तिर्वेपनं न च शस्यते ॥२७","tr":"vadanādrudhirotpattirvepanaṃ na ca śasyate ||27"},{"id":"232.55","n":"२८","text":"क्रीडन् वैकः कपोतैश्च सारिकाभिर्मृतिं वदेत् ।२८","tr":"krīḍan vaikaḥ kapotaiśca sārikābhirmṛtiṃ vadet |28"},{"id":"232.56","n":"२८","text":"साश्रुनेत्रो जिह्वया च पादलेही विनष्टये(२) ॥२८","tr":"sāśrunetro jihvayā ca pādalehī vinaṣṭaye(2) ||28"},{"id":"232.57","n":"२९","text":"वामपादेन च तथा विलिखंश्च वसुन्धरां ।२९","tr":"vāmapādena ca tathā vilikhaṃśca vasundharāṃ |29"},{"id":"232.58","n":"२९","text":"स्वपेद्वा वामपार्श्वेन दिवा वा न शुभप्रदः ॥२९","tr":"svapedvā vāmapārśvena divā vā na śubhapradaḥ ||29"},{"id":"232.59","n":"३०","text":"भयाय स्यात्सकृन्मूत्री तथा निद्राविलाननः ।३०","tr":"bhayāya syātsakṛnmūtrī tathā nidrāvilānanaḥ |30"},{"id":"232.60","n":"३०","text":"आरोहणं न चेद्दद्यात्प्रतीपं वा गृहं व्रजेत् ॥३०","tr":"ārohaṇaṃ na ceddadyātpratīpaṃ vā gṛhaṃ vrajet ||30"},{"id":"232.61","n":"३१","text":"यात्राविघातमाचष्टे वामपार्श्वं तथा स्पृशन् ।३१","tr":"yātrāvighātamācaṣṭe vāmapārśvaṃ tathā spṛśan |31"},{"id":"232.62","n":"३१","text":"हेषमाणः शत्रुयोधं पादस्पर्शी जयावहः ॥३१","tr":"heṣamāṇaḥ śatruyodhaṃ pādasparśī jayāvahaḥ ||31"},{"id":"232.63","n":"३२","text":"ग्रामे व्रजति नागश्चेन्मैथुनं देशहा भवेत् ।३२","tr":"grāme vrajati nāgaścenmaithunaṃ deśahā bhavet |32"},{"id":"232.64","n":"३२","text":"प्रसूता नागवनिता मत्ता चान्ताय भूपतेः ॥३२","tr":"prasūtā nāgavanitā mattā cāntāya bhūpateḥ ||32"},{"id":"232.65","n":"३३","text":"आरोहणं न चेद्दद्यात्प्रतीपं वा गृहं व्रजेत् ।३३","tr":"ārohaṇaṃ na ceddadyātpratīpaṃ vā gṛhaṃ vrajet |33"},{"id":"232.66","n":"३३","text":"मदं वा वारणो जह्याद्राजघातकरो भवेत् ॥३३","tr":"madaṃ vā vāraṇo jahyādrājaghātakaro bhavet ||33"},{"id":"232.67","n":"३४","text":"वामं दक्षिणपादेन पादमाक्रमते शुभः ।३४","tr":"vāmaṃ dakṣiṇapādena pādamākramate śubhaḥ |34"},{"id":"232.68","n":"३४","text":"दक्षिणञ्च तथा दन्तं परिमार्ष्टि करेण च ॥३४","tr":"dakṣiṇañca tathā dantaṃ parimārṣṭi kareṇa ca ||34"},{"id":"232.69","n":"३५","text":"वृषोऽश्वः कुञ्जरो वापि रिपुसैन्यगतोऽशुभः ।३५","tr":"vṛṣo'śvaḥ kuñjaro vāpi ripusainyagato'śubhaḥ |35"},{"id":"232.70","n":"३५","text":"खण्डमेघातिवृष्ट्या तु सेना नाशमवाप्नुयात् ॥३५","tr":"khaṇḍameghātivṛṣṭyā tu senā nāśamavāpnuyāt ||35"},{"id":"232.71","n":"३६","text":"प्रतिकूलग्रहर्क्षात्तु तथा सम्मुखमारुतात्(१) ।३६","tr":"pratikūlagraharkṣāttu tathā sammukhamārutāt(1) |36"},{"id":"232.72","n":"३६","text":"यात्राकाले रणे वापि छत्रादिपतनं भयं ॥३६","tr":"yātrākāle raṇe vāpi chatrādipatanaṃ bhayaṃ ||36"},{"id":"232.73","n":"३७","text":"हृष्टा नराश्चानुलोमा ग्रहा वै जयलक्षणं ।३७","tr":"hṛṣṭā narāścānulomā grahā vai jayalakṣaṇaṃ |37"},{"id":"232.74","n":"३७","text":"काकैर्योधाभिभवनं क्रव्याद्भिर्मण्डलक्षयः ॥३७","tr":"kākairyodhābhibhavanaṃ kravyādbhirmaṇḍalakṣayaḥ ||37"},{"id":"232.75","n":"३८","text":"प्राचीपश्चिमकैशानी शौम्या प्रेष्ठा शुभा च दिक् ॥३८॥","tr":"prācīpaścimakaiśānī śaumyā preṣṭhā śubhā ca dik ||38||"},{"id":"232.76","text":"इत्याग्नेये महापुराणे शकुनानि नाम एकत्रिंशदधिकद्विशततमोऽध्यायः ॥","tr":"ityāgneye mahāpurāṇe śakunāni nāma ekatriṃśadadhikadviśatatamo'dhyāyaḥ ||"}]}