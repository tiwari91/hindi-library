{"book":"agni-purana","n":161,"title":"अध्याय १६१","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%AC%E0%A5%A7","items":[{"id":"161.1","n":"०१","speaker":"पुष्कर उवाच","text":"यतिर्धर्मं प्रवक्ष्यामि ज्ञानमोक्षादिदर्शकं ।०१","tr":"yatirdharmaṃ pravakṣyāmi jñānamokṣādidarśakaṃ |01"},{"id":"161.2","n":"०१","text":"चतुर्धमायुषो भागं प्राप्य सङ्गात्परिवर्जयेत्(४) ॥०१","tr":"caturdhamāyuṣo bhāgaṃ prāpya saṅgātparivarjayet(4) ||01"},{"id":"161.3","n":"०२","text":"यदह्नि विरजेद्धीरस्तदह्नि(५) च परिव्रजेत् ।०२","tr":"yadahni virajeddhīrastadahni(5) ca parivrajet |02"},{"id":"161.4","n":"०२","text":"प्रजापत्यां निरूप्येष्टिं सर्वदेवसदक्षिणां ॥०२","tr":"prajāpatyāṃ nirūpyeṣṭiṃ sarvadevasadakṣiṇāṃ ||02"},{"id":"161.5","n":"०३","text":"आत्मन्यग्नीन् समारोप्य प्रव्रजेद्ब्राह्मणो गृहात् ।०३","tr":"ātmanyagnīn samāropya pravrajedbrāhmaṇo gṛhāt |03"},{"id":"161.6","text":"{{टिप्पणी|\n१ दृष्ट्वावश्यमिति ङ..\n२ तपश्चोग्रं वने चरेदिति ङ..\n३ भजेद्दिशमजिम्हग इति ङ..\n४ सङ्गान् परित्यजेदिति ङ..\n५ विरजेद्वापि तदह्नि इति ङ..}}","tr":"{{ṭippaṇī|\n1 dṛṣṭvāvaśyamiti ṅa..\n2 tapaścograṃ vane carediti ṅa..\n3 bhajeddiśamajimhaga iti ṅa..\n4 saṅgān parityajediti ṅa..\n5 virajedvāpi tadahni iti ṅa..}}"},{"id":"161.7","n":"०३","text":"एक एव चरेन्नित्यं ग्रासमन्नाथमाश्रयेत् ॥०३","tr":"eka eva carennityaṃ grāsamannāthamāśrayet ||03"},{"id":"161.8","n":"०४","text":"उपेक्षकोऽसिञ्चयिको मुनिर्ज्ञानसमन्वितः ।०४","tr":"upekṣako'siñcayiko munirjñānasamanvitaḥ |04"},{"id":"161.9","n":"०४","text":"कपालं वृक्षमूलञ्च(१) कुचेलमसहायाता ॥०४","tr":"kapālaṃ vṛkṣamūlañca(1) kucelamasahāyātā ||04"},{"id":"161.10","n":"०५","text":"समता चैव सर्वस्मिन्नेतन्मुक्तस्य(२) लक्षणं ।०५","tr":"samatā caiva sarvasminnetanmuktasya(2) lakṣaṇaṃ |05"},{"id":"161.11","n":"०५","text":"नाभिनन्देन मरणं नाभिनन्देत जीवनं(३) ॥०५","tr":"nābhinandena maraṇaṃ nābhinandeta jīvanaṃ(3) ||05"},{"id":"161.12","n":"०६","text":"कालमेव प्रतीक्षेत निदेशं भृतको यथा ।०६","tr":"kālameva pratīkṣeta nideśaṃ bhṛtako yathā |06"},{"id":"161.13","n":"०६","text":"दृष्टिपूतं न्यसेत्पादं वस्त्रपूतं जलं पिवेत् ॥०६","tr":"dṛṣṭipūtaṃ nyasetpādaṃ vastrapūtaṃ jalaṃ pivet ||06"},{"id":"161.14","n":"०७","text":"सत्यपूतां वदेद्वाचं मनःपूतं समाचरेत् ।०७","tr":"satyapūtāṃ vadedvācaṃ manaḥpūtaṃ samācaret |07"},{"id":"161.15","n":"०७","text":"अलावुदारुपत्राणि मृण्मयं वैष्णवं यतेः ॥०७","tr":"alāvudārupatrāṇi mṛṇmayaṃ vaiṣṇavaṃ yateḥ ||07"},{"id":"161.16","n":"०८","text":"विधूमे न्यस्तमुषले व्यङ्गारे भुक्तवज्जने ।०८","tr":"vidhūme nyastamuṣale vyaṅgāre bhuktavajjane |08"},{"id":"161.17","n":"०८","text":"वृत्ते शरावसम्पाते भिक्षां नित्यं यतिश्चरेत् ॥०८","tr":"vṛtte śarāvasampāte bhikṣāṃ nityaṃ yatiścaret ||08"},{"id":"161.18","n":"०९","text":"मधूकरमसङ्क्लिप्तं प्राक्प्रणीतमयाचितं ।०९","tr":"madhūkaramasaṅkliptaṃ prākpraṇītamayācitaṃ |09"},{"id":"161.19","n":"०९","text":"तात्कालिकञ्चोपपन्नं भैक्षं पञ्चविधं स्मृतं ॥०९","tr":"tātkālikañcopapannaṃ bhaikṣaṃ pañcavidhaṃ smṛtaṃ ||09"},{"id":"161.20","n":"१०","text":"पाणिपात्री भवेद्वापि पात्रे पात्रात्समाचरेत् ।१०","tr":"pāṇipātrī bhavedvāpi pātre pātrātsamācaret |10"},{"id":"161.21","n":"१०","text":"अवेक्षेत गतिं नॄणां कर्मदोषसमुद्भवां ॥१०","tr":"avekṣeta gatiṃ nṝṇāṃ karmadoṣasamudbhavāṃ ||10"},{"id":"161.22","n":"११","text":"शुद्धभावश्चरेद्भर्मं यत्र तत्राश्रमे रतः ।११","tr":"śuddhabhāvaścaredbharmaṃ yatra tatrāśrame rataḥ |11"},{"id":"161.23","n":"११","text":"समः सर्वेषु भूतेषु न लिङ्गं धर्मकारणं ॥११","tr":"samaḥ sarveṣu bhūteṣu na liṅgaṃ dharmakāraṇaṃ ||11"},{"id":"161.24","n":"१२","text":"फलं कतकवृक्षस्य यद्यप्यम्बुप्रसादकं ।१२","tr":"phalaṃ katakavṛkṣasya yadyapyambuprasādakaṃ |12"},{"id":"161.25","n":"१२","text":"न नामग्रहणादेव तस्य वारि प्रसीदति ॥१२","tr":"na nāmagrahaṇādeva tasya vāri prasīdati ||12"},{"id":"161.26","n":"१३","text":"{{टिप्पणी|\n१ वृक्षमूलानि ख.. , घ.. , छ.. , झ.. च । वृक्षमूलादि इति ट..\n२ एतच्छुद्धस्येति ङ..\n३ जीवितमिति ख.. , घ.. , ङ.. , छ.. , ज.. च}}\nअजिह्मः पण्डकः पङ्गुरन्धो बधिर एव च ।१३","tr":"{{ṭippaṇī|\n1 vṛkṣamūlāni kha.. , gha.. , cha.. , jha.. ca | vṛkṣamūlādi iti ṭa..\n2 etacchuddhasyeti ṅa..\n3 jīvitamiti kha.. , gha.. , ṅa.. , cha.. , ja.. ca}}\najihmaḥ paṇḍakaḥ paṅgurandho badhira eva ca |13"},{"id":"161.27","n":"१३","text":"सद्भिश्च मुच्यते मद्भिरज्ञानात्संसृतो द्विजः ॥१३","tr":"sadbhiśca mucyate madbhirajñānātsaṃsṛto dvijaḥ ||13"},{"id":"161.28","n":"१४","text":"अह्नि रात्र्याञ्च यान् जन्तून् हिनस्त्यज्ञानतो यतिः ।१४","tr":"ahni rātryāñca yān jantūn hinastyajñānato yatiḥ |14"},{"id":"161.29","n":"१४","text":"तेषां स्नात्वा विशुद्ध्यर्थं प्राणायामान् षडाचरेत्(१) ॥१४","tr":"teṣāṃ snātvā viśuddhyarthaṃ prāṇāyāmān ṣaḍācaret(1) ||14"},{"id":"161.30","n":"१५","text":"अस्थिस्थूणं स्नायुयुतं मांसशोणितलेपनं ।१५","tr":"asthisthūṇaṃ snāyuyutaṃ māṃsaśoṇitalepanaṃ |15"},{"id":"161.31","n":"१५","text":"चर्मावनद्धं दुर्गन्धं पूर्णं मूत्रपुरीषयोः ॥१५","tr":"carmāvanaddhaṃ durgandhaṃ pūrṇaṃ mūtrapurīṣayoḥ ||15"},{"id":"161.32","n":"१६","text":"जराशोकसमाविष्टं रोगायतनमातुरं ।१६","tr":"jarāśokasamāviṣṭaṃ rogāyatanamāturaṃ |16"},{"id":"161.33","n":"१६","text":"रजस्वलमनित्यञ्च भूतावासमिमन्त्यजेत् ॥१६","tr":"rajasvalamanityañca bhūtāvāsamimantyajet ||16"},{"id":"161.34","n":"१७","text":"धृतिः क्षमा दमोऽस्तेयं(२) शौचमिन्द्रियनिग्रहः ।१७","tr":"dhṛtiḥ kṣamā damo'steyaṃ(2) śaucamindriyanigrahaḥ |17"},{"id":"161.35","n":"१७","text":"ह्रीर्विद्या सत्यमक्रोधो दशकं धर्मलक्षणं ॥१७","tr":"hrīrvidyā satyamakrodho daśakaṃ dharmalakṣaṇaṃ ||17"},{"id":"161.36","n":"१८","text":"चतुर्विधं भैक्षवस्तु कुटीरकवहूदके ।१८","tr":"caturvidhaṃ bhaikṣavastu kuṭīrakavahūdake |18"},{"id":"161.37","n":"१८","text":"हंसः परमहंसश्च यो यः पश्चात्स उत्तमः ॥१८","tr":"haṃsaḥ paramahaṃsaśca yo yaḥ paścātsa uttamaḥ ||18"},{"id":"161.38","n":"१९","text":"एकदण्डी त्रिदण्डी वा(३) योगी मुच्यते बन्धनात् ।१९","tr":"ekadaṇḍī tridaṇḍī vā(3) yogī mucyate bandhanāt |19"},{"id":"161.39","n":"१९","text":"अहिंसा सत्यमस्तेयं ब्रह्मचर्यापरिग्रहौ ॥१९","tr":"ahiṃsā satyamasteyaṃ brahmacaryāparigrahau ||19"},{"id":"161.40","n":"२०","text":"यमाः पञ्चाथ नियमाः शौचं सन्तोषणन्तपः ।२०","tr":"yamāḥ pañcātha niyamāḥ śaucaṃ santoṣaṇantapaḥ |20"},{"id":"161.41","n":"२०","text":"स्वाध्यायेश्वरपूजा च पद्मकाद्यासनं यतेः(४) ॥२०","tr":"svādhyāyeśvarapūjā ca padmakādyāsanaṃ yateḥ(4) ||20"},{"id":"161.42","n":"२१","text":"प्राणायामस्तु द्विविधः स गर्भोऽगर्भ एव च ।२१","tr":"prāṇāyāmastu dvividhaḥ sa garbho'garbha eva ca |21"},{"id":"161.43","n":"२१","text":"जपध्यानयुतो गर्भो विपरीतस्त्वगर्भकः ॥२१","tr":"japadhyānayuto garbho viparītastvagarbhakaḥ ||21"},{"id":"161.44","n":"२२","text":"प्रत्येकं त्रिविधं सोपि पूरकुम्भकरेचकैः ।२२","tr":"pratyekaṃ trividhaṃ sopi pūrakumbhakarecakaiḥ |22"},{"id":"161.45","n":"२२","text":"पूरणात्पूरको वायोर्निश्चलत्वाच्च कुम्भकः ॥२२","tr":"pūraṇātpūrako vāyorniścalatvācca kumbhakaḥ ||22"},{"id":"161.46","n":"२३","text":"{{टिप्पणी|\n१ समाचरेदिति ख.. , छ.. च\n२ दयास्तेयमिति ङ..\n३ त्रिदण्डी चेति ङ..\n४ पद्मकाद्यासनं महतिति ट..}}\nरेचनाद्रेचकः प्रोक्तो मात्राभेदेन च त्रिधा ।२३","tr":"{{ṭippaṇī|\n1 samācarediti kha.. , cha.. ca\n2 dayāsteyamiti ṅa..\n3 tridaṇḍī ceti ṅa..\n4 padmakādyāsanaṃ mahatiti ṭa..}}\nrecanādrecakaḥ prokto mātrābhedena ca tridhā |23"},{"id":"161.47","n":"२३","text":"द्वादशात्तु चतुर्विंशः षट्त्रिंशन्मात्रिकोऽपरः ॥२३","tr":"dvādaśāttu caturviṃśaḥ ṣaṭtriṃśanmātriko'paraḥ ||23"},{"id":"161.48","n":"२४","text":"तालो लघ्वक्षरो मात्रा प्रणवादि चरेच्छनैः ।२४","tr":"tālo laghvakṣaro mātrā praṇavādi carecchanaiḥ |24"},{"id":"161.49","n":"२४","text":"प्रत्याहारो जापकानां ध्यानमीश्वरचिन्तनं ॥२४","tr":"pratyāhāro jāpakānāṃ dhyānamīśvaracintanaṃ ||24"},{"id":"161.50","n":"२५","text":"मनोधृतिर्धारणा स्यात्समाधिर्ब्रह्मणि स्थितिः ।२५","tr":"manodhṛtirdhāraṇā syātsamādhirbrahmaṇi sthitiḥ |25"},{"id":"161.51","n":"२५","text":"अयमात्मा परं ब्रह्म सत्यं ज्ञानमनन्तकं ॥२५","tr":"ayamātmā paraṃ brahma satyaṃ jñānamanantakaṃ ||25"},{"id":"161.52","n":"२६","text":"विज्ञानमानन्दं ब्रह्म तत्त्वमस्य.अहमस्मि तत् ।२६","tr":"vijñānamānandaṃ brahma tattvamasya.ahamasmi tat |26"},{"id":"161.53","n":"२६","text":"परं ब्रह्म ज्योतिरात्मा वासुदेवो विमुक्त ओं ॥२६","tr":"paraṃ brahma jyotirātmā vāsudevo vimukta oṃ ||26"},{"id":"161.54","n":"२७","text":"देहेन्द्रियमनोबुद्धिप्राणाहङ्कारवर्जितं ।२७","tr":"dehendriyamanobuddhiprāṇāhaṅkāravarjitaṃ |27"},{"id":"161.55","n":"२७","text":"जाग्रत्स्वप्नसुसुप्त्यादिमुक्तं(१) ब्रह्म तुरोयकं ॥२७","tr":"jāgratsvapnasusuptyādimuktaṃ(1) brahma turoyakaṃ ||27"},{"id":"161.56","n":"२८","text":"नित्यशुद्धबुद्धयुक्तसत्यमानन्दमद्वयं(२) ।२८","tr":"nityaśuddhabuddhayuktasatyamānandamadvayaṃ(2) |28"},{"id":"161.57","n":"२८","text":"अहं ब्रह्म परं ज्योतिरक्षरं सर्वगं हरिः ॥२८","tr":"ahaṃ brahma paraṃ jyotirakṣaraṃ sarvagaṃ hariḥ ||28"},{"id":"161.58","n":"२९","text":"सोऽसावादित्यपुरुषः सोऽसावहमखण्ड ओं ।२९","tr":"so'sāvādityapuruṣaḥ so'sāvahamakhaṇḍa oṃ |29"},{"id":"161.59","n":"२९","text":"सर्वारम्भपरित्यागी समदुःखसुखं क्षमी ॥२९","tr":"sarvārambhaparityāgī samaduḥkhasukhaṃ kṣamī ||29"},{"id":"161.60","n":"३०","text":"भावशुद्धश्च ब्रह्माण्डं भित्त्वा ब्रह्म भवेन्नरः ।३०","tr":"bhāvaśuddhaśca brahmāṇḍaṃ bhittvā brahma bhavennaraḥ |30"},{"id":"161.61","n":"३०","text":"आषढ्यां पौर्णमास्याञ्च चातुर्मास्यं व्रतञ्चरेत् ॥३०","tr":"āṣaḍhyāṃ paurṇamāsyāñca cāturmāsyaṃ vratañcaret ||30"},{"id":"161.62","n":"३१","text":"ततो ज्रजेत्नवम्यादौ ह्यृतुसन्धिषु वापयेत् ।३१","tr":"tato jrajetnavamyādau hyṛtusandhiṣu vāpayet |31"},{"id":"161.63","n":"३१","text":"प्रायश्चित्तं यतीनाञ्च ध्यानं वायुयमस्तथा ॥३१","tr":"prāyaścittaṃ yatīnāñca dhyānaṃ vāyuyamastathā ||31"},{"id":"161.64","text":"{{टिप्पणी|\n१ आग्रत्स्वप्नसुसुप्त्यान्तमुक्तमिति ङ.. , छ.. , ञ.. च\n२ इत्याग्नेये अशौचनिर्णय इत्यादिः, सत्यमानन्दमद्वयमित्यन्तः पाठो ग.. पुस्तके नास्ति}}","tr":"{{ṭippaṇī|\n1 āgratsvapnasusuptyāntamuktamiti ṅa.. , cha.. , ña.. ca\n2 ityāgneye aśaucanirṇaya ityādiḥ, satyamānandamadvayamityantaḥ pāṭho ga.. pustake nāsti}}"}]}