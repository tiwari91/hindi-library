{"book":"agni-purana","n":138,"title":"अध्याय १३८","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%A9%E0%A5%AE","items":[{"id":"138.1","n":"००१","speaker":"ईश्वर उवाच","text":"षट्कर्माणि प्रवक्ष्यामि सर्वमन्त्रेषु तच्छृणु ।१३८.००१","tr":"ṣaṭkarmāṇi pravakṣyāmi sarvamantreṣu tacchṛṇu |138.001"},{"id":"138.2","n":"००१","text":"आदौ साध्यं लिखेत्पूर्वं चान्ते मन्त्रसमन्वितं ॥१३८.००१","tr":"ādau sādhyaṃ likhetpūrvaṃ cānte mantrasamanvitaṃ ||138.001"},{"id":"138.3","n":"००२","text":"पल्लवः स तु विज्ञेयो महोच्चाटकरः परः ।१३८.००२","tr":"pallavaḥ sa tu vijñeyo mahoccāṭakaraḥ paraḥ |138.002"},{"id":"138.4","n":"००२","text":"आदौ मन्त्रः ततः साध्यो मध्ये साध्यः पुनर्मनुः ॥१३८.००२","tr":"ādau mantraḥ tataḥ sādhyo madhye sādhyaḥ punarmanuḥ ||138.002"},{"id":"138.5","n":"००३","text":"योगाख्यः सम्प्रदायोऽयङ्कुलोत्सादेषु योजयेत् ।१३८.००३","tr":"yogākhyaḥ sampradāyo'yaṅkulotsādeṣu yojayet |138.003"},{"id":"138.6","n":"००३","text":"आदौ मन्त्रपदन्दद्यान्मध्ये साध्यं नियोजयेत् ॥१३८.००३","tr":"ādau mantrapadandadyānmadhye sādhyaṃ niyojayet ||138.003"},{"id":"138.7","n":"००४","text":"पुनश्चान्ते लिखेन्मन्त्रं साध्यं मन्त्रपदं पुनः ।१३८.००४","tr":"punaścānte likhenmantraṃ sādhyaṃ mantrapadaṃ punaḥ |138.004"},{"id":"138.8","n":"००४","text":"रोधकः सम्प्रदायस्तु स्तम्भनादिषु योजयेत् ॥१३८.००४","tr":"rodhakaḥ sampradāyastu stambhanādiṣu yojayet ||138.004"},{"id":"138.9","n":"००५","text":"अधोर्ध्वं याम्यवामे तु(१) मध्ये साध्यन्तु योजयेत् ।१३८.००५","tr":"adhordhvaṃ yāmyavāme tu(1) madhye sādhyantu yojayet |138.005"},{"id":"138.10","n":"००५","text":"सम्पुटः सतु विज्ञेयो वश्याकर्षेषु योजयेत् ॥१३८.००५","tr":"sampuṭaḥ satu vijñeyo vaśyākarṣeṣu yojayet ||138.005"},{"id":"138.11","n":"००६","text":"मन्त्राक्षरं यदा साध्यं प्रथितञ्चाक्षराक्षरं ।१३८.००६","tr":"mantrākṣaraṃ yadā sādhyaṃ prathitañcākṣarākṣaraṃ |138.006"},{"id":"138.12","n":"००६","text":"प्रथमः सम्प्रदायः स्यादाकृष्टिवशकारकः ॥१३८.००६","tr":"prathamaḥ sampradāyaḥ syādākṛṣṭivaśakārakaḥ ||138.006"},{"id":"138.13","n":"००७","text":"मन्त्राक्षरद्वयं लिख्य एकं साध्यक्षरं पुनः ।१३८.००७","tr":"mantrākṣaradvayaṃ likhya ekaṃ sādhyakṣaraṃ punaḥ |138.007"},{"id":"138.14","n":"००७","text":"विदर्भः सतु विज्ञेयो वश्याकाकर्षेषु योजयेत् ॥१३८.००७","tr":"vidarbhaḥ satu vijñeyo vaśyākākarṣeṣu yojayet ||138.007"},{"id":"138.15","n":"००८","text":"आकर्षणाद्यत्कर्म वसन्ते चैव कारयेत् ।१३८.००८","tr":"ākarṣaṇādyatkarma vasante caiva kārayet |138.008"},{"id":"138.16","n":"००८","text":"तापज्वरे तथा वश्ये स्वाहा चाकर्षणे शुभं ॥१३८.००८","tr":"tāpajvare tathā vaśye svāhā cākarṣaṇe śubhaṃ ||138.008"},{"id":"138.17","n":"००९","text":"नमस्कारपदञ्चैव शान्तिवृद्धौ प्रयोजयेत् ।१३८.००९","tr":"namaskārapadañcaiva śāntivṛddhau prayojayet |138.009"},{"id":"138.18","n":"००९","text":"पौष्टिकेषु वषट्कारमाकर्षे वशकर्मणि ॥१३८.००९","tr":"pauṣṭikeṣu vaṣaṭkāramākarṣe vaśakarmaṇi ||138.009"},{"id":"138.19","n":"०१०","text":"विद्वेषोच्चाटने मृत्यौ फट्स्यात्खण्डीकृतौ शुभे ।१३८.०१०","tr":"vidveṣoccāṭane mṛtyau phaṭsyātkhaṇḍīkṛtau śubhe |138.010"},{"id":"138.20","n":"०१०","text":"लाभादौ मन्त्रदीक्षादौ वषट्कारस्तु सिद्धिदः ॥१३८.०१०","tr":"lābhādau mantradīkṣādau vaṣaṭkārastu siddhidaḥ ||138.010"},{"id":"138.21","n":"०११","text":"यमोऽसि यमाराजोऽसि कालरूपोऽसि धर्मराट् ।१३८.०११","tr":"yamo'si yamārājo'si kālarūpo'si dharmarāṭ |138.011"},{"id":"138.22","n":"०११","text":"मयादत्तमिमं शत्रुमचिरेण निपातय ॥१३८.०११","tr":"mayādattamimaṃ śatrumacireṇa nipātaya ||138.011"},{"id":"138.23","n":"०१२","text":"निपातयामि यत्नेन निवृत्तो भव साधक ।१३८.०१२","tr":"nipātayāmi yatnena nivṛtto bhava sādhaka |138.012"},{"id":"138.24","n":"०१२","text":"संहृष्टमनसा(२) ब्रूयाद्देशिकोऽरिप्रसूदनः ॥१३८.०१२","tr":"saṃhṛṣṭamanasā(2) brūyāddeśiko'riprasūdanaḥ ||138.012"},{"id":"138.25","n":"०१३","text":"पद्मे शुक्ले यमं प्रार्च्य होमादेतत्प्रसिद्ध्यति ।१३८.०१३","tr":"padme śukle yamaṃ prārcya homādetatprasiddhyati |138.013"},{"id":"138.26","n":"०१३","text":"आत्मानम्भैरवं ध्यात्वा ततो मध्ये कुलेश्वरीं ॥१३८.०१३","tr":"ātmānambhairavaṃ dhyātvā tato madhye kuleśvarīṃ ||138.013"},{"id":"138.27","n":"०१४","text":"रात्रौ वार्तां विजानाति आत्मनश्च परस्य च ।१३८.०१४","tr":"rātrau vārtāṃ vijānāti ātmanaśca parasya ca |138.014"},{"id":"138.28","n":"०१४","text":"टिप्पणी\n१ अध ऊर्ध्वं याम्यवामे इति ख..\n२ संरम्भमन्सेति छ..\nदुर्गे दुर्गे रक्षणीति दुर्गां प्रार्च्यारिहा भवेत् ॥१३८.०१४","tr":"ṭippaṇī\n1 adha ūrdhvaṃ yāmyavāme iti kha..\n2 saṃrambhamanseti cha..\ndurge durge rakṣaṇīti durgāṃ prārcyārihā bhavet ||138.014"},{"id":"138.29","n":"०१५","text":"जप्त्वा हसक्षमलवरयुम्भैरवीं घातयेदरिम् ॥१५॥१३८.०१५","tr":"japtvā hasakṣamalavarayumbhairavīṃ ghātayedarim ||15||138.015"},{"id":"138.30","text":"इत्याग्नेये महापुराणे युद्धजयार्णवे षट्कर्माणि नामाष्टत्रिंशदधिकशततमोऽध्यायः ॥","tr":"ityāgneye mahāpurāṇe yuddhajayārṇave ṣaṭkarmāṇi nāmāṣṭatriṃśadadhikaśatatamo'dhyāyaḥ ||"}]}