{"book":"agni-purana","n":212,"title":"अध्याय २१२","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A8%E0%A5%A7%E0%A5%A8","items":[{"id":"212.1","n":"००१","text":"अग्निरुवाच\nकाम्यदानानि वक्ष्यामि सर्वकाम प्रदानि ते ।२१२.००१","tr":"agniruvāca\nkāmyadānāni vakṣyāmi sarvakāma pradāni te |212.001"},{"id":"212.2","n":"००१","text":"नित्यपूजां मासि मासि कृत्वाथो काम्यपूजनं ॥२१२.००१","tr":"nityapūjāṃ māsi māsi kṛtvātho kāmyapūjanaṃ ||212.001"},{"id":"212.3","n":"००२","text":"व्रतार्हणं गुरोः पूजा वत्सरान्ते महार्चनं ।२१२.००२","tr":"vratārhaṇaṃ guroḥ pūjā vatsarānte mahārcanaṃ |212.002"},{"id":"212.4","n":"००२","text":"अश्वं वै मार्गशीर्षे तु कमलं पिष्टसम्भवं ॥२१२.००२","tr":"aśvaṃ vai mārgaśīrṣe tu kamalaṃ piṣṭasambhavaṃ ||212.002"},{"id":"212.5","n":"००३","text":"शिवाय पूज्य यो दद्यात्सूर्यलोके चिरं वसेत् स्वर्गलोके चिरं वसेदिति ग.. , घ.. , ङ.. , ट.. च । शिवलोके चिरं वसेदिति झ..(१) ।२१२.००३","tr":"śivāya pūjya yo dadyātsūryaloke ciraṃ vaset svargaloke ciraṃ vasediti ga.. , gha.. , ṅa.. , ṭa.. ca | śivaloke ciraṃ vasediti jha..(1) |212.003"},{"id":"212.6","n":"००३","text":"गजं पौषे पिष्टमयं त्रिसप्तकुलमुद्धरेत् ॥२१२.००३","tr":"gajaṃ pauṣe piṣṭamayaṃ trisaptakulamuddharet ||212.003"},{"id":"212.7","n":"००४","text":"माघे चाश्वरथं पैष्ठं दत्त्वा नरकं व्रजेत् ।२१२.००४","tr":"māghe cāśvarathaṃ paiṣṭhaṃ dattvā narakaṃ vrajet |212.004"},{"id":"212.8","n":"००४","text":"फाल्गुने तु वृषं पैष्टं स्वर्गभुक्स्यान्महीपतिः ॥२१२.००४","tr":"phālgune tu vṛṣaṃ paiṣṭaṃ svargabhuksyānmahīpatiḥ ||212.004"},{"id":"212.9","n":"००५","text":"चैत्रे चेक्षुमयीं गावन्दासदासीसमन्वितां ।२१२.००५","tr":"caitre cekṣumayīṃ gāvandāsadāsīsamanvitāṃ |212.005"},{"id":"212.10","n":"००५","text":"दत्त्वा स्वर्गे चिरं स्थित्वा तदन्ते स्यान्महीपतिः ॥२१२.००५","tr":"dattvā svarge ciraṃ sthitvā tadante syānmahīpatiḥ ||212.005"},{"id":"212.11","n":"००६","text":"सप्तव्रीहींश्च वैशाखे दत्त्वा शिवमयो भवेत् ।२१२.००६","tr":"saptavrīhīṃśca vaiśākhe dattvā śivamayo bhavet |212.006"},{"id":"212.12","n":"००६","text":"बलिमण्डलकञ्चान्नैः कृत्वाषाढे शिवो भवेत् ॥२१२.००६","tr":"balimaṇḍalakañcānnaiḥ kṛtvāṣāḍhe śivo bhavet ||212.006"},{"id":"212.13","n":"००७","text":"विमानं श्रावणे पौष्पं दत्त्वा स्वर्गी ततो नृपः ।२१२.००७","tr":"vimānaṃ śrāvaṇe pauṣpaṃ dattvā svargī tato nṛpaḥ |212.007"},{"id":"212.14","n":"००७","text":"शतद्वयं फलानान्तु दत्त्वोद्धृत्य कुलं नृपः ॥२१२.००७","tr":"śatadvayaṃ phalānāntu dattvoddhṛtya kulaṃ nṛpaḥ ||212.007"},{"id":"212.15","n":"००८","text":"गुग्गुलादि दहेद्भाद्रे स्वर्गी स स्यात्ततो नृपः ।२१२.००८","tr":"guggulādi dahedbhādre svargī sa syāttato nṛpaḥ |212.008"},{"id":"212.16","n":"००८","text":"क्षीरसर्पिर्भृतं पात्रमाश्विने स्वर्गदम्भवेत् ॥२१२.००८","tr":"kṣīrasarpirbhṛtaṃ pātramāśvine svargadambhavet ||212.008"},{"id":"212.17","n":"००९","text":"कार्त्तिके गुडखण्डाज्यं दत्त्वा स्वर्गी ततो नृपः ।२१२.००९","tr":"kārttike guḍakhaṇḍājyaṃ dattvā svargī tato nṛpaḥ |212.009"},{"id":"212.18","n":"००९","text":"मेरुदानं द्वादशकं वक्ष्येऽहं भुक्तिमुक्तिदं ॥२१२.००९","tr":"merudānaṃ dvādaśakaṃ vakṣye'haṃ bhuktimuktidaṃ ||212.009"},{"id":"212.19","n":"०१०","text":"मेरुव्रते तु कार्त्तिक्यां रत्नमेरुन्ददेद्द्विजे ।२१२.०१०","tr":"meruvrate tu kārttikyāṃ ratnamerundadeddvije |212.010"},{"id":"212.20","n":"०१०","text":"सर्वेषाञ्चैव मेरूणां प्रमाणं क्रमशः शृणु ॥२१२.०१०","tr":"sarveṣāñcaiva merūṇāṃ pramāṇaṃ kramaśaḥ śṛṇu ||212.010"},{"id":"212.21","n":"०११","text":"वज्रपद्ममहानीलनीलस्फटिकसञ्ज्ञितः ।२१२.०११","tr":"vajrapadmamahānīlanīlasphaṭikasañjñitaḥ |212.011"},{"id":"212.22","n":"०११","text":"पुष्पं मरकतं मुक्ता प्रस्थमात्रेण चोत्तमः ॥२१२.०११","tr":"puṣpaṃ marakataṃ muktā prasthamātreṇa cottamaḥ ||212.011"},{"id":"212.23","n":"०१२","text":"मध्योऽर्धः स्यात्तदर्धोऽधो वित्तशाठ्यं विवर्जयेत् ।२१२.०१२","tr":"madhyo'rdhaḥ syāttadardho'dho vittaśāṭhyaṃ vivarjayet |212.012"},{"id":"212.24","n":"०१२","text":"कार्णिकायां न्यसेन्मेरुं ब्रह्मविष्ण्वीशदैवतं ॥२१२.०१२","tr":"kārṇikāyāṃ nyasenmeruṃ brahmaviṣṇvīśadaivataṃ ||212.012"},{"id":"212.25","n":"०१३","text":"माल्यवान् पूर्वतः पूज्यस्तत्पूर्वे भद्रसञ्ज्ञितः ।२१२.०१३","tr":"mālyavān pūrvataḥ pūjyastatpūrve bhadrasañjñitaḥ |212.013"},{"id":"212.26","n":"०१३","text":"अश्वरक्षस्ततः प्रोक्तो निषधो मेरुदक्षिणे ॥२१२.०१३","tr":"aśvarakṣastataḥ prokto niṣadho merudakṣiṇe ||212.013"},{"id":"212.27","n":"०१४","text":"हेमकूटोऽथ हिमवान् त्रयं सौम्ये तथा त्रयं ।२१२.०१४","tr":"hemakūṭo'tha himavān trayaṃ saumye tathā trayaṃ |212.014"},{"id":"212.28","n":"०१४","text":"नीलः श्वेतश्च शृङ्गी च पश्चिमे गन्धमादनः ॥२१२.०१४","tr":"nīlaḥ śvetaśca śṛṅgī ca paścime gandhamādanaḥ ||212.014"},{"id":"212.29","n":"०१५","text":"वैकङ्कः केतुमालः स्यान्मेरुर्द्वादशसंयुतः ।२१२.०१५","tr":"vaikaṅkaḥ ketumālaḥ syānmerurdvādaśasaṃyutaḥ |212.015"},{"id":"212.30","n":"०१५","text":"सोपवासोऽर्चयेद्विष्णुं शिवं वा स्नानपूर्वकं ॥२१२.०१५","tr":"sopavāso'rcayedviṣṇuṃ śivaṃ vā snānapūrvakaṃ ||212.015"},{"id":"212.31","n":"०१६","text":"देवाग्रे चार्च्य मेरुञ्च मन्त्रैर्विप्राय वै ददेत् ।२१२.०१६","tr":"devāgre cārcya meruñca mantrairviprāya vai dadet |212.016"},{"id":"212.32","n":"०१६","text":"विप्रायामुकगोत्राय मेरुन्द्रव्यमयम्परं ॥२१२.०१६","tr":"viprāyāmukagotrāya merundravyamayamparaṃ ||212.016"},{"id":"212.33","n":"०१७","text":"भुक्त्यै मुक्त्यै निर्मलत्वे विष्णुदैवं ददामि ते ।२१२.०१७","tr":"bhuktyai muktyai nirmalatve viṣṇudaivaṃ dadāmi te |212.017"},{"id":"212.34","n":"०१७","text":"इन्द्रलोके ब्रह्मलोके शिवलोके हरेः पुरे ॥२१२.०१७","tr":"indraloke brahmaloke śivaloke hareḥ pure ||212.017"},{"id":"212.35","n":"०१८","text":"कुलमुद्धृत्य क्रीडेत विमाने देवपूजितः ।२१२.०१८","tr":"kulamuddhṛtya krīḍeta vimāne devapūjitaḥ |212.018"},{"id":"212.36","n":"०१८","text":"अन्येष्वपि च कालेषु सङ्क्रान्त्यादौ प्रदापयेत् ॥२१२.०१८","tr":"anyeṣvapi ca kāleṣu saṅkrāntyādau pradāpayet ||212.018"},{"id":"212.37","n":"०१९","text":"पलानान्तु सहस्रेण हेममेरुम्प्रकल्पयेत् ।२१२.०१९","tr":"palānāntu sahasreṇa hemamerumprakalpayet |212.019"},{"id":"212.38","n":"०१९","text":"शृङ्गत्रयसमायुक्तं ब्रह्मविष्णुहरान्वितं ॥२१२.०१९","tr":"śṛṅgatrayasamāyuktaṃ brahmaviṣṇuharānvitaṃ ||212.019"},{"id":"212.39","n":"०२०","text":"एकैकं पर्वतन्तस्य शतैकैकेन कारयेत् ।२१२.०२०","tr":"ekaikaṃ parvatantasya śataikaikena kārayet |212.020"},{"id":"212.40","n":"०२०","text":"मेरुणा सह शैलास्तु ख्यातास्तत्र त्रयोदश ॥२१२.०२०","tr":"meruṇā saha śailāstu khyātāstatra trayodaśa ||212.020"},{"id":"212.41","n":"०२१","text":"अयने ग्रहणादौ च विष्ण्वग्रे हरिमर्च्य च ।२१२.०२१","tr":"ayane grahaṇādau ca viṣṇvagre harimarcya ca |212.021"},{"id":"212.42","n":"०२१","text":"स्वर्णमेरुं द्विजायार्प्य विष्णुलोके चिरं वसेत् ॥२१२.०२१","tr":"svarṇameruṃ dvijāyārpya viṣṇuloke ciraṃ vaset ||212.021"},{"id":"212.43","n":"०२२","text":"परमाणवो यावन्त इह राजा भवेच्चिरं ।२१२.०२२","tr":"paramāṇavo yāvanta iha rājā bhavecciraṃ |212.022"},{"id":"212.44","n":"०२२","text":"रौप्यमेरुं द्वादशाद्रियुतं सङ्कल्पतो ददेत्सङ्कल्प्य तद्ददेदिति ग.. , घ.. , ङ.. , ञ.. च(१) ॥२१२.०२२","tr":"raupyameruṃ dvādaśādriyutaṃ saṅkalpato dadetsaṅkalpya taddadediti ga.. , gha.. , ṅa.. , ña.. ca(1) ||212.022"},{"id":"212.45","n":"०२३","text":"प्रागुक्तं च फलं तस्य विष्णुं विप्रं प्रपूज्य च ।२१२.०२३","tr":"prāguktaṃ ca phalaṃ tasya viṣṇuṃ vipraṃ prapūjya ca |212.023"},{"id":"212.46","n":"०२३","text":"भूमिमेरुञ्च विषयं मण्डलं ग्राममेव चमण्डलं ग्राममेवेति ग.. , झ.. , ट.. च(२) ॥२१२.०२३","tr":"bhūmimeruñca viṣayaṃ maṇḍalaṃ grāmameva camaṇḍalaṃ grāmameveti ga.. , jha.. , ṭa.. ca(2) ||212.023"},{"id":"212.47","n":"०२४","text":"परिकल्प्याष्टमांशेन शेषांशाःशेषाङ्गा इति ख..(३) पूर्ववत्फलं ।२१२.०२४","tr":"parikalpyāṣṭamāṃśena śeṣāṃśāḥśeṣāṅgā iti kha..(3) pūrvavatphalaṃ |212.024"},{"id":"212.48","n":"०२४","text":"द्वादशाद्रिसमायुक्तं हस्तिमेरुस्वरूपिणं ॥२१२.०२४","tr":"dvādaśādrisamāyuktaṃ hastimerusvarūpiṇaṃ ||212.024"},{"id":"212.49","n":"०२५","text":"ददेत्त्रिपुरुषैर्युक्तं दत्त्वानन्तं फलं लभेत् ।२१२.०२५","tr":"dadettripuruṣairyuktaṃ dattvānantaṃ phalaṃ labhet |212.025"},{"id":"212.50","n":"०२५","text":"त्रिपञ्चाश्वैरश्वमेरुं हययद्वादशसंयुतं ॥२१२.०२५","tr":"tripañcāśvairaśvameruṃ hayayadvādaśasaṃyutaṃ ||212.025"},{"id":"212.51","n":"०२६","text":"विष्ण्वादीन् पूज्य तं दत्त्वा भुक्तभोगो नृपो भवेत् ।२१२.०२६","tr":"viṣṇvādīn pūjya taṃ dattvā bhuktabhogo nṛpo bhavet |212.026"},{"id":"212.52","n":"०२६","text":"अश्वसङ्ख्याप्रमाणेन गोमेरुं पूर्ववद्ददेत् ॥२१२.०२६","tr":"aśvasaṅkhyāpramāṇena gomeruṃ pūrvavaddadet ||212.026"},{"id":"212.53","n":"०२७","text":"पट्टवस्त्रैर्भारमात्रैर्वस्त्रमेरुश्च मध्यतः ।२१२.०२७","tr":"paṭṭavastrairbhāramātrairvastrameruśca madhyataḥ |212.027"},{"id":"212.54","n":"०२७","text":"शैलैर्द्वादशवस्त्रैश्च दत्त्वा तञ्चाक्षयं फलं ॥२१२.०२७","tr":"śailairdvādaśavastraiśca dattvā tañcākṣayaṃ phalaṃ ||212.027"},{"id":"212.55","n":"०२८","text":"घृतपञ्चसहस्रैश्च पलानामाज्यपर्वतः ।२१२.०२८","tr":"ghṛtapañcasahasraiśca palānāmājyaparvataḥ |212.028"},{"id":"212.56","n":"०२८","text":"शतैः पञ्चभिरेकैकः पर्वतेऽस्मिन् हरिं यजेत् ॥२१२.०२८","tr":"śataiḥ pañcabhirekaikaḥ parvate'smin hariṃ yajet ||212.028"},{"id":"212.57","n":"०२९","text":"विष्ण्वग्रे ब्राह्मणायार्प्य सर्वं प्राप्य हरिं व्रजेत् ।२१२.०२९","tr":"viṣṇvagre brāhmaṇāyārpya sarvaṃ prāpya hariṃ vrajet |212.029"},{"id":"212.58","n":"०२९","text":"एवं च खण्डमेरुञ्च कृत्वा दत्त्वाप्नुयात्फलं ॥२१२.०२९","tr":"evaṃ ca khaṇḍameruñca kṛtvā dattvāpnuyātphalaṃ ||212.029"},{"id":"212.59","n":"०३०","text":"धान्यमेरुः पञ्चखारोऽपर एकैकखारकाः ।२१२.०३०","tr":"dhānyameruḥ pañcakhāro'para ekaikakhārakāḥ |212.030"},{"id":"212.60","n":"०३०","text":"स्वर्णत्रिशृङ्गकाः सर्वे ब्रह्मविष्णुमहेश्वरान् ॥२१२.०३०","tr":"svarṇatriśṛṅgakāḥ sarve brahmaviṣṇumaheśvarān ||212.030"},{"id":"212.61","n":"०३१","text":"सर्वेषु पूज्य विष्णुं वा विशेषादक्षयं फलं ।२१२.०३१","tr":"sarveṣu pūjya viṣṇuṃ vā viśeṣādakṣayaṃ phalaṃ |212.031"},{"id":"212.62","n":"०३१","text":"एवं दशांशमानेन तिलमेरुं प्रकल्पयेत् ॥२१२.०३१","tr":"evaṃ daśāṃśamānena tilameruṃ prakalpayet ||212.031"},{"id":"212.63","n":"०३२","text":"शृङ्गाणि पूर्ववत्तस्य तथैवान्यनगेषु च ।२१२.०३२","tr":"śṛṅgāṇi pūrvavattasya tathaivānyanageṣu ca |212.032"},{"id":"212.64","n":"०३२","text":"तिलमेरुं प्रदायाथ बन्धुभिर्विष्णुलोकभाक्१ बन्धुभिर्ब्रह्मलोकभागिति झ..(१) ॥२१२.०३२","tr":"tilameruṃ pradāyātha bandhubhirviṣṇulokabhāk1 bandhubhirbrahmalokabhāgiti jha..(1) ||212.032"},{"id":"212.65","n":"०३३","text":"नमो विष्णुस्वरूपाय धराधराय वै नमः ।२१२.०३३","tr":"namo viṣṇusvarūpāya dharādharāya vai namaḥ |212.033"},{"id":"212.66","n":"०३३","text":"ब्रह्मविष्ण्वीशशृङ्गाय धरानाभिस्थिताय च ॥२१२.०३३","tr":"brahmaviṣṇvīśaśṛṅgāya dharānābhisthitāya ca ||212.033"},{"id":"212.67","n":"०३४","text":"नगद्वादशनाथाय सर्वपापापहारिणे ।२१२.०३४","tr":"nagadvādaśanāthāya sarvapāpāpahāriṇe |212.034"},{"id":"212.68","n":"०३४","text":"विष्णुभक्ताय शान्ताय त्राणं मे कुरु सर्वथा ॥२१२.०३४","tr":"viṣṇubhaktāya śāntāya trāṇaṃ me kuru sarvathā ||212.034"},{"id":"212.69","n":"०३५","text":"निष्पापः पितृभिः सार्धं विष्णुं गच्छामि ओं नमः ।२१२.०३५","tr":"niṣpāpaḥ pitṛbhiḥ sārdhaṃ viṣṇuṃ gacchāmi oṃ namaḥ |212.035"},{"id":"212.70","n":"०३५","text":"त्वं हरिस्तु हरेरग्रे अहं विष्णुश्च विष्णवे ॥२१२.०३५","tr":"tvaṃ haristu hareragre ahaṃ viṣṇuśca viṣṇave ||212.035"},{"id":"212.71","n":"०३६","text":"निवेदयामि भक्त्या तु भुक्तिमुक्त्यर्थहेतवे ।२१२.०३६","tr":"nivedayāmi bhaktyā tu bhuktimuktyarthahetave |212.036"},{"id":"212.72","text":"इत्याग्नेये महापुराणे मेरुदानानि नाम द्वादशाधिकद्विशततमोऽध्यायः ॥","tr":"ityāgneye mahāpurāṇe merudānāni nāma dvādaśādhikadviśatatamo'dhyāyaḥ ||"}]}