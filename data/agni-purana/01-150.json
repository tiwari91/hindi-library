{"book":"agni-purana","n":150,"title":"अध्याय १५०","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%AB%E0%A5%A6","items":[{"id":"150.1","n":"००१","text":"अग्निरुवाच\nमन्वन्तराणि वक्ष्यामि आद्याः स्वायम्भुवो मनुः ।१५०.००१","tr":"agniruvāca\nmanvantarāṇi vakṣyāmi ādyāḥ svāyambhuvo manuḥ |150.001"},{"id":"150.2","n":"००१","text":"अग्नीध्राद्यास्तस्य सुता यमो नाम तदा सुराः ॥१५०.००१","tr":"agnīdhrādyāstasya sutā yamo nāma tadā surāḥ ||150.001"},{"id":"150.3","n":"००२","text":"और्वाद्याश्च सप्तर्षय इन्द्रश्चैव शतक्रतुः ।१५०.००२","tr":"aurvādyāśca saptarṣaya indraścaiva śatakratuḥ |150.002"},{"id":"150.4","n":"००२","text":"पारावताः सतुषिता देवाः स्वारोचिषेऽन्तरे ॥१५०.००२","tr":"pārāvatāḥ satuṣitā devāḥ svārociṣe'ntare ||150.002"},{"id":"150.5","n":"००३","text":"विपश्चित्तत्र देवेन्द्र ऊर्जस्तम्भादयो द्विजाः ।१५०.००३","tr":"vipaścittatra devendra ūrjastambhādayo dvijāḥ |150.003"},{"id":"150.6","n":"००३","text":"चैत्रकिम्पुरुषाः पुत्रास्तृतीयश्चोत्तोतमो मनुः ॥१५०.००३","tr":"caitrakimpuruṣāḥ putrāstṛtīyaścottotamo manuḥ ||150.003"},{"id":"150.7","n":"००४","text":"सुशान्तिरिन्द्रो देवाश्च सुधामाद्या वशिष्ठजाः ।१५०.००४","tr":"suśāntirindro devāśca sudhāmādyā vaśiṣṭhajāḥ |150.004"},{"id":"150.8","n":"००४","text":"सप्तर्षयोऽजाद्याः पुत्राश्चतुर्थस्तामसी मनुः ॥१५०.००४","tr":"saptarṣayo'jādyāḥ putrāścaturthastāmasī manuḥ ||150.004"},{"id":"150.9","n":"००५","text":"स्वरूपाद्याः सुरगणाः शिखिरिन्द्रः सुरेश्वरः ।१५०.००५","tr":"svarūpādyāḥ suragaṇāḥ śikhirindraḥ sureśvaraḥ |150.005"},{"id":"150.10","n":"००५","text":"ज्योतिर्धामादयो विप्रा नव ख्यातिमुखाः सुताः ॥१५०.००५","tr":"jyotirdhāmādayo viprā nava khyātimukhāḥ sutāḥ ||150.005"},{"id":"150.11","n":"००६","text":"रैवते वितथश्चेन्द्रो अमिताभास्तथा सुराः ।१५०.००६","tr":"raivate vitathaścendro amitābhāstathā surāḥ |150.006"},{"id":"150.12","n":"००६","text":"हिरण्यरोमाद्या मुनयो(१) बलबन्धादयः सुताः ॥१५०.००६","tr":"hiraṇyaromādyā munayo(1) balabandhādayaḥ sutāḥ ||150.006"},{"id":"150.13","n":"००७","text":"मनोजवश्चाक्षुषेऽथ इन्द्रः स्वात्यादयः सुराः ।१५०.००७","tr":"manojavaścākṣuṣe'tha indraḥ svātyādayaḥ surāḥ |150.007"},{"id":"150.14","n":"००७","text":"सुमेधाद्या महर्षयः पुरुप्रभृतयः सुताः ॥१५०.००७","tr":"sumedhādyā maharṣayaḥ puruprabhṛtayaḥ sutāḥ ||150.007"},{"id":"150.15","n":"००८","text":"विवस्वतः सुतो विप्रः श्राद्धदेवो मनुस्ततः ।१५०.००८","tr":"vivasvataḥ suto vipraḥ śrāddhadevo manustataḥ |150.008"},{"id":"150.16","n":"००८","text":"आदित्यवसुरुद्राद्या देवा इन्द्रः पुरन्दरः ॥१५०.००८","tr":"ādityavasurudrādyā devā indraḥ purandaraḥ ||150.008"},{"id":"150.17","n":"००९","text":"वशिष्ठः काश्यपोऽथात्रिर्जमदग्निः सगोतमः ।१५०.००९","tr":"vaśiṣṭhaḥ kāśyapo'thātrirjamadagniḥ sagotamaḥ |150.009"},{"id":"150.18","n":"००९","text":"विश्वामित्रभरद्वाजौ मुनयः सप्त साम्प्रतं ॥१५०.००९","tr":"viśvāmitrabharadvājau munayaḥ sapta sāmprataṃ ||150.009"},{"id":"150.19","n":"०१०","text":"इक्ष्वाकुप्रमुखाः पुत्रा अंशेन हरिराभवत् ।१५०.०१०","tr":"ikṣvākupramukhāḥ putrā aṃśena harirābhavat |150.010"},{"id":"150.20","n":"०१०","text":"स्वायम्भुवे मानसोऽभूदजितस्तदनन्तरे ॥१५०.०१०","tr":"svāyambhuve mānaso'bhūdajitastadanantare ||150.010"},{"id":"150.21","n":"०११","text":"सत्यो हरिर्देवदरो वैकुण्ठो वामनः क्रमात् ।१५०.०११","tr":"satyo harirdevadaro vaikuṇṭho vāmanaḥ kramāt |150.011"},{"id":"150.22","n":"०११","text":"छायाजः सूर्यपुत्रस्तु भविता चाष्टमो मनुः ॥१५०.०११","tr":"chāyājaḥ sūryaputrastu bhavitā cāṣṭamo manuḥ ||150.011"},{"id":"150.23","n":"०१२","text":"पूर्वस्य च सवर्णोऽसौ सावर्णिर्भविताष्टमः ।१५०.०१२","tr":"pūrvasya ca savarṇo'sau sāvarṇirbhavitāṣṭamaḥ |150.012"},{"id":"150.24","n":"०१२","text":"सुतपाद्या देवगणा दीप्तिमद्द्रौणिकादयः ॥१५०.०१२","tr":"sutapādyā devagaṇā dīptimaddrauṇikādayaḥ ||150.012"},{"id":"150.25","n":"०१३","text":"मुनयो बलिरिन्द्रश्च विरजप्रमुखाः सुताः ।१५०.०१३","tr":"munayo balirindraśca virajapramukhāḥ sutāḥ |150.013"},{"id":"150.26","n":"०१३","text":"नवमो दक्षसावर्णिः पाराद्याश्च तदा सुराः(२) ॥१५०.०१३","tr":"navamo dakṣasāvarṇiḥ pārādyāśca tadā surāḥ(2) ||150.013"},{"id":"150.27","n":"०१४","text":"इन्द्रश्चैवाद्भुतस्तेषां सवनाद्या द्विजोत्तमाः ।१५०.०१४","tr":"indraścaivādbhutasteṣāṃ savanādyā dvijottamāḥ |150.014"},{"id":"150.28","n":"०१४","text":"धृतकेत्वादयः पुत्रा ब्रह्मसावर्णिरित्यतः ॥१५०.०१४","tr":"dhṛtaketvādayaḥ putrā brahmasāvarṇirityataḥ ||150.014"},{"id":"150.29","n":"०१५","text":"सुखादयो देवगणास्तेषां शान्तिः शतक्रतुः ।१५०.०१५","tr":"sukhādayo devagaṇāsteṣāṃ śāntiḥ śatakratuḥ |150.015"},{"id":"150.30","n":"०१५","text":"टिप्पणी\n१ हिरण्यरोमाद्या ऋषय इति ञ..\n२ तथा सुरा इति छ..\nहविष्याद्याश्च मुनयः सुक्षेत्राद्याश्च तत्सुताः ॥१५०.०१५","tr":"ṭippaṇī\n1 hiraṇyaromādyā ṛṣaya iti ña..\n2 tathā surā iti cha..\nhaviṣyādyāśca munayaḥ sukṣetrādyāśca tatsutāḥ ||150.015"},{"id":"150.31","n":"०१६","text":"धर्मसावर्णिकश्चाथ विहङ्गाद्यास्तदा सुराः ।१५०.०१६","tr":"dharmasāvarṇikaścātha vihaṅgādyāstadā surāḥ |150.016"},{"id":"150.32","n":"०१६","text":"गणेशश्चेन्द्रो नश्चराद्या मुनयः पुत्रकामयोः ॥१५०.०१६","tr":"gaṇeśaścendro naścarādyā munayaḥ putrakāmayoḥ ||150.016"},{"id":"150.33","n":"०१७","text":"सर्वत्रगाद्या रुद्राख्यः सावर्णिभविता मनुः ।१५०.०१७","tr":"sarvatragādyā rudrākhyaḥ sāvarṇibhavitā manuḥ |150.017"},{"id":"150.34","n":"०१७","text":"ऋतधामा सुरेन्द्रश्च हरिताद्याश्च देवताः ॥१५०.०१७","tr":"ṛtadhāmā surendraśca haritādyāśca devatāḥ ||150.017"},{"id":"150.35","n":"०१८","text":"तपस्याद्याः सप्तर्षयः सुता वै देववन्मुखाः ।१५०.०१८","tr":"tapasyādyāḥ saptarṣayaḥ sutā vai devavanmukhāḥ |150.018"},{"id":"150.36","n":"०१८","text":"मनुस्त्रयोदशो रौच्यः सुत्रामाणादयः सुराः ॥१५०.०१८","tr":"manustrayodaśo raucyaḥ sutrāmāṇādayaḥ surāḥ ||150.018"},{"id":"150.37","n":"०१९","text":"इन्द्रो दिवस्पतिस्तेषां दानवादिविमर्दनः ।१५०.०१९","tr":"indro divaspatisteṣāṃ dānavādivimardanaḥ |150.019"},{"id":"150.38","n":"०१९","text":"निर्मोहाद्याः सप्तर्षयश्चित्रसेनादयः सुताः ॥१५०.०१९","tr":"nirmohādyāḥ saptarṣayaścitrasenādayaḥ sutāḥ ||150.019"},{"id":"150.39","n":"०२०","text":"मनुश्चतुर्दशो भौत्यः शुचिरिन्द्रो भविष्यति ।१५०.०२०","tr":"manuścaturdaśo bhautyaḥ śucirindro bhaviṣyati |150.020"},{"id":"150.40","n":"०२०","text":"चाक्षुषाद्याः सुरगणा अग्निबाह्णादयो द्विजाः ॥१५०.०२०","tr":"cākṣuṣādyāḥ suragaṇā agnibāhṇādayo dvijāḥ ||150.020"},{"id":"150.41","n":"०२१","text":"चतुर्दशस्य भौत्यस्य पुत्रा ऊरुमुखा मनोः ।१५०.०२१","tr":"caturdaśasya bhautyasya putrā ūrumukhā manoḥ |150.021"},{"id":"150.42","n":"०२१","text":"प्रवर्तयन्ति वेदांश्च भुवि सप्तर्षयो दिवः ॥१५०.०२१","tr":"pravartayanti vedāṃśca bhuvi saptarṣayo divaḥ ||150.021"},{"id":"150.43","n":"०२२","text":"देवा यज्ञभुजस्ते तु भूः पुत्रैः परिपाल्यते ।१५०.०२२","tr":"devā yajñabhujaste tu bhūḥ putraiḥ paripālyate |150.022"},{"id":"150.44","n":"०२२","text":"ब्रह्मणो दिवसे ब्रह्मन्मनवस्तु चतुर्दश ॥१५०.०२२","tr":"brahmaṇo divase brahmanmanavastu caturdaśa ||150.022"},{"id":"150.45","n":"०२३","text":"मन्वाद्याश्च हरिर्वेदं द्वापरान्ते विभेद सः ।१५०.०२३","tr":"manvādyāśca harirvedaṃ dvāparānte vibheda saḥ |150.023"},{"id":"150.46","n":"०२३","text":"आद्यो वेदश्चतुष्पादः शतसाहस्रसम्मितः ॥१५०.०२३","tr":"ādyo vedaścatuṣpādaḥ śatasāhasrasammitaḥ ||150.023"},{"id":"150.47","n":"०२४","text":"एकश्चासीद्यजुर्वेदस्तं चतुर्धा व्यकल्पयत् ।१५०.०२४","tr":"ekaścāsīdyajurvedastaṃ caturdhā vyakalpayat |150.024"},{"id":"150.48","n":"०२४","text":"आध्वर्यवं यजुर्भिस्तु ऋग्भिर्होत्रं तथा मुनिः ॥१५०.०२४","tr":"ādhvaryavaṃ yajurbhistu ṛgbhirhotraṃ tathā muniḥ ||150.024"},{"id":"150.49","n":"०२५","text":"औद्गात्रं सामभिओश्चक्रे ब्रह्मत्वञ्चाप्यथर्वभिः ।१५०.०२५","tr":"audgātraṃ sāmabhioścakre brahmatvañcāpyatharvabhiḥ |150.025"},{"id":"150.50","n":"०२५","text":"प्रथमं व्यासशिष्यस्तु पैलो ह्यृग्वेदपारगः ॥१५०.०२५","tr":"prathamaṃ vyāsaśiṣyastu pailo hyṛgvedapāragaḥ ||150.025"},{"id":"150.51","n":"०२६","text":"इन्द्रः प्रमतये प्रादाद्वास्कलाय च संहितां ।१५०.०२६","tr":"indraḥ pramataye prādādvāskalāya ca saṃhitāṃ |150.026"},{"id":"150.52","n":"०२६","text":"बौध्यादिभ्यो ददौ सोपि चतुर्धा निजसंहितां ॥१५०.०२६","tr":"baudhyādibhyo dadau sopi caturdhā nijasaṃhitāṃ ||150.026"},{"id":"150.53","n":"०२७","text":"यजुर्वेदतरोः शाखाः सप्तविंशन्महामतिः ।१५०.०२७","tr":"yajurvedataroḥ śākhāḥ saptaviṃśanmahāmatiḥ |150.027"},{"id":"150.54","n":"०२७","text":"वैशम्पायननामासौ व्यासशिष्यश्चकार वै ॥१५०.०२७","tr":"vaiśampāyananāmāsau vyāsaśiṣyaścakāra vai ||150.027"},{"id":"150.55","n":"०२८","text":"काण्वा वाजसनेयाद्या याज्ञवल्क्यादिभिः स्मृताः ।१५०.०२८","tr":"kāṇvā vājasaneyādyā yājñavalkyādibhiḥ smṛtāḥ |150.028"},{"id":"150.56","n":"०२८","text":"सामवेदतरोः शाखा व्यासशिष्यः सजैमिनिः ॥१५०.०२८","tr":"sāmavedataroḥ śākhā vyāsaśiṣyaḥ sajaiminiḥ ||150.028"},{"id":"150.57","n":"०२९","text":"सुमन्तुश्च सुकर्मा च एकैकां संहितां ततः ।१५०.०२९","tr":"sumantuśca sukarmā ca ekaikāṃ saṃhitāṃ tataḥ |150.029"},{"id":"150.58","n":"०२९","text":"गृह्णते च सुकर्माख्यः सहस्रं संहितां गुरुः ॥१५०.०२९","tr":"gṛhṇate ca sukarmākhyaḥ sahasraṃ saṃhitāṃ guruḥ ||150.029"},{"id":"150.59","n":"०३०","text":"सुमन्तुश्चाथर्वतरुं व्यासशिष्यो विभेद तं ।१५०.०३०","tr":"sumantuścātharvataruṃ vyāsaśiṣyo vibheda taṃ |150.030"},{"id":"150.60","n":"०३०","text":"शिष्यानध्यापयामास पैप्यलादान् सहस्रशः ॥१५०.०३०","tr":"śiṣyānadhyāpayāmāsa paipyalādān sahasraśaḥ ||150.030"},{"id":"150.61","n":"०३१","text":"पुराणसंहितां चक्रे सुतो व्यासप्रसादतः ॥३१॥१५०.०३१","tr":"purāṇasaṃhitāṃ cakre suto vyāsaprasādataḥ ||31||150.031"},{"id":"150.62","text":"इत्याग्नेये महापुराणे मन्वन्तराणि नाम पञ्चाशदधिकशततमोऽध्यायः ॥","tr":"ityāgneye mahāpurāṇe manvantarāṇi nāma pañcāśadadhikaśatatamo'dhyāyaḥ ||"}]}