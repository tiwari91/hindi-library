{"book":"agni-purana","n":215,"title":"अध्याय २१५","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A8%E0%A5%A7%E0%A5%AB","items":[{"id":"215.1","n":"०१","text":"अग्निरुवाच\nओङ्कारं यो विजानाति स योगी स हरिः पुमान् ।०१","tr":"agniruvāca\noṅkāraṃ yo vijānāti sa yogī sa hariḥ pumān |01"},{"id":"215.2","n":"०१","text":"ओङ्कारमभ्यसेत्तस्मान्मृन्मन्त्रसारन्तु सर्वदं ॥०१","tr":"oṅkāramabhyasettasmānmṛnmantrasārantu sarvadaṃ ||01"},{"id":"215.3","n":"०२","text":"सर्वमन्त्रप्रयोगेषु प्रणवः प्रथमः स्मृतः ।०२","tr":"sarvamantraprayogeṣu praṇavaḥ prathamaḥ smṛtaḥ |02"},{"id":"215.4","n":"०२","text":"तेन सम्परिपूर्णं यत्तत्पूर्णं कर्म नेतरत् ॥०२","tr":"tena samparipūrṇaṃ yattatpūrṇaṃ karma netarat ||02"},{"id":"215.5","n":"०३","text":"ओङ्कारपूर्विकास्तिस्रो महाव्याहृतयोऽव्ययाः ।०३","tr":"oṅkārapūrvikāstisro mahāvyāhṛtayo'vyayāḥ |03"},{"id":"215.6","n":"०३","text":"त्रिपदा चैव सावित्री विज्ञेयं ब्रह्मणी मुखं ॥०३","tr":"tripadā caiva sāvitrī vijñeyaṃ brahmaṇī mukhaṃ ||03"},{"id":"215.7","n":"०४","text":"योऽधीतेऽहन्यहन्येतास्त्रीणि वर्षाण्यतन्त्रितः ।०४","tr":"yo'dhīte'hanyahanyetāstrīṇi varṣāṇyatantritaḥ |04"},{"id":"215.8","n":"०४","text":"स ब्रह्मपरमभ्येति वायुभूतः खमूर्तिमान् ॥०४","tr":"sa brahmaparamabhyeti vāyubhūtaḥ khamūrtimān ||04"},{"id":"215.9","n":"०५","text":"एकाक्षरं परं ब्रह्म प्राणायामपरन्तपः ।०५","tr":"ekākṣaraṃ paraṃ brahma prāṇāyāmaparantapaḥ |05"},{"id":"215.10","n":"०५","text":"सावित्र्यास्तु परन्नास्ति मौनात्सत्यं विशिष्यते ॥०५","tr":"sāvitryāstu parannāsti maunātsatyaṃ viśiṣyate ||05"},{"id":"215.11","n":"०६","text":"सप्तावर्ता पापहरा दशभिः प्रापयेद्दिवं ।०६","tr":"saptāvartā pāpaharā daśabhiḥ prāpayeddivaṃ |06"},{"id":"215.12","n":"०६","text":"विंशावर्ता तु सा देवी नयते हीश्वरालयं ॥०६","tr":"viṃśāvartā tu sā devī nayate hīśvarālayaṃ ||06"},{"id":"215.13","n":"०७","text":"अष्टोत्तरशतं जप्त्वा तीर्णः संसारसागरात् ।०७","tr":"aṣṭottaraśataṃ japtvā tīrṇaḥ saṃsārasāgarāt |07"},{"id":"215.14","n":"०७","text":"रुद्रकुष्माण्डजप्येभ्यो गायत्री तु विशिष्यते ॥०७","tr":"rudrakuṣmāṇḍajapyebhyo gāyatrī tu viśiṣyate ||07"},{"id":"215.15","n":"०८","text":"न गायत्र्याः परञ्जप्यं न व्याहृतिसमं हुतं ।०८","tr":"na gāyatryāḥ parañjapyaṃ na vyāhṛtisamaṃ hutaṃ |08"},{"id":"215.16","n":"०८","text":"गायत्र्याः पादमप्यर्धमृगर्धमृचमेव वा ॥०८","tr":"gāyatryāḥ pādamapyardhamṛgardhamṛcameva vā ||08"},{"id":"215.17","n":"०९","text":"ब्रह्महत्या सुरापानं सुवर्णस्तेयमेव च ।०९","tr":"brahmahatyā surāpānaṃ suvarṇasteyameva ca |09"},{"id":"215.18","n":"०९","text":"गुरुदारागमश्चैव जप्येनैव पुनाति सा ॥०९","tr":"gurudārāgamaścaiva japyenaiva punāti sā ||09"},{"id":"215.19","n":"१०","text":"पापे कृते तिलैर्होमो गायत्रीजप ईरितः ।१०","tr":"pāpe kṛte tilairhomo gāyatrījapa īritaḥ |10"},{"id":"215.20","n":"१०","text":"जप्त्वा सहस्रं गायत्र्या उपवासी स पापहा(१) ॥१०","tr":"japtvā sahasraṃ gāyatryā upavāsī sa pāpahā(1) ||10"},{"id":"215.21","n":"११","text":"गोघ्नः पितृघ्नो मातृघ्नो ब्रह्महा गुरुतल्पगः ।११","tr":"goghnaḥ pitṛghno mātṛghno brahmahā gurutalpagaḥ |11"},{"id":"215.22","n":"११","text":"ब्रह्मघ्नः स्वर्णहारी च सुरापो लक्षजप्यतः ॥११","tr":"brahmaghnaḥ svarṇahārī ca surāpo lakṣajapyataḥ ||11"},{"id":"215.23","n":"१२","text":"शुध्यते वाथ वा स्नात्वा शतमन्तर्जले जपेत् ।१२","tr":"śudhyate vātha vā snātvā śatamantarjale japet |12"},{"id":"215.24","n":"१२","text":"अपः शतेन पीत्वा तु गायत्र्याः पापहा भवेत् ॥१२","tr":"apaḥ śatena pītvā tu gāyatryāḥ pāpahā bhavet ||12"},{"id":"215.25","n":"१३","text":"शतं जप्ता तु गायत्री पापोपशमनी स्मृता ।१३","tr":"śataṃ japtā tu gāyatrī pāpopaśamanī smṛtā |13"},{"id":"215.26","n":"१३","text":"सहस्रं शप्ता सा देवी उपपातकनाशिनी ॥१३","tr":"sahasraṃ śaptā sā devī upapātakanāśinī ||13"},{"id":"215.27","n":"१४","text":"अभीष्टदा कोटिजप्या देवत्वं राजतामियात् ।१४","tr":"abhīṣṭadā koṭijapyā devatvaṃ rājatāmiyāt |14"},{"id":"215.28","n":"१४","text":"ओङ्कारं पूर्वमुच्चार्य भूर्भुवः स्वस्तथैव च ॥१४","tr":"oṅkāraṃ pūrvamuccārya bhūrbhuvaḥ svastathaiva ca ||14"},{"id":"215.29","n":"१५","text":"गायत्री प्रणवश्चान्ते जपे चैवमुदाहृतं ।१५","tr":"gāyatrī praṇavaścānte jape caivamudāhṛtaṃ |15"},{"id":"215.30","n":"१५","text":"विश्वामित्र ऋषिच्छन्दो गायत्रं सविता तथा ॥१५","tr":"viśvāmitra ṛṣicchando gāyatraṃ savitā tathā ||15"},{"id":"215.31","n":"१६","text":"देवतोपनये जप्ये विनियोगो हुते तथा ।१६","tr":"devatopanaye japye viniyogo hute tathā |16"},{"id":"215.32","n":"१६","text":"अग्निर्वायू रविर्विद्युत्यमो जलपतिर्गुरुः ॥१६","tr":"agnirvāyū ravirvidyutyamo jalapatirguruḥ ||16"},{"id":"215.33","n":"१७","text":"पर्जन्य इन्द्रो गन्धर्वः पूषा च तदनन्तरं ।१७","tr":"parjanya indro gandharvaḥ pūṣā ca tadanantaraṃ |17"},{"id":"215.34","n":"१७","text":"मित्रोऽथ वरुणस्त्वष्टा वसवो मरुतः शशी ॥१७","tr":"mitro'tha varuṇastvaṣṭā vasavo marutaḥ śaśī ||17"},{"id":"215.35","n":"१८","text":"अङ्गिरा विश्वनासत्यौ कस्तथा सर्वदेवताः ।१८","tr":"aṅgirā viśvanāsatyau kastathā sarvadevatāḥ |18"},{"id":"215.36","n":"१८","text":"रुद्रो ब्रह्मा च विष्णुश्च क्रमशोऽक्षरदेवताः ॥१८","tr":"rudro brahmā ca viṣṇuśca kramaśo'kṣaradevatāḥ ||18"},{"id":"215.37","n":"१९","text":"गयत्र्या जपकाले तु कथिताः पापनाशनाः ।१९","tr":"gayatryā japakāle tu kathitāḥ pāpanāśanāḥ |19"},{"id":"215.38","n":"१९","text":"पादाङ्गुष्ठौ च गुल्फौ च नलकौ जानुनी तथा ॥१९","tr":"pādāṅguṣṭhau ca gulphau ca nalakau jānunī tathā ||19"},{"id":"215.39","n":"२०","text":"जङ्घे शिश्रश्च वृषणौ कटिर्नाभिस्तथोदरं ।२०","tr":"jaṅghe śiśraśca vṛṣaṇau kaṭirnābhistathodaraṃ |20"},{"id":"215.40","n":"२०","text":"- - - -- - - -- - - -- - - -- - - - -- - - - -\nटिप्पणी\n१ उपपातकपापहेति ग.. , घ.. , ङ.. च\n- - - -- - - -- - - -- - - -- - - - -- - - - -\nस्तनौ च हृदयं ग्रीवा मुखन्तालु च नासिके ॥२०","tr":"- - - -- - - -- - - -- - - -- - - - -- - - - -\nṭippaṇī\n1 upapātakapāpaheti ga.. , gha.. , ṅa.. ca\n- - - -- - - -- - - -- - - -- - - - -- - - - -\nstanau ca hṛdayaṃ grīvā mukhantālu ca nāsike ||20"},{"id":"215.41","n":"२१","text":"चक्षुषी च भ्रुवोर्मध्यं ललाटं पूर्वमाननं ।२१","tr":"cakṣuṣī ca bhruvormadhyaṃ lalāṭaṃ pūrvamānanaṃ |21"},{"id":"215.42","n":"२१","text":"दक्षिणोत्तरपार्श्वे द्वे शिर आस्यमनुक्रमात् ॥२१","tr":"dakṣiṇottarapārśve dve śira āsyamanukramāt ||21"},{"id":"215.43","n":"२२","text":"पीतः श्यामश्च कपिलो मरकतोऽग्निसन्निभः ।२२","tr":"pītaḥ śyāmaśca kapilo marakato'gnisannibhaḥ |22"},{"id":"215.44","n":"२२","text":"रुक्मविद्युद्धूम्रकृष्णरक्तगौरेन्द्रनीलभाः ॥२२","tr":"rukmavidyuddhūmrakṛṣṇaraktagaurendranīlabhāḥ ||22"},{"id":"215.45","n":"२३","text":"स्फाटिकस्वर्णपाण्ड्वाभाः पद्मरागोऽखिलद्युतिः(१) ।२३","tr":"sphāṭikasvarṇapāṇḍvābhāḥ padmarāgo'khiladyutiḥ(1) |23"},{"id":"215.46","n":"२३","text":"हेमधूम्ररक्तनीलरक्तकृष्णसुवर्णभाः ॥२३","tr":"hemadhūmraraktanīlaraktakṛṣṇasuvarṇabhāḥ ||23"},{"id":"215.47","n":"२४","text":"शुक्लकृष्णपालाशाभा(२) गायत्र्या वर्णकाः क्रमात् ।२४","tr":"śuklakṛṣṇapālāśābhā(2) gāyatryā varṇakāḥ kramāt |24"},{"id":"215.48","n":"२४","text":"ध्यानकाले पापहरा हुतैषा सर्वकामदा ॥२४","tr":"dhyānakāle pāpaharā hutaiṣā sarvakāmadā ||24"},{"id":"215.49","n":"२५","text":"गायत्र्या तु तिलैर्होमः सर्वपापप्रणाशनः ।२५","tr":"gāyatryā tu tilairhomaḥ sarvapāpapraṇāśanaḥ |25"},{"id":"215.50","n":"२५","text":"शान्तिकामो यवैः कुर्यादायुष्कामो घृतेन च ॥२५","tr":"śāntikāmo yavaiḥ kuryādāyuṣkāmo ghṛtena ca ||25"},{"id":"215.51","n":"२६","text":"सिद्धार्थकैः कर्मसिद्ध्यै पयसा ब्रह्मवर्चसे ।२६","tr":"siddhārthakaiḥ karmasiddhyai payasā brahmavarcase |26"},{"id":"215.52","n":"२६","text":"पुत्रकामस्तथा दध्ना धान्यकामस्तु शालिभिः ॥२६","tr":"putrakāmastathā dadhnā dhānyakāmastu śālibhiḥ ||26"},{"id":"215.53","n":"२७","text":"क्षीरवृक्षसमिद्धिस्तु ग्रहपीडोपशान्तये ।२७","tr":"kṣīravṛkṣasamiddhistu grahapīḍopaśāntaye |27"},{"id":"215.54","n":"२७","text":"धनकामस्तथा बिल्वैः श्रीकामः कमलैस्तथा ॥२७","tr":"dhanakāmastathā bilvaiḥ śrīkāmaḥ kamalaistathā ||27"},{"id":"215.55","n":"२८","text":"आरोग्यकामो दूर्वाभिर्गुरूत्पाते स एव हि ।२८","tr":"ārogyakāmo dūrvābhirgurūtpāte sa eva hi |28"},{"id":"215.56","n":"२८","text":"सौभाग्येच्छुर्गुग्गुलुना विद्यार्थी पायसेन च ॥२८","tr":"saubhāgyecchurguggulunā vidyārthī pāyasena ca ||28"},{"id":"215.57","n":"२९","text":"अयुतेनोक्तसिद्धिः स्याल्लक्षेण मनसेप्सितं ।२९","tr":"ayutenoktasiddhiḥ syāllakṣeṇa manasepsitaṃ |29"},{"id":"215.58","n":"२९","text":"कोट्या ब्रह्मबधान्मुक्तः कुलोद्धारी हरिर्भवेत् ॥२९","tr":"koṭyā brahmabadhānmuktaḥ kuloddhārī harirbhavet ||29"},{"id":"215.59","n":"३०","text":"ग्रहयज्ञमुखो वापि होमोऽयुतमुखोऽर्थकृत् ।३०","tr":"grahayajñamukho vāpi homo'yutamukho'rthakṛt |30"},{"id":"215.60","n":"३०","text":"- - - -- - - -- - - -- - - -- - - - -- - - - -\nटिप्पणी\n१ पद्मरागोऽमलद्युतिरिति ख.. , छ.. , ज.. , ट.. च\n२ शुक्लपद्मपलाशाभेति ङ.. , ञ.. च\n- - - -- - - -- - - -- - - -- - - - -- - - - -\nआवाहनञ्च गायत्र्यास्तत ओङ्कारमभ्यसेत् ॥३०","tr":"- - - -- - - -- - - -- - - -- - - - -- - - - -\nṭippaṇī\n1 padmarāgo'maladyutiriti kha.. , cha.. , ja.. , ṭa.. ca\n2 śuklapadmapalāśābheti ṅa.. , ña.. ca\n- - - -- - - -- - - -- - - -- - - - -- - - - -\nāvāhanañca gāyatryāstata oṅkāramabhyaset ||30"},{"id":"215.61","n":"३१","text":"स्मृत्वौङ्कारन्तु गायत्र्या निबध्नीयाच्छिखान्ततः ।३१","tr":"smṛtvauṅkārantu gāyatryā nibadhnīyācchikhāntataḥ |31"},{"id":"215.62","n":"३१","text":"पुनराचम्य हृडयं नाभिं स्कन्धौ च संस्पृशेत् ॥३१","tr":"punarācamya hṛḍayaṃ nābhiṃ skandhau ca saṃspṛśet ||31"},{"id":"215.63","n":"३२","text":"प्रणवस्य ऋषिर्ब्रह्मा गायत्रीच्छन्द एव च ।३२","tr":"praṇavasya ṛṣirbrahmā gāyatrīcchanda eva ca |32"},{"id":"215.64","n":"३२","text":"देवोऽग्निः परमात्मा स्याद्योगो वै सर्वकर्मसु ॥३२","tr":"devo'gniḥ paramātmā syādyogo vai sarvakarmasu ||32"},{"id":"215.65","n":"३३","text":"शुक्ला चाग्निमुखी देव्या कात्यायनसगोत्रजा ।३३","tr":"śuklā cāgnimukhī devyā kātyāyanasagotrajā |33"},{"id":"215.66","n":"३३","text":"त्रैलोक्यवरणा दिव्या पृथिव्याधारसंयुता ॥३३","tr":"trailokyavaraṇā divyā pṛthivyādhārasaṃyutā ||33"},{"id":"215.67","n":"३४","text":"अक्षरसूत्रधरा देवी पद्मासनगता शुभा ।३४","tr":"akṣarasūtradharā devī padmāsanagatā śubhā |34"},{"id":"215.68","n":"३४","text":"ओं तेजोऽसि महोऽसि बलमसि भ्राजोऽसि देवानान्धामनामासि ।\nविश्वमसि विश्वायुः सर्वमसि सर्वायुः ओं अभि भूः\nआगच्छ वरदे देवि जप्ये मे सन्निधौ भव ॥३४","tr":"oṃ tejo'si maho'si balamasi bhrājo'si devānāndhāmanāmāsi |\nviśvamasi viśvāyuḥ sarvamasi sarvāyuḥ oṃ abhi bhūḥ\nāgaccha varade devi japye me sannidhau bhava ||34"},{"id":"215.69","n":"३५","text":"व्याहृतीनान्तु सर्वासामृषिरेव प्रजापतिः ।३५","tr":"vyāhṛtīnāntu sarvāsāmṛṣireva prajāpatiḥ |35"},{"id":"215.70","n":"३५","text":"व्यस्ताश्चैव समस्ताश्च ब्राह्ममक्षरमोमिति ॥३५","tr":"vyastāścaiva samastāśca brāhmamakṣaramomiti ||35"},{"id":"215.71","n":"३६","text":"विश्वामित्रो यमदग्निर्भरद्वाजोऽथ गोतमः ।३६","tr":"viśvāmitro yamadagnirbharadvājo'tha gotamaḥ |36"},{"id":"215.72","n":"३६","text":"ऋषिरत्रिर्वशिष्ठश्च काश्यपश्च यथाक्रमं ॥३६","tr":"ṛṣiratrirvaśiṣṭhaśca kāśyapaśca yathākramaṃ ||36"},{"id":"215.73","n":"३७","text":"अग्निर्वायू रविश्चैव वाक्पतिर्वरुणस्तथा ।३७","tr":"agnirvāyū raviścaiva vākpatirvaruṇastathā |37"},{"id":"215.74","n":"३७","text":"इन्द्रो विष्णुर्व्याहृतीनां दैवतानि यथाक्रमं ॥३७","tr":"indro viṣṇurvyāhṛtīnāṃ daivatāni yathākramaṃ ||37"},{"id":"215.75","n":"३८","text":"गायत्र्यष्टिगनुष्टुप्च वृहती पङ्क्तिरेव च ।३८","tr":"gāyatryaṣṭiganuṣṭupca vṛhatī paṅktireva ca |38"},{"id":"215.76","n":"३८","text":"त्रिष्टुप्च जगती चेति छन्दांस्याहुरनुक्तामात् ॥३८","tr":"triṣṭupca jagatī ceti chandāṃsyāhuranuktāmāt ||38"},{"id":"215.77","n":"३९","text":"विनियोगे व्याहृतीनां प्राणायामे च होमके ।३९","tr":"viniyoge vyāhṛtīnāṃ prāṇāyāme ca homake |39"},{"id":"215.78","n":"३९","text":"आपोहिष्ठेत्यृचा चापान्द्रुपदादीति वा स्मृता(१) ॥३९","tr":"āpohiṣṭhetyṛcā cāpāndrupadādīti vā smṛtā(1) ||39"},{"id":"215.79","n":"४०","text":"- - - -- - - -- - - -- - - -- - - - -- - - - -\nटिप्पणी\n१ द्रुपदादीनि वाप्यृचा इति ङ.. , ज.. , ञ.. च\n- - - -- - - -- - - -- - - -- - - - -- - - - -\nतथा हिरण्यवर्णाभिः पावमानीभिरन्ततः ।४०","tr":"- - - -- - - -- - - -- - - -- - - - -- - - - -\nṭippaṇī\n1 drupadādīni vāpyṛcā iti ṅa.. , ja.. , ña.. ca\n- - - -- - - -- - - -- - - -- - - - -- - - - -\ntathā hiraṇyavarṇābhiḥ pāvamānībhirantataḥ |40"},{"id":"215.80","n":"४०","text":"विप्रुषोऽष्टौ क्षिपेदूर्ध्वमाजन्मकृतपापजित् ॥४०","tr":"vipruṣo'ṣṭau kṣipedūrdhvamājanmakṛtapāpajit ||40"},{"id":"215.81","n":"४१","text":"अन्तर्जले ऋतञ्चेति जपेत्त्रिरघमर्षणं ।४१","tr":"antarjale ṛtañceti japettriraghamarṣaṇaṃ |41"},{"id":"215.82","n":"४१","text":"आपोहिष्ठेत्यृचोऽस्याश्च सिन्धुद्वीप ऋषिः स्मृतः ॥४१","tr":"āpohiṣṭhetyṛco'syāśca sindhudvīpa ṛṣiḥ smṛtaḥ ||41"},{"id":"215.83","n":"४२","text":"ब्राह्मस्नानाय छन्दोऽस्य गायत्री देवता जलं ।४२","tr":"brāhmasnānāya chando'sya gāyatrī devatā jalaṃ |42"},{"id":"215.84","n":"४२","text":"मार्जने विनियोगस्य हयावभृथके क्रतोः ॥४२","tr":"mārjane viniyogasya hayāvabhṛthake kratoḥ ||42"},{"id":"215.85","n":"४३","text":"अघमर्षणसूक्तस्य ऋषिरेवाघमर्षणं ।४३","tr":"aghamarṣaṇasūktasya ṛṣirevāghamarṣaṇaṃ |43"},{"id":"215.86","n":"४३","text":"अनुष्टुप्च भवेच्छन्दो भाववृत्तस्तु दैवतं ॥४३","tr":"anuṣṭupca bhavecchando bhāvavṛttastu daivataṃ ||43"},{"id":"215.87","n":"४४","text":"आपोज्योरी रस इति गायत्र्यास्तु शिरः स्मृतं ।४४","tr":"āpojyorī rasa iti gāyatryāstu śiraḥ smṛtaṃ |44"},{"id":"215.88","n":"४४","text":"ऋषिः प्रजापतिस्तस्य छन्दोहीनं यजुर्यतः ॥४४","tr":"ṛṣiḥ prajāpatistasya chandohīnaṃ yajuryataḥ ||44"},{"id":"215.89","n":"४५","text":"ब्रह्माग्निवायुसूर्याश्च देवताः परिकीर्तिताः ।४५","tr":"brahmāgnivāyusūryāśca devatāḥ parikīrtitāḥ |45"},{"id":"215.90","n":"४५","text":"प्राणरोधात्तु वायुः स्याद्वायोरग्निश्च जायते ॥४५","tr":"prāṇarodhāttu vāyuḥ syādvāyoragniśca jāyate ||45"},{"id":"215.91","n":"४६","text":"अग्नेरापस्ततः शुद्धिस्ततश्चाचमनञ्चरेत् ।४६","tr":"agnerāpastataḥ śuddhistataścācamanañcaret |46"},{"id":"215.92","n":"४६","text":"अन्तश्चरति भूतेषु गुहायां विश्वमूर्तिषु ॥४६","tr":"antaścarati bhūteṣu guhāyāṃ viśvamūrtiṣu ||46"},{"id":"215.93","n":"४७","text":"तपोयज्ञवषट्कार आपो ज्योती रसोऽमृतं ।४७","tr":"tapoyajñavaṣaṭkāra āpo jyotī raso'mṛtaṃ |47"},{"id":"215.94","n":"४७","text":"उदुत्यं जातवेदसमृषिः प्रष्कन्न उच्यते ॥४७","tr":"udutyaṃ jātavedasamṛṣiḥ praṣkanna ucyate ||47"},{"id":"215.95","n":"४८","text":"गायत्रीच्छन्द आख्यातं सूर्यश्चैव तु दैवतम् ।४८","tr":"gāyatrīcchanda ākhyātaṃ sūryaścaiva tu daivatam |48"},{"id":"215.96","n":"४८","text":"अतिरात्रे नियोगः स्यादग्नीषोमो नियोगकः ॥४८","tr":"atirātre niyogaḥ syādagnīṣomo niyogakaḥ ||48"},{"id":"215.97","n":"४९","text":"चित्रं देवेति ऋचके ऋषिः कौत्स उदाहृतः ।४९","tr":"citraṃ deveti ṛcake ṛṣiḥ kautsa udāhṛtaḥ |49"},{"id":"215.98","n":"४९","text":"त्रिष्टुप्छन्दो दैवतञ्च सूर्योऽस्याः परिकीर्तितं ॥४९","tr":"triṣṭupchando daivatañca sūryo'syāḥ parikīrtitaṃ ||49"},{"id":"215.99","text":"इत्याग्नेये महापुराणे सन्ध्याविधिर्नाम पञ्चदशाधिकद्विशततमोऽध्यायः ॥","tr":"ityāgneye mahāpurāṇe sandhyāvidhirnāma pañcadaśādhikadviśatatamo'dhyāyaḥ ||"}]}