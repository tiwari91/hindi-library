{"book":"agni-purana","n":256,"title":"अध्याय २५६","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A8%E0%A5%AB%E0%A5%AC","items":[{"id":"256.1","n":"००१","text":"अग्निरुवाच\nविभागञ्चेत्पिता कुर्यादिच्छया विभजेत्सुतान् ।२५६.००१","tr":"agniruvāca\nvibhāgañcetpitā kuryādicchayā vibhajetsutān |256.001"},{"id":"256.2","n":"००१","text":"ज्येष्ठं वा श्रेष्ठभागेन सर्वे वा स्युः समांशिनः ॥२५६.००१","tr":"jyeṣṭhaṃ vā śreṣṭhabhāgena sarve vā syuḥ samāṃśinaḥ ||256.001"},{"id":"256.3","n":"००२","text":"यदि दद्यात्समानंशान् कार्याः पत्न्यः समांशिकाः ।२५६.००२","tr":"yadi dadyātsamānaṃśān kāryāḥ patnyaḥ samāṃśikāḥ |256.002"},{"id":"256.4","n":"००२","text":"न दत्तं स्त्रीधनं यासां भर्त्रा वा श्वशुरेन वा ॥२५६.००२","tr":"na dattaṃ strīdhanaṃ yāsāṃ bhartrā vā śvaśurena vā ||256.002"},{"id":"256.5","n":"००३","text":"शक्तस्थानीहमानस्य किञ्चिद्दत्वा पृथक्क्रिया ।२५६.००३","tr":"śaktasthānīhamānasya kiñciddatvā pṛthakkriyā |256.003"},{"id":"256.6","n":"००३","text":"न्यूनाधिकविभक्तानां धर्म्यश्च पितृना कृतः ॥२५६.००३","tr":"nyūnādhikavibhaktānāṃ dharmyaśca pitṛnā kṛtaḥ ||256.003"},{"id":"256.7","n":"००४","text":"विभजेयुः सुताः पित्रोरूर्ध्वमृक्थमृणं समम् ।२५६.००४","tr":"vibhajeyuḥ sutāḥ pitrorūrdhvamṛkthamṛṇaṃ samam |256.004"},{"id":"256.8","n":"००४","text":"मातुर्दुहितरः शेषमृणात्ताभ्य ऋतेऽन्नयः ॥२५६.००४","tr":"māturduhitaraḥ śeṣamṛṇāttābhya ṛte'nnayaḥ ||256.004"},{"id":"256.9","n":"००५","text":"पितृद्रव्याविनाशेन यदन्यत्स्वयमर्जयेत् ।२५६.००५","tr":"pitṛdravyāvināśena yadanyatsvayamarjayet |256.005"},{"id":"256.10","n":"००५","text":"मैत्रमौद्वाहिकञ्चैव दायादानान्न तद्भवेत् ॥२५६.००५","tr":"maitramaudvāhikañcaiva dāyādānānna tadbhavet ||256.005"},{"id":"256.11","n":"००६","text":"सामान्यार्थसमुत्थाने विभागस्तु समः स्मृतः ।२५६.००६","tr":"sāmānyārthasamutthāne vibhāgastu samaḥ smṛtaḥ |256.006"},{"id":"256.12","n":"००६","text":"अनेकपितृकाणान्तु पितृतो भागकल्पना ॥२५६.००६","tr":"anekapitṛkāṇāntu pitṛto bhāgakalpanā ||256.006"},{"id":"256.13","n":"००७","text":"भूर्यापिता महोपात्ता निबन्धो द्रव्यमेव वा ।२५६.००७","tr":"bhūryāpitā mahopāttā nibandho dravyameva vā |256.007"},{"id":"256.14","n":"००७","text":"तत्र स्यात्सदृशं स्वाम्यं पितुः पुत्रस्य चोभयोः ॥२५६.००७","tr":"tatra syātsadṛśaṃ svāmyaṃ pituḥ putrasya cobhayoḥ ||256.007"},{"id":"256.15","n":"००८","text":"विभक्तेषु सुतो जातः सवर्णायां विभागभाक् ।२५६.००८","tr":"vibhakteṣu suto jātaḥ savarṇāyāṃ vibhāgabhāk |256.008"},{"id":"256.16","n":"००८","text":"दृश्याद्वा तद्विभागः स्यादायव्ययविशोधितात् ॥२५६.००८","tr":"dṛśyādvā tadvibhāgaḥ syādāyavyayaviśodhitāt ||256.008"},{"id":"256.17","n":"००९","text":"क्रमादभ्यागतं द्रव्यं हृतमभ्युद्धरेच्च यः ।२५६.००९","tr":"kramādabhyāgataṃ dravyaṃ hṛtamabhyuddharecca yaḥ |256.009"},{"id":"256.18","n":"००९","text":"दायादेभ्यो न तद्दद्याद्विद्यया लब्धमेव च ॥२५६.००९","tr":"dāyādebhyo na taddadyādvidyayā labdhameva ca ||256.009"},{"id":"256.19","n":"०१०","text":"पितृभ्यां यस्य यद्दत्तं तत्तस्यैव धनं भवेत् ।२५६.०१०","tr":"pitṛbhyāṃ yasya yaddattaṃ tattasyaiva dhanaṃ bhavet |256.010"},{"id":"256.20","n":"०१०","text":"पितुरूर्ध्वं विभजतां माताप्यंशं समं हरेत् ॥२५६.०१०","tr":"piturūrdhvaṃ vibhajatāṃ mātāpyaṃśaṃ samaṃ haret ||256.010"},{"id":"256.21","n":"०११","text":"असंस्कृतास्तु संस्कार्या भ्रातृभिः पूर्वसंस्कृतैः ।२५६.०११","tr":"asaṃskṛtāstu saṃskāryā bhrātṛbhiḥ pūrvasaṃskṛtaiḥ |256.011"},{"id":"256.22","n":"०११","text":"भागिन्यश्च निजादंशाद्दत्वांशन्तु तुरीयकं ॥२५६.०११","tr":"bhāginyaśca nijādaṃśāddatvāṃśantu turīyakaṃ ||256.011"},{"id":"256.23","n":"०१२","text":"चतुःस्त्रिद्व्येकभागाः स्युर्वर्णशो ब्राह्मणात्मजाः ।२५६.०१२","tr":"catuḥstridvyekabhāgāḥ syurvarṇaśo brāhmaṇātmajāḥ |256.012"},{"id":"256.24","n":"०१२","text":"क्षत्रजास्त्रिद्व्येकभागा विड्जास्तु द्व्येकभागिनः ॥२५६.०१२","tr":"kṣatrajāstridvyekabhāgā viḍjāstu dvyekabhāginaḥ ||256.012"},{"id":"256.25","n":"०१३","text":"अन्योन्यापहृतं द्रव्यं विभक्ते यत्तु दृश्यते ।२५६.०१३","tr":"anyonyāpahṛtaṃ dravyaṃ vibhakte yattu dṛśyate |256.013"},{"id":"256.26","n":"०१३","text":"तत्पुनस्ते समैरंशैर्विभजेरन्निति स्थितिः ॥२५६.०१३","tr":"tatpunaste samairaṃśairvibhajeranniti sthitiḥ ||256.013"},{"id":"256.27","n":"०१४","text":"अपुत्रेण परक्षेत्रे नियोगोत्पादितः सुतः ।२५६.०१४","tr":"aputreṇa parakṣetre niyogotpāditaḥ sutaḥ |256.014"},{"id":"256.28","n":"०१४","text":"उभयोरप्यसावृक्थी पिण्डदाता च धर्मतः ॥२५६.०१४","tr":"ubhayorapyasāvṛkthī piṇḍadātā ca dharmataḥ ||256.014"},{"id":"256.29","n":"०१५","text":"औरसो धर्मपत्नीजस्तत्समः पुत्रिकासुतः ।२५६.०१५","tr":"auraso dharmapatnījastatsamaḥ putrikāsutaḥ |256.015"},{"id":"256.30","n":"०१५","text":"क्षेत्रजः क्षेत्रजातस्तु सगोत्रेणेतरेण वा ॥२५६.०१५","tr":"kṣetrajaḥ kṣetrajātastu sagotreṇetareṇa vā ||256.015"},{"id":"256.31","n":"०१६","text":"गृहे प्रच्छन्न उत्पन्नो गूढजस्तु सुतः स्मृतः ।२५६.०१६","tr":"gṛhe pracchanna utpanno gūḍhajastu sutaḥ smṛtaḥ |256.016"},{"id":"256.32","n":"०१६","text":"कानीनः कन्यकाजातो मातामहसुतो मतः ॥२५६.०१६","tr":"kānīnaḥ kanyakājāto mātāmahasuto mataḥ ||256.016"},{"id":"256.33","n":"०१७","text":"क्षतायामक्षतायां वा जातः पौनर्भवः सुतः ।२५६.०१७","tr":"kṣatāyāmakṣatāyāṃ vā jātaḥ paunarbhavaḥ sutaḥ |256.017"},{"id":"256.34","n":"०१७","text":"दद्यान्माता पिता वा यं स पुत्री दत्तको भवेत् ॥२५६.०१७","tr":"dadyānmātā pitā vā yaṃ sa putrī dattako bhavet ||256.017"},{"id":"256.35","n":"०१८","text":"क्रीतश्च ताभ्यां विक्रीतः कृत्रिमः स्यात्स्व्यं कृतः ।२५६.०१८","tr":"krītaśca tābhyāṃ vikrītaḥ kṛtrimaḥ syātsvyaṃ kṛtaḥ |256.018"},{"id":"256.36","n":"०१८","text":"दत्तात्मा तु स्वयं दत्तो गर्भे वित्तः सहोढजः ॥२५६.०१८","tr":"dattātmā tu svayaṃ datto garbhe vittaḥ sahoḍhajaḥ ||256.018"},{"id":"256.37","n":"०१९","text":"उत्सृष्टो गृह्यते यस्तु सोपविद्धो भवेत्सुतः ।२५६.०१९","tr":"utsṛṣṭo gṛhyate yastu sopaviddho bhavetsutaḥ |256.019"},{"id":"256.38","n":"०१९","text":"पिण्डदोऽंशहरश्चैषां पूर्वाभावे परः परः ॥२५६.०१९","tr":"piṇḍado'ṃśaharaścaiṣāṃ pūrvābhāve paraḥ paraḥ ||256.019"},{"id":"256.39","n":"०२०","text":"सजातीयेष्वयं प्रोक्तस्तनयेषु मया विधिः ।२५६.०२०","tr":"sajātīyeṣvayaṃ proktastanayeṣu mayā vidhiḥ |256.020"},{"id":"256.40","n":"०२०","text":"जातोऽपि दास्यां शूद्रस्य कामतोऽंशहरो भवेत् ॥२५६.०२०","tr":"jāto'pi dāsyāṃ śūdrasya kāmato'ṃśaharo bhavet ||256.020"},{"id":"256.41","n":"०२१","text":"मृते पितरि कुर्युस्तं भ्रातरस्त्वर्धभागिकं ।२५६.०२१","tr":"mṛte pitari kuryustaṃ bhrātarastvardhabhāgikaṃ |256.021"},{"id":"256.42","n":"०२१","text":"अभ्रातृको हरेत्सर्वं दुहितॄणां सुतादृते ॥२५६.०२१","tr":"abhrātṛko haretsarvaṃ duhitṝṇāṃ sutādṛte ||256.021"},{"id":"256.43","n":"०२२","text":"पत्नी दुहितरश्चैव पितरो भ्रातरस्तथा ।२५६.०२२","tr":"patnī duhitaraścaiva pitaro bhrātarastathā |256.022"},{"id":"256.44","n":"०२२","text":"तत्सुतो गोत्रजो बन्धुः शिष्यः सब्रह्मचारिणः ॥२५६.०२२","tr":"tatsuto gotrajo bandhuḥ śiṣyaḥ sabrahmacāriṇaḥ ||256.022"},{"id":"256.45","n":"०२३","text":"एषामभावे पूवस्य धनभागुत्तरोत्तरः ।२५६.०२३","tr":"eṣāmabhāve pūvasya dhanabhāguttarottaraḥ |256.023"},{"id":"256.46","n":"०२३","text":"स्वर्यात्स्य ह्यपुत्रस्य सर्ववर्णेष्वयं विधिः ॥२५६.०२३","tr":"svaryātsya hyaputrasya sarvavarṇeṣvayaṃ vidhiḥ ||256.023"},{"id":"256.47","n":"०२४","text":"वानप्रस्थयतिब्रह्मचारिणामृक्थभागिनः ।२५६.०२४","tr":"vānaprasthayatibrahmacāriṇāmṛkthabhāginaḥ |256.024"},{"id":"256.48","n":"०२४","text":"क्रमेणाचार्यसच्छिष्यधर्मभ्रात्रेकतीर्थिनः ॥२५६.०२४","tr":"krameṇācāryasacchiṣyadharmabhrātrekatīrthinaḥ ||256.024"},{"id":"256.49","n":"०२५","text":"संसृष्टिनस्तु संसृष्टी सोदरस्य तु सोदरः ।२५६.०२५","tr":"saṃsṛṣṭinastu saṃsṛṣṭī sodarasya tu sodaraḥ |256.025"},{"id":"256.50","n":"०२५","text":"दद्याच्चापहेरेच्चांशं जातस्य च मृतस्य च ॥२५६.०२५","tr":"dadyāccāpahereccāṃśaṃ jātasya ca mṛtasya ca ||256.025"},{"id":"256.51","n":"०२६","text":"अन्योदर्यस्तु संसृष्टी नान्योदर्यधनं हरेत् ।२५६.०२६","tr":"anyodaryastu saṃsṛṣṭī nānyodaryadhanaṃ haret |256.026"},{"id":"256.52","n":"०२६","text":"असंसृष्त्यपि चादद्यात्सोदर्यो नान्यमानृजः ॥२५६.०२६","tr":"asaṃsṛṣtyapi cādadyātsodaryo nānyamānṛjaḥ ||256.026"},{"id":"256.53","n":"०२७","text":"पतितस्तत्सुतः क्लीवः पङ्गुरुन्मत्तको जडः ।२५६.०२७","tr":"patitastatsutaḥ klīvaḥ paṅgurunmattako jaḍaḥ |256.027"},{"id":"256.54","n":"०२७","text":"अन्धोऽचिकित्स्यरोगाद्या भर्तव्यास्तु निरंशकाः ॥२५६.०२७","tr":"andho'cikitsyarogādyā bhartavyāstu niraṃśakāḥ ||256.027"},{"id":"256.55","n":"०२८","text":"औरसाः क्षेत्रजास्त्वेषां निर्दोषा भागहारिणः ।२५६.०२८","tr":"aurasāḥ kṣetrajāstveṣāṃ nirdoṣā bhāgahāriṇaḥ |256.028"},{"id":"256.56","n":"०२८","text":"सुताश्चैषां प्रभर्तव्या यावद्वै भर्तृसात्कृताः ॥२५६.०२८","tr":"sutāścaiṣāṃ prabhartavyā yāvadvai bhartṛsātkṛtāḥ ||256.028"},{"id":"256.57","n":"०२९","text":"अपुत्रा योषितश्चैषां भर्तव्याः साधुवृत्तयः ।२५६.०२९","tr":"aputrā yoṣitaścaiṣāṃ bhartavyāḥ sādhuvṛttayaḥ |256.029"},{"id":"256.58","n":"०२९","text":"निर्वास्या व्यभिचारिण्यः प्रतिकूलास्तथैव च ॥२५६.०२९","tr":"nirvāsyā vyabhicāriṇyaḥ pratikūlāstathaiva ca ||256.029"},{"id":"256.59","n":"०३०","text":"पितृमातृपतिभ्रातृदत्तमध्यग्न्युपागतं ।२५६.०३०","tr":"pitṛmātṛpatibhrātṛdattamadhyagnyupāgataṃ |256.030"},{"id":"256.60","n":"०३०","text":"आधिवेदनिकुञ्चैव स्त्रीधनं परिकीर्तितं ॥२५६.०३०","tr":"ādhivedanikuñcaiva strīdhanaṃ parikīrtitaṃ ||256.030"},{"id":"256.61","n":"०३१","text":"बन्धुदत्तं तथा शुल्कमन्वाधेयकमेव च ।२५६.०३१","tr":"bandhudattaṃ tathā śulkamanvādheyakameva ca |256.031"},{"id":"256.62","n":"०३१","text":"अप्रजायामतीतायां बान्धवास्तदवाप्नुयुः ॥२५६.०३१","tr":"aprajāyāmatītāyāṃ bāndhavāstadavāpnuyuḥ ||256.031"},{"id":"256.63","n":"०३२","text":"अप्रजास्त्रीधनं भ्रत्तुर्ब्राह्म्यादिषु चतुर्ष्वपि ।२५६.०३२","tr":"aprajāstrīdhanaṃ bhratturbrāhmyādiṣu caturṣvapi |256.032"},{"id":"256.64","n":"०३२","text":"दुहितृणां प्रसूता चेच्छ्रेषे तु पितृगामि तत् ॥२५६.०३२","tr":"duhitṛṇāṃ prasūtā cecchreṣe tu pitṛgāmi tat ||256.032"},{"id":"256.65","n":"०३३","text":"दत्वा कन्यां हरन् दण्ड्यो व्ययं दद्याच्च सोदयम् ।२५६.०३३","tr":"datvā kanyāṃ haran daṇḍyo vyayaṃ dadyācca sodayam |256.033"},{"id":"256.66","n":"०३३","text":"मृतायां दत्तमादद्यात्परिशोध्योभयव्ययम् ॥२५६.०३३","tr":"mṛtāyāṃ dattamādadyātpariśodhyobhayavyayam ||256.033"},{"id":"256.67","n":"०३४","text":"दुर्भिक्षे धर्मकार्ये च व्याधौ संप्रतिरोधके ।२५६.०३४","tr":"durbhikṣe dharmakārye ca vyādhau saṃpratirodhake |256.034"},{"id":"256.68","n":"०३४","text":"गृहीतं स्त्रीधनं भर्ता न स्त्रिये दातुमर्हति ॥२५६.०३४","tr":"gṛhītaṃ strīdhanaṃ bhartā na striye dātumarhati ||256.034"},{"id":"256.69","n":"०३५","text":"अधिवित्तस्त्रियै दद्यादधिवेदनिकं समम् ।२५६.०३५","tr":"adhivittastriyai dadyādadhivedanikaṃ samam |256.035"},{"id":"256.70","n":"०३५","text":"न दत्तं स्रीधनं यस्यै दत्ते त्वर्धं प्रकीर्तितम् ॥२५६.०३५","tr":"na dattaṃ srīdhanaṃ yasyai datte tvardhaṃ prakīrtitam ||256.035"},{"id":"256.71","n":"०३६","text":"विभागनिह्नवे ज्ञातिबन्धुसाक्ष्यभिलेखितैः ।२५६.०३६","tr":"vibhāganihnave jñātibandhusākṣyabhilekhitaiḥ |256.036"},{"id":"256.72","n":"०३६","text":"विभागभावना ज्ञेया गृहक्षेत्रैश्च यौतिकैः ॥२५६.०३६","tr":"vibhāgabhāvanā jñeyā gṛhakṣetraiśca yautikaiḥ ||256.036"},{"id":"256.73","text":"इत्याग्नेये महापुराणे दायविभागो नाम पञ्चपञ्चाशदधिकद्विशततमोऽध्यायः ॥","tr":"ityāgneye mahāpurāṇe dāyavibhāgo nāma pañcapañcāśadadhikadviśatatamo'dhyāyaḥ ||"}]}