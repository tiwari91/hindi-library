{"book":"agni-purana","n":129,"title":"अध्याय १२९","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%A8%E0%A5%AF","items":[{"id":"129.1","n":"००१","speaker":"ईश्वर उवाच","text":"अर्घमानं प्रवक्ष्यामि उल्कापातोऽथ भूश्चला ।१२९.००१","tr":"arghamānaṃ pravakṣyāmi ulkāpāto'tha bhūścalā |129.001"},{"id":"129.2","n":"००१","text":"निर्घातो ग्रहणं वेशो दिशां दाहो भवेद्यदा ॥१२९.००१","tr":"nirghāto grahaṇaṃ veśo diśāṃ dāho bhavedyadā ||129.001"},{"id":"129.3","n":"००२","text":"लक्षयेन्मासि मास्येवं यद्येते स्युश्च चैत्रके ।१२९.००२","tr":"lakṣayenmāsi māsyevaṃ yadyete syuśca caitrake |129.002"},{"id":"129.4","n":"००२","text":"अलङ्कारादि सङ्गृह्य षड्भिर्मासैश्चतुर्गुणम् ॥१२९.००२","tr":"alaṅkārādi saṅgṛhya ṣaḍbhirmāsaiścaturguṇam ||129.002"},{"id":"129.5","n":"००३","text":"वैशाखे चाष्टमे मासि षड्गुणं सर्वसङ्ग्रहं ।१२९.००३","tr":"vaiśākhe cāṣṭame māsi ṣaḍguṇaṃ sarvasaṅgrahaṃ |129.003"},{"id":"129.6","n":"००३","text":"ज्यैष्ठे मासि तथाषाढे यवगोधूमधान्यकैः ॥१२९.००३","tr":"jyaiṣṭhe māsi tathāṣāḍhe yavagodhūmadhānyakaiḥ ||129.003"},{"id":"129.7","n":"००४","text":"श्रावणे घृततैलाद्यैराश्विने वस्त्रधान्यकैः ।१२९.००४","tr":"śrāvaṇe ghṛtatailādyairāśvine vastradhānyakaiḥ |129.004"},{"id":"129.8","n":"००४","text":"कार्त्तिके धान्यकैः क्रीतैर्मासे स्यान्मार्गशीर्षके ॥१२९.००४","tr":"kārttike dhānyakaiḥ krītairmāse syānmārgaśīrṣake ||129.004"},{"id":"129.9","n":"००५","text":"पुष्ये कुङ्कुमगन्धाद्यैर् लाभो धान्यैश्च माघके ।१२९.००५","tr":"puṣye kuṅkumagandhādyair lābho dhānyaiśca māghake |129.005"},{"id":"129.10","n":"००५","text":"गन्धाद्यैः फाल्गुने क्रीतैरर्घकाण्डमुदाहृतम् ॥१२९.००५","tr":"gandhādyaiḥ phālgune krītairarghakāṇḍamudāhṛtam ||129.005"},{"id":"129.11","text":"इत्याग्नेये महापुराणे अर्घकाण्डं नाम ऊनत्रिंशदधिकशततमोऽध्यायः ॥","tr":"ityāgneye mahāpurāṇe arghakāṇḍaṃ nāma ūnatriṃśadadhikaśatatamo'dhyāyaḥ ||"}]}