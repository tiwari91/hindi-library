{"book":"agni-purana","n":173,"title":"अध्याय १७३","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%AD%E0%A5%A9","items":[{"id":"173.1","n":"०१","text":"अग्निरुवाच\nप्रायश्चित्तं ब्रह्मणोक्तं वक्ष्ये पापोपशान्तिदं ।०१","tr":"agniruvāca\nprāyaścittaṃ brahmaṇoktaṃ vakṣye pāpopaśāntidaṃ |01"},{"id":"173.2","n":"०१","text":"स्यात्प्राणवियोगफलो व्यापारो हननं स्मृतं ॥०१","tr":"syātprāṇaviyogaphalo vyāpāro hananaṃ smṛtaṃ ||01"},{"id":"173.3","n":"०२","text":"रागाद्द्वेषात्प्रमादाच्च स्वतः परत एव वा ।०२","tr":"rāgāddveṣātpramādācca svataḥ parata eva vā |02"},{"id":"173.4","n":"०२","text":"ब्राह्मणं घातयेद्यस्तु स भवेद्ब्रह्मघातकः ॥०२","tr":"brāhmaṇaṃ ghātayedyastu sa bhavedbrahmaghātakaḥ ||02"},{"id":"173.5","n":"०३","text":"बहूनामेककार्याणां सर्वेषां शस्त्रधारिणां ।०३","tr":"bahūnāmekakāryāṇāṃ sarveṣāṃ śastradhāriṇāṃ |03"},{"id":"173.6","n":"०३","text":"यद्येको घातकस्तत्र सर्वे ते घातकाः स्मृताः ॥०३","tr":"yadyeko ghātakastatra sarve te ghātakāḥ smṛtāḥ ||03"},{"id":"173.7","n":"०४","text":"आक्रोशितस्ताडितो वा धनैव्वा परिपीडितः ।०४","tr":"ākrośitastāḍito vā dhanaivvā paripīḍitaḥ |04"},{"id":"173.8","n":"०४","text":"टिप्पणी\n१ ततः कर्माणीति ख.. , ग.. , घ.. , छ.. च\nयमुद्दिश्य त्यजेत्प्राणांस्तमाहुर्ब्रह्मघातकं ॥०४","tr":"ṭippaṇī\n1 tataḥ karmāṇīti kha.. , ga.. , gha.. , cha.. ca\nyamuddiśya tyajetprāṇāṃstamāhurbrahmaghātakaṃ ||04"},{"id":"173.9","n":"०५","text":"औषधाद्युपकारे तु न पापं स्यात्कृते मृते ।०५","tr":"auṣadhādyupakāre tu na pāpaṃ syātkṛte mṛte |05"},{"id":"173.10","n":"०५","text":"पुत्रं शिष्यन्तथा भार्यां शासते न मृते ह्यघं ॥०५","tr":"putraṃ śiṣyantathā bhāryāṃ śāsate na mṛte hyaghaṃ ||05"},{"id":"173.11","n":"०६","text":"देशं कालञ्च यः शक्तिं पापञ्चावेक्ष्य यत्नतः ।०६","tr":"deśaṃ kālañca yaḥ śaktiṃ pāpañcāvekṣya yatnataḥ |06"},{"id":"173.12","n":"०६","text":"प्रायश्चित्तं प्रकल्प्यं स्याद्यत्र चोक्ता न निष्कृतिः(१) ॥०६","tr":"prāyaścittaṃ prakalpyaṃ syādyatra coktā na niṣkṛtiḥ(1) ||06"},{"id":"173.13","n":"०७","text":"गवार्थे ब्राह्मणार्थे वा सद्यः प्राणान् परित्यजेत् ।०७","tr":"gavārthe brāhmaṇārthe vā sadyaḥ prāṇān parityajet |07"},{"id":"173.14","n":"०७","text":"प्रास्येदात्मानमग्नौ वा मुच्यते ब्रह्महत्यया ॥०७","tr":"prāsyedātmānamagnau vā mucyate brahmahatyayā ||07"},{"id":"173.15","n":"०८","text":"शिरःकपाली ध्वजवान् भैक्षाशी कर्म वेदयन् ।०८","tr":"śiraḥkapālī dhvajavān bhaikṣāśī karma vedayan |08"},{"id":"173.16","n":"०८","text":"ब्रह्महा द्वादशाब्दानि मितभुक्शुद्धिमाप्नुयात् ॥०८","tr":"brahmahā dvādaśābdāni mitabhukśuddhimāpnuyāt ||08"},{"id":"173.17","n":"०९","text":"षड्भिर्वर्षैः शुद्धचारी ब्रह्महा पूयते नरः ।०९","tr":"ṣaḍbhirvarṣaiḥ śuddhacārī brahmahā pūyate naraḥ |09"},{"id":"173.18","n":"०९","text":"विहितं यदकामा मां कामात्तु द्विगुणं स्मृतं ॥०९","tr":"vihitaṃ yadakāmā māṃ kāmāttu dviguṇaṃ smṛtaṃ ||09"},{"id":"173.19","n":"१०","text":"प्रायश्चित्तं प्रवृत्तस्य वधे स्यात्तु(२) त्रिवार्षिकं ।१०","tr":"prāyaścittaṃ pravṛttasya vadhe syāttu(2) trivārṣikaṃ |10"},{"id":"173.20","n":"१०","text":"ब्रह्मघ्नि क्षत्रे द्विगुणं विट्च्छूद्रे द्विगुणं त्रिधा ॥१०","tr":"brahmaghni kṣatre dviguṇaṃ viṭcchūdre dviguṇaṃ tridhā ||10"},{"id":"173.21","n":"११","text":"अन्यत्र विप्रे सकलं पादोनं क्षत्रिये मतं ।११","tr":"anyatra vipre sakalaṃ pādonaṃ kṣatriye mataṃ |11"},{"id":"173.22","n":"११","text":"वैश्येऽर्धपादं क्षत्रे स्याद्वृद्धस्त्रीबालरोगिषु ॥११","tr":"vaiśye'rdhapādaṃ kṣatre syādvṛddhastrībālarogiṣu ||11"},{"id":"173.23","n":"१२","text":"तुरीयो ब्रह्महत्यायाः क्षत्रियस्य बधे स्मृतं ।१२","tr":"turīyo brahmahatyāyāḥ kṣatriyasya badhe smṛtaṃ |12"},{"id":"173.24","n":"१२","text":"वैश्येऽष्टमांशो वृत्तस्थे शूद्रे ज्ञेयस्तु षोडशः ॥१२","tr":"vaiśye'ṣṭamāṃśo vṛttasthe śūdre jñeyastu ṣoḍaśaḥ ||12"},{"id":"173.25","n":"१३","text":"अप्रदुष्टां स्त्रियं हत्वा शूद्रहत्याव्रतं चरेत् ।१३","tr":"apraduṣṭāṃ striyaṃ hatvā śūdrahatyāvrataṃ caret |13"},{"id":"173.26","n":"१३","text":"पञ्चगव्यं पिवेद्गोघ्नो मासमासीत संयतः ॥१३","tr":"pañcagavyaṃ pivedgoghno māsamāsīta saṃyataḥ ||13"},{"id":"173.27","n":"१४","text":"गोष्ठे शयो गोऽनुगामी गोप्रदानेन शुद्ध्यति ।१४","tr":"goṣṭhe śayo go'nugāmī gopradānena śuddhyati |14"},{"id":"173.28","n":"१४","text":"कृच्छ्रञ्चैवातिकृच्छ्रं वा पादह्रासो नृपादिषु ॥१४","tr":"kṛcchrañcaivātikṛcchraṃ vā pādahrāso nṛpādiṣu ||14"},{"id":"173.29","n":"१५","text":"अतिवृद्धामतिकृशामतिबालाञ्च रोगिणीं ।१५","tr":"ativṛddhāmatikṛśāmatibālāñca rogiṇīṃ |15"},{"id":"173.30","n":"१५","text":"टिप्पणी\n१ न संस्कृतिरिति छ..\n२ बधेऽस्य तु इति छ..\nहत्वा पूर्वविधानेन चरेदर्धव्रतं द्विजः ॥१५","tr":"ṭippaṇī\n1 na saṃskṛtiriti cha..\n2 badhe'sya tu iti cha..\nhatvā pūrvavidhānena caredardhavrataṃ dvijaḥ ||15"},{"id":"173.31","n":"१६","text":"ब्राह्मणान् भोजयेच्छक्त्या दद्याद्धेमतिलदिकं ।१६","tr":"brāhmaṇān bhojayecchaktyā dadyāddhematiladikaṃ |16"},{"id":"173.32","n":"१६","text":"मुष्टिचपेटकीलेन तथा शृङ्गादिमोटने ॥१६","tr":"muṣṭicapeṭakīlena tathā śṛṅgādimoṭane ||16"},{"id":"173.33","n":"१७","text":"लगुडादिप्रहारेण गोवधं तत्र निर्दिशेत् ।१७","tr":"laguḍādiprahāreṇa govadhaṃ tatra nirdiśet |17"},{"id":"173.34","n":"१७","text":"दमेन दामने चैव शकटादौ च योजने ॥१७","tr":"damena dāmane caiva śakaṭādau ca yojane ||17"},{"id":"173.35","n":"१८","text":"स्तम्भशृङ्खलपाशैर्वा मृते पादोनमाचरेत् ।१८","tr":"stambhaśṛṅkhalapāśairvā mṛte pādonamācaret |18"},{"id":"173.36","n":"१८","text":"काष्ठे शान्तपनं कुर्यात्प्राजापत्यन्तु लोष्ठके ॥१८","tr":"kāṣṭhe śāntapanaṃ kuryātprājāpatyantu loṣṭhake ||18"},{"id":"173.37","n":"१९","text":"तप्तकृच्छ्रन्तु पाषाणे शस्त्रे चाप्यतिकृच्छ्रकं ।१९","tr":"taptakṛcchrantu pāṣāṇe śastre cāpyatikṛcchrakaṃ |19"},{"id":"173.38","n":"१९","text":"मार्जारगोधानकुलमण्डूकश्वपतत्रिणः ॥१९","tr":"mārjāragodhānakulamaṇḍūkaśvapatatriṇaḥ ||19"},{"id":"173.39","n":"२०","text":"हत्वा त्र्यहं पिवेत्क्षीरं कृच्छ्रं चान्द्रायणं चरेत् ।२०","tr":"hatvā tryahaṃ pivetkṣīraṃ kṛcchraṃ cāndrāyaṇaṃ caret |20"},{"id":"173.40","n":"२०","text":"व्रतं रहस्ये रहसि प्रकाशेऽपि प्रकाशकं ॥२०","tr":"vrataṃ rahasye rahasi prakāśe'pi prakāśakaṃ ||20"},{"id":"173.41","n":"२१","text":"प्राणायामशतं कार्यं सर्वपापापनुत्तये ।२१","tr":"prāṇāyāmaśataṃ kāryaṃ sarvapāpāpanuttaye |21"},{"id":"173.42","n":"२१","text":"पानकं द्राक्षमधुकं खार्जरन्तालमैक्षवं ॥२१","tr":"pānakaṃ drākṣamadhukaṃ khārjarantālamaikṣavaṃ ||21"},{"id":"173.43","n":"२२","text":"मध्वीकं टङ्कमाध्वीकं मैरेयं(?) नारिकेलजं ।२२","tr":"madhvīkaṃ ṭaṅkamādhvīkaṃ maireyaṃ(?) nārikelajaṃ |22"},{"id":"173.44","n":"२२","text":"न मद्यान्यपि मद्यानि पैष्टी मुख्या सुरा स्मृता ॥२२","tr":"na madyānyapi madyāni paiṣṭī mukhyā surā smṛtā ||22"},{"id":"173.45","n":"२३","text":"त्रैवर्णस्य निषिद्धानि पीत्वा तप्त्वाप्यपः शुचिः ।२३","tr":"traivarṇasya niṣiddhāni pītvā taptvāpyapaḥ śuciḥ |23"},{"id":"173.46","n":"२३","text":"कणान् वा भक्षयेदब्दं पिण्याकं वा सकृन्निशि ॥२३","tr":"kaṇān vā bhakṣayedabdaṃ piṇyākaṃ vā sakṛnniśi ||23"},{"id":"173.47","n":"२४","text":"सुरापाणापनुत्यर्थं बालवामा जटी ध्वजी ।२४","tr":"surāpāṇāpanutyarthaṃ bālavāmā jaṭī dhvajī |24"},{"id":"173.48","n":"२४","text":"अज्ञानात्प्राश्य विण्मूत्रं सुरासंस्पृष्टमेव च ॥२४","tr":"ajñānātprāśya viṇmūtraṃ surāsaṃspṛṣṭameva ca ||24"},{"id":"173.49","n":"२५","text":"पुनः संस्कारमर्हन्ति त्रयो वर्णा द्विजातयः ।२५","tr":"punaḥ saṃskāramarhanti trayo varṇā dvijātayaḥ |25"},{"id":"173.50","n":"२५","text":"मद्यमाण्डस्थिता आपः पीत्वा सप्तदिनं व्रती ॥२५","tr":"madyamāṇḍasthitā āpaḥ pītvā saptadinaṃ vratī ||25"},{"id":"173.51","n":"२६","text":"चाण्डालस्य तु पानीयं पीत्वा स्यात्षड्दिनं व्रती ।२६","tr":"cāṇḍālasya tu pānīyaṃ pītvā syātṣaḍdinaṃ vratī |26"},{"id":"173.52","n":"२६","text":"चण्डालकूपभाण्डेषु पीत्वा शान्तपनं चरेत् ॥२६","tr":"caṇḍālakūpabhāṇḍeṣu pītvā śāntapanaṃ caret ||26"},{"id":"173.53","n":"२७","text":"पञ्चगव्यं त्रिरान्ते पीत्वा चान्त्यजलं द्विजः ।२७","tr":"pañcagavyaṃ trirānte pītvā cāntyajalaṃ dvijaḥ |27"},{"id":"173.54","n":"२७","text":"मत्स्यकण्टकशम्बूकशङ्खशुक्तिकपर्दकान् ॥२७","tr":"matsyakaṇṭakaśambūkaśaṅkhaśuktikapardakān ||27"},{"id":"173.55","n":"२८","text":"पीत्वा नवोदकं चैव पञ्चगव्येन शुद्ध्यति ।२८","tr":"pītvā navodakaṃ caiva pañcagavyena śuddhyati |28"},{"id":"173.56","n":"२८","text":"शवकूपोदकं पीत्वा त्रिरात्रेण विशुद्ध्यति ॥२८","tr":"śavakūpodakaṃ pītvā trirātreṇa viśuddhyati ||28"},{"id":"173.57","n":"२९","text":"अन्त्यावसायिनामन्नं भुक्त्वा चान्द्रायणं चरेत् ।२९","tr":"antyāvasāyināmannaṃ bhuktvā cāndrāyaṇaṃ caret |29"},{"id":"173.58","n":"२९","text":"आपत्काले शूद्रगृहे मनस्तापेन शुद्ध्यति ॥२९","tr":"āpatkāle śūdragṛhe manastāpena śuddhyati ||29"},{"id":"173.59","n":"३०","text":"शूद्रभाजनभुक्विप्रः पञ्चगव्यादुपोषितः ।३०","tr":"śūdrabhājanabhukvipraḥ pañcagavyādupoṣitaḥ |30"},{"id":"173.60","n":"३०","text":"कन्दुपक्वं स्नेहपक्वं स्नेहं च दधिशक्तवः ॥३०","tr":"kandupakvaṃ snehapakvaṃ snehaṃ ca dadhiśaktavaḥ ||30"},{"id":"173.61","n":"३१","text":"शूद्रादनिन्द्यान्येतानि गुडक्षीररसादिकं ।३१","tr":"śūdrādanindyānyetāni guḍakṣīrarasādikaṃ |31"},{"id":"173.62","n":"३१","text":"अस्नातभुक्चोपवासी दिनान्ते तु जपाच्छुचिः ॥३१","tr":"asnātabhukcopavāsī dinānte tu japācchuciḥ ||31"},{"id":"173.63","n":"३२","text":"मूत्रोच्चार्यशुचिर्भुक्त्वा त्रिरात्रेण विशुद्ध्यति ।३२","tr":"mūtroccāryaśucirbhuktvā trirātreṇa viśuddhyati |32"},{"id":"173.64","n":"३२","text":"केशकीटावपन्नं च पादस्पृष्टञ्च कामतः ॥३२","tr":"keśakīṭāvapannaṃ ca pādaspṛṣṭañca kāmataḥ ||32"},{"id":"173.65","n":"३३","text":"भ्रूणघ्नावेक्षित्तं चैव सस्पृष्टं वाप्युदक्यया ।३३","tr":"bhrūṇaghnāvekṣittaṃ caiva saspṛṣṭaṃ vāpyudakyayā |33"},{"id":"173.66","n":"३३","text":"काकाद्यैरवलीढं च शुनासंस्पृष्टमेव च ॥३३","tr":"kākādyairavalīḍhaṃ ca śunāsaṃspṛṣṭameva ca ||33"},{"id":"173.67","n":"३४","text":"गवाद्यैरन्नमाघ्रातं भुक्त्वा त्र्यहमुपावसेत् ।३४","tr":"gavādyairannamāghrātaṃ bhuktvā tryahamupāvaset |34"},{"id":"173.68","n":"३४","text":"रेतोविण्मूत्रभक्षी तु प्राजापत्यं समाचरेत् ॥३४","tr":"retoviṇmūtrabhakṣī tu prājāpatyaṃ samācaret ||34"},{"id":"173.69","n":"३५","text":"चान्द्रायण नवश्राद्धे पराको मासिके मतः ।३५","tr":"cāndrāyaṇa navaśrāddhe parāko māsike mataḥ |35"},{"id":"173.70","n":"३५","text":"पक्षत्रयेऽतिकृच्छ्रं स्यात्षण्मासे कृच्छ्रमेव च ॥३५","tr":"pakṣatraye'tikṛcchraṃ syātṣaṇmāse kṛcchrameva ca ||35"},{"id":"173.71","n":"३६","text":"आब्दिके पादकृच्छ्रं स्यादेकाहः पुनराव्दिके ।३६","tr":"ābdike pādakṛcchraṃ syādekāhaḥ punarāvdike |36"},{"id":"173.72","n":"३६","text":"पूर्वेद्युर्वार्षिकं श्राद्धं परेद्युः पुनराव्दिकं ॥३६","tr":"pūrvedyurvārṣikaṃ śrāddhaṃ paredyuḥ punarāvdikaṃ ||36"},{"id":"173.73","n":"३७","text":"निषिद्धभक्षणे भुक्ते प्रायश्चित्तमुपोषणं ।३७","tr":"niṣiddhabhakṣaṇe bhukte prāyaścittamupoṣaṇaṃ |37"},{"id":"173.74","n":"३७","text":"भूस्तृणं लशुनं भुक्त्वा(१) शिशुकं कृच्छ्रमाचरेत्(२) ॥३७","tr":"bhūstṛṇaṃ laśunaṃ bhuktvā(1) śiśukaṃ kṛcchramācaret(2) ||37"},{"id":"173.75","n":"३८","text":"टिप्पणी\n१ लशुनं गृञ्जनं भुक्त्वेति ङ..\n२ शिशुकृच्छ्रं समाचरेदिति ख..\nअभोज्यानान्तु भुक्त्वान्नं स्त्रीशूद्रोच्छिष्टमेव च ।३८","tr":"ṭippaṇī\n1 laśunaṃ gṛñjanaṃ bhuktveti ṅa..\n2 śiśukṛcchraṃ samācarediti kha..\nabhojyānāntu bhuktvānnaṃ strīśūdrocchiṣṭameva ca |38"},{"id":"173.76","n":"३८","text":"जग्ध्वा मांसमभक्ष्यञ्च सप्तरात्रं पयः पिवेत् ॥३८","tr":"jagdhvā māṃsamabhakṣyañca saptarātraṃ payaḥ pivet ||38"},{"id":"173.77","n":"३९","text":"मधु मांसञ्च योऽश्नीयाच्छावं सूतकमेव वा ।३९","tr":"madhu māṃsañca yo'śnīyācchāvaṃ sūtakameva vā |39"},{"id":"173.78","n":"३९","text":"प्राजापत्यं चरेत्कृच्छ्रं ब्रह्मचारी यतिर्व्रती ॥३९","tr":"prājāpatyaṃ caretkṛcchraṃ brahmacārī yatirvratī ||39"},{"id":"173.79","n":"४०","text":"अन्ययेन परस्वापहरणं स्तेयमुच्यते ।४०","tr":"anyayena parasvāpaharaṇaṃ steyamucyate |40"},{"id":"173.80","n":"४०","text":"मुसलेन हतो राज्ञा स्वर्णस्तेयी विशुद्ध्यति ॥४०","tr":"musalena hato rājñā svarṇasteyī viśuddhyati ||40"},{"id":"173.81","n":"४१","text":"अधःशायी जटाधारी पर्णमूलफलाशनः ।४१","tr":"adhaḥśāyī jaṭādhārī parṇamūlaphalāśanaḥ |41"},{"id":"173.82","n":"४१","text":"एककालं समश्नानो द्वादशाब्दे विशुद्ध्यति ॥४१","tr":"ekakālaṃ samaśnāno dvādaśābde viśuddhyati ||41"},{"id":"173.83","n":"४२","text":"रुक्मस्तेयी सुरापश्च ब्रह्महा गुरुतल्पगः ।४२","tr":"rukmasteyī surāpaśca brahmahā gurutalpagaḥ |42"},{"id":"173.84","n":"४२","text":"स्तेयं कृत्वा सुरां पीत्वा कृच्छ्रञ्चाब्दं चरेन्नरः ॥४२","tr":"steyaṃ kṛtvā surāṃ pītvā kṛcchrañcābdaṃ carennaraḥ ||42"},{"id":"173.85","n":"४३","text":"मणिमुक्ताप्रवालानां ताम्रस्य रजतस्य च ।४३","tr":"maṇimuktāpravālānāṃ tāmrasya rajatasya ca |43"},{"id":"173.86","n":"४३","text":"अयस्कांस्योपलानाञ्च द्वादशाहं कणान्नभुक् ॥४३","tr":"ayaskāṃsyopalānāñca dvādaśāhaṃ kaṇānnabhuk ||43"},{"id":"173.87","n":"४४","text":"मनुष्याणान्तु हरणे स्त्रीणां क्षेत्रगृहस्य च ।४४","tr":"manuṣyāṇāntu haraṇe strīṇāṃ kṣetragṛhasya ca |44"},{"id":"173.88","n":"४४","text":"वापीकूपतडागानां शुद्धिश्चान्द्रायणं स्मृतं ॥४४","tr":"vāpīkūpataḍāgānāṃ śuddhiścāndrāyaṇaṃ smṛtaṃ ||44"},{"id":"173.89","n":"४५","text":"भक्ष्यभोज्यापहरणे यानशय्यासनस्य च ।४५","tr":"bhakṣyabhojyāpaharaṇe yānaśayyāsanasya ca |45"},{"id":"173.90","n":"४५","text":"पुष्पमूलफलानाञ्च पञ्चगव्यं विशोधनं ॥४५","tr":"puṣpamūlaphalānāñca pañcagavyaṃ viśodhanaṃ ||45"},{"id":"173.91","n":"४७","text":"तृणकाष्ठद्रुमाणाञ्च शुष्कान्नस्य गुडस्य च ।४७","tr":"tṛṇakāṣṭhadrumāṇāñca śuṣkānnasya guḍasya ca |47"},{"id":"173.92","n":"४७","text":"चेलचर्मामिषाणाञ्च त्रिरात्रं स्यादभोजनं ॥४७","tr":"celacarmāmiṣāṇāñca trirātraṃ syādabhojanaṃ ||47"},{"id":"173.93","n":"४८","text":"पितुः पत्नीञ्च भगिनीमाचार्यतनयान्तथा ।४८","tr":"pituḥ patnīñca bhaginīmācāryatanayāntathā |48"},{"id":"173.94","n":"४८","text":"आचार्याणीं सुतां स्वाञ्च गच्छंश्च गुरुतल्पगः ॥४८","tr":"ācāryāṇīṃ sutāṃ svāñca gacchaṃśca gurutalpagaḥ ||48"},{"id":"173.95","n":"४९","text":"गुरुतल्पेऽभिभाष्यैनस्तप्ते पच्यादयोमये ।४९","tr":"gurutalpe'bhibhāṣyainastapte pacyādayomaye |49"},{"id":"173.96","n":"४९","text":"शूमीं ज्वलन्तीञ्चाश्लिष्य मृतुना स विशुद्ध्यति ॥४९","tr":"śūmīṃ jvalantīñcāśliṣya mṛtunā sa viśuddhyati ||49"},{"id":"173.97","n":"५०","text":"चान्द्रायणान् वा त्रीन्मासानभ्यस्य गुरुतल्पगः ।५०","tr":"cāndrāyaṇān vā trīnmāsānabhyasya gurutalpagaḥ |50"},{"id":"173.98","n":"५०","text":"एवमेव विधिं कुर्याद्योषित्सु पतितास्वपि ॥५०","tr":"evameva vidhiṃ kuryādyoṣitsu patitāsvapi ||50"},{"id":"173.99","n":"५१","text":"यत्पुंसः परदारेषु तच्चैनां कारयेद्व्रतं ।५१","tr":"yatpuṃsaḥ paradāreṣu taccaināṃ kārayedvrataṃ |51"},{"id":"173.100","n":"५१","text":"रेतः सिक्त्वा कुमारीषु चाण्डालीषु सुतासु च ॥५१","tr":"retaḥ siktvā kumārīṣu cāṇḍālīṣu sutāsu ca ||51"},{"id":"173.101","n":"५२","text":"सपिण्डापत्यदारेषु प्राणत्यागो विधीयते ।५२","tr":"sapiṇḍāpatyadāreṣu prāṇatyāgo vidhīyate |52"},{"id":"173.102","n":"५२","text":"यत्करोत्येकरात्रेण वृषलीसेवनं द्विजः ॥५२","tr":"yatkarotyekarātreṇa vṛṣalīsevanaṃ dvijaḥ ||52"},{"id":"173.103","n":"५३","text":"तद्भैक्ष्यभुग्(१) जपन्नित्यं त्रिभिर्वर्षैर्व्यपोहति ।५३","tr":"tadbhaikṣyabhug(1) japannityaṃ tribhirvarṣairvyapohati |53"},{"id":"173.104","n":"५३","text":"पितृव्यदारगमने भ्रातृभार्यागमे(२) तथा ॥५३","tr":"pitṛvyadāragamane bhrātṛbhāryāgame(2) tathā ||53"},{"id":"173.105","n":"५४","text":"चाण्डालीं पुक्कसीं वापि स्नुषाञ्च भगिनीं सखीं ।५४","tr":"cāṇḍālīṃ pukkasīṃ vāpi snuṣāñca bhaginīṃ sakhīṃ |54"},{"id":"173.106","n":"५४","text":"मातुः पितुः स्वसारञ्च निक्षिप्तां शरणागतां ॥५४","tr":"mātuḥ pituḥ svasārañca nikṣiptāṃ śaraṇāgatāṃ ||54"},{"id":"173.107","n":"५५","text":"मातुलानीं स्वसारञ्च सगोत्रामन्यमिच्छतीं ।५५","tr":"mātulānīṃ svasārañca sagotrāmanyamicchatīṃ |55"},{"id":"173.108","n":"५५","text":"शिष्यभार्यां गुरोर्भार्यां गत्वा चान्द्रायणञ्चरेत् ॥५५","tr":"śiṣyabhāryāṃ gurorbhāryāṃ gatvā cāndrāyaṇañcaret ||55"},{"id":"173.109","text":"टिप्पणी\n१ हविष्यभुगिति ग.. ,ट.. च\n२ मातृजायागमे इति ग.. , छ.. , ट.. च\nइत्याग्नेये महापुराणे प्रायश्चित्तानि नाम त्रिसप्तत्यधिकशततमोऽध्यायः ॥","tr":"ṭippaṇī\n1 haviṣyabhugiti ga.. ,ṭa.. ca\n2 mātṛjāyāgame iti ga.. , cha.. , ṭa.. ca\nityāgneye mahāpurāṇe prāyaścittāni nāma trisaptatyadhikaśatatamo'dhyāyaḥ ||"}]}