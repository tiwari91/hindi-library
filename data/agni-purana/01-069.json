{"book":"agni-purana","n":69,"title":"अध्याय ६९","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%AC%E0%A5%AF","items":[{"id":"69.1","n":"०१","text":"स्नानविधानं\nअग्निरुवाच\nब्रह्मन् शृणु प्रवक्षामि स्नपनोत्सवविस्तरं ।०१","tr":"snānavidhānaṃ\nagniruvāca\nbrahman śṛṇu pravakṣāmi snapanotsavavistaraṃ |01"},{"id":"69.2","n":"०१","text":"प्रासादस्याग्रतः कुम्भान्मण्डपे मण्डले न्यसेत् ॥०१","tr":"prāsādasyāgrataḥ kumbhānmaṇḍape maṇḍale nyaset ||01"},{"id":"69.3","n":"०२","text":"कुर्याद्ध्यानार्चनं होमं हरेरादौ च कर्मसु ।०२","tr":"kuryāddhyānārcanaṃ homaṃ harerādau ca karmasu |02"},{"id":"69.4","n":"०२","text":"सहस्रं वा शतं वापि होमयेत्पूर्णया सह ॥०२","tr":"sahasraṃ vā śataṃ vāpi homayetpūrṇayā saha ||02"},{"id":"69.5","n":"०३","text":"स्नानद्रव्याण्यथाहृत्य कलशांश्चापि विन्यसेत् ।०३","tr":"snānadravyāṇyathāhṛtya kalaśāṃścāpi vinyaset |03"},{"id":"69.6","n":"०३","text":"अधिवास्य सूत्रकण्ठान् धारयेन्मण्डले घटान् ॥०३","tr":"adhivāsya sūtrakaṇṭhān dhārayenmaṇḍale ghaṭān ||03"},{"id":"69.7","n":"०४","text":"चतुरस्रं पुरं कृत्वा रुद्रैस्तं प्रविभाज्येत्(१) ।०४","tr":"caturasraṃ puraṃ kṛtvā rudraistaṃ pravibhājyet(1) |04"},{"id":"69.8","n":"०४","text":"मध्येन तु चरुं स्थाप्य पार्श्वे पङ्क्तिं प्रमार्जयेत् ॥०४","tr":"madhyena tu caruṃ sthāpya pārśve paṅktiṃ pramārjayet ||04"},{"id":"69.9","n":"०५","text":"शालिचूर्णादिनापूर्य पूर्वादिनवकेषु च ।०५","tr":"śālicūrṇādināpūrya pūrvādinavakeṣu ca |05"},{"id":"69.10","n":"०५","text":"कुम्भमुद्रां ततो बध्वा घटं तत्रानयेद्बुधः ॥०५","tr":"kumbhamudrāṃ tato badhvā ghaṭaṃ tatrānayedbudhaḥ ||05"},{"id":"69.11","n":"०६","text":"पुण्डरीकाक्षमन्त्रेण दर्भांस्तांस्तु विसर्जयेत् ।०६","tr":"puṇḍarīkākṣamantreṇa darbhāṃstāṃstu visarjayet |06"},{"id":"69.12","n":"०६","text":"अद्भिः पूर्णं सर्वरत्नयुतं मध्ये न्यसेद्घटं ॥०६","tr":"adbhiḥ pūrṇaṃ sarvaratnayutaṃ madhye nyasedghaṭaṃ ||06"},{"id":"69.13","n":"०७","text":"यवव्रीहितिलांश्चैव नीवरान् श्यामकान् क्रमात् ।०७","tr":"yavavrīhitilāṃścaiva nīvarān śyāmakān kramāt |07"},{"id":"69.14","n":"०७","text":"कुलत्थमुद्गसिद्धार्थांस्तच्छुक्तानष्टदिक्षु च ॥०७","tr":"kulatthamudgasiddhārthāṃstacchuktānaṣṭadikṣu ca ||07"},{"id":"69.15","n":"०८","text":"ऐन्द्रे तु नवके मध्ये घृतपूर्णं घटं न्यसेत् ।०८","tr":"aindre tu navake madhye ghṛtapūrṇaṃ ghaṭaṃ nyaset |08"},{"id":"69.16","n":"०८","text":"पलाशाश्वत्थन्यग्रोधविल्वोदुम्बरशीर्षां ॥०८","tr":"palāśāśvatthanyagrodhavilvodumbaraśīrṣāṃ ||08"},{"id":"69.17","n":"०९","text":"जम्बूशमीकपित्थानां त्वक्कषायैर्घटाष्टकं ।०९","tr":"jambūśamīkapitthānāṃ tvakkaṣāyairghaṭāṣṭakaṃ |09"},{"id":"69.18","n":"०९","text":"आग्नेयनवके मध्ये मधुपूर्णं घटं न्यसेत् ॥०९","tr":"āgneyanavake madhye madhupūrṇaṃ ghaṭaṃ nyaset ||09"},{"id":"69.19","n":"१०","text":"गोशृङ्गनश्वगङ्गागजेन्द्रदशनेषु च ।१०","tr":"gośṛṅganaśvagaṅgāgajendradaśaneṣu ca |10"},{"id":"69.20","n":"१०","text":"तीर्थक्षेत्रखलेष्वष्टौ मृत्तिकाः स्युर्घटाष्टके ॥१०","tr":"tīrthakṣetrakhaleṣvaṣṭau mṛttikāḥ syurghaṭāṣṭake ||10"},{"id":"69.21","n":"११","text":"टिप्पणी\n१ प्रविभावयेदिति ख, ग, घ, चिह्नितपुस्तकत्रयपाठः\nयाम्ये तु नवके मध्ये तिलतैलघटं न्यसेत् ।११","tr":"ṭippaṇī\n1 pravibhāvayediti kha, ga, gha, cihnitapustakatrayapāṭhaḥ\nyāmye tu navake madhye tilatailaghaṭaṃ nyaset |11"},{"id":"69.22","n":"११","text":"नारङ्गमथ जम्बीरं खर्जूरं मृद्विकां क्रमात् ॥११","tr":"nāraṅgamatha jambīraṃ kharjūraṃ mṛdvikāṃ kramāt ||11"},{"id":"69.23","n":"१२","text":"नारिकेलं न्यसेत्पूगं दाडिमं पनसं फलं ।१२","tr":"nārikelaṃ nyasetpūgaṃ dāḍimaṃ panasaṃ phalaṃ |12"},{"id":"69.24","n":"१२","text":"नैर्ऋते नवके मध्ये क्षीरपूर्णं घटं न्यसेत् ॥१२","tr":"nairṛte navake madhye kṣīrapūrṇaṃ ghaṭaṃ nyaset ||12"},{"id":"69.25","n":"१३","text":"कुङ्कुमं नागपुष्पञ्च चम्पकं मालतीं क्रमात् ।१३","tr":"kuṅkumaṃ nāgapuṣpañca campakaṃ mālatīṃ kramāt |13"},{"id":"69.26","n":"१३","text":"मल्लिकामथ पुन्नागं करवीरं महोत्पलं ॥१३","tr":"mallikāmatha punnāgaṃ karavīraṃ mahotpalaṃ ||13"},{"id":"69.27","n":"१४","text":"पुष्पाणि चाप्ये नवके मध्ये वै नारिकेलकम् ।१४","tr":"puṣpāṇi cāpye navake madhye vai nārikelakam |14"},{"id":"69.28","n":"१४","text":"नादयेमथ सामुद्रं सारसं कौपमेव च ॥१४","tr":"nādayematha sāmudraṃ sārasaṃ kaupameva ca ||14"},{"id":"69.29","n":"१५","text":"वर्षजं हिमतोयञ्च नैर्झरङ्गाङ्गमेव च ।१५","tr":"varṣajaṃ himatoyañca nairjharaṅgāṅgameva ca |15"},{"id":"69.30","n":"१५","text":"उदकान्यथ वायव्ये नवके कदलीफलं ॥१५","tr":"udakānyatha vāyavye navake kadalīphalaṃ ||15"},{"id":"69.31","n":"१६","text":"सहदेवीं कुमारीं च सिंहीं व्याघ्रीं तथामृतां ।१६","tr":"sahadevīṃ kumārīṃ ca siṃhīṃ vyāghrīṃ tathāmṛtāṃ |16"},{"id":"69.32","n":"१६","text":"विष्णुपर्णीं शतशिवां वचां दिव्यौषधीर्न्यसेत् ॥१६","tr":"viṣṇuparṇīṃ śataśivāṃ vacāṃ divyauṣadhīrnyaset ||16"},{"id":"69.33","n":"१७","text":"पूर्वादौ सौम्यनवके मध्ये दधिघटं न्यसेत् ।१७","tr":"pūrvādau saumyanavake madhye dadhighaṭaṃ nyaset |17"},{"id":"69.34","n":"१७","text":"पत्रमेलां त्वचं कुष्ठं बालकं चन्दनद्वयं ॥१७","tr":"patramelāṃ tvacaṃ kuṣṭhaṃ bālakaṃ candanadvayaṃ ||17"},{"id":"69.35","n":"१८","text":"लतां कस्तूरिकां चैव कृष्णागुरुमनुक्रमात् ।१८","tr":"latāṃ kastūrikāṃ caiva kṛṣṇāgurumanukramāt |18"},{"id":"69.36","n":"१८","text":"सिद्धद्रव्याणि पूर्वादौ शान्तितोयमथैकतः ॥१८","tr":"siddhadravyāṇi pūrvādau śāntitoyamathaikataḥ ||18"},{"id":"69.37","n":"१९","text":"चन्द्रतारं क्रमाच्छुक्लं गिरिसारं त्रपु न्यसेत् ।१९","tr":"candratāraṃ kramācchuklaṃ girisāraṃ trapu nyaset |19"},{"id":"69.38","n":"१९","text":"घनसारं(१) तथा शीर्षं पूर्वादौ रत्नमेव च ॥१९","tr":"ghanasāraṃ(1) tathā śīrṣaṃ pūrvādau ratnameva ca ||19"},{"id":"69.39","n":"२०","text":"घृतेनाभ्यर्ज्य चोद्वर्त्य स्नपयेन्मूलमन्त्रतः ।२०","tr":"ghṛtenābhyarjya codvartya snapayenmūlamantrataḥ |20"},{"id":"69.40","n":"२०","text":"गन्धाद्यैः पूजयेद्वह्नौ हुत्वा पूर्णाहुतिं चरेत् ॥२०","tr":"gandhādyaiḥ pūjayedvahnau hutvā pūrṇāhutiṃ caret ||20"},{"id":"69.41","n":"२१","text":"बलिञ्च सर्वभूतेभ्यो भोजयेद्दत्तदक्षिणः ।२१","tr":"baliñca sarvabhūtebhyo bhojayeddattadakṣiṇaḥ |21"},{"id":"69.42","n":"२१","text":"देवैश्च मुनिभिर्भूपैर्देवं(२) संस्थाप्य चेश्वराः ॥२१","tr":"devaiśca munibhirbhūpairdevaṃ(2) saṃsthāpya ceśvarāḥ ||21"},{"id":"69.43","n":"२२","text":"टिप्पणी\n१ घोषसारमिति ख, ग, घ, चिह्नितपुस्तकत्रयपाठः\n२ देवैश्च मुनिभिः सार्धमिति ङ, चिह्नितपुस्तकपाठः । दिव्यैश्च बलिभिर्धूपैर्देवमिति घ, चिह्नितपुस्तकपाठः\nबभूवुः स्थापित्वेत्थं स्नपनोत्सवकं चरेत् ।२२","tr":"ṭippaṇī\n1 ghoṣasāramiti kha, ga, gha, cihnitapustakatrayapāṭhaḥ\n2 devaiśca munibhiḥ sārdhamiti ṅa, cihnitapustakapāṭhaḥ | divyaiśca balibhirdhūpairdevamiti gha, cihnitapustakapāṭhaḥ\nbabhūvuḥ sthāpitvetthaṃ snapanotsavakaṃ caret |22"},{"id":"69.44","n":"२२","text":"अष्टोत्तरसहस्रेण घटानां सर्वभाग्भवेत् ॥२२","tr":"aṣṭottarasahasreṇa ghaṭānāṃ sarvabhāgbhavet ||22"},{"id":"69.45","n":"२३","text":"यज्ञावभृथस्नानेन पूर्णसंस्नापनं कृतम् ।२३","tr":"yajñāvabhṛthasnānena pūrṇasaṃsnāpanaṃ kṛtam |23"},{"id":"69.46","n":"२३","text":"गौरीलक्ष्मीविवाहादि चोत्सवं स्नानपूर्वकम् ॥२३","tr":"gaurīlakṣmīvivāhādi cotsavaṃ snānapūrvakam ||23"},{"id":"69.47","text":"इत्यादिमहापुराणे आग्नेये यज्ञावभृतस्नानं नाम ऊनसप्ततितमोऽध्यायः ॥","tr":"ityādimahāpurāṇe āgneye yajñāvabhṛtasnānaṃ nāma ūnasaptatitamo'dhyāyaḥ ||"}]}