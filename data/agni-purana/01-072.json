{"book":"agni-purana","n":72,"title":"अध्याय ७२","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%AD%E0%A5%A8","items":[{"id":"72.1","text":"अथ द्विसप्ततितमोऽध्यायः\nस्नानविशेषादिकथनं","tr":"atha dvisaptatitamo'dhyāyaḥ\nsnānaviśeṣādikathanaṃ"},{"id":"72.2","n":"००१","speaker":"ईश्वर उवाच","text":"वक्ष्यामि स्कन्द नित्याद्यं स्नानं पूजां प्रतिष्ठया ।७२.००१","tr":"vakṣyāmi skanda nityādyaṃ snānaṃ pūjāṃ pratiṣṭhayā |72.001"},{"id":"72.3","n":"००१","text":"खात्वासिना समुद्धृत्य मृदमष्टाङ्गुलां ततः ॥७२.००१","tr":"khātvāsinā samuddhṛtya mṛdamaṣṭāṅgulāṃ tataḥ ||72.001"},{"id":"72.4","n":"००२","text":"सर्वात्मना समुद्धृत्य पुनस्तेनैव पूरयेत् ।७२.००२","tr":"sarvātmanā samuddhṛtya punastenaiva pūrayet |72.002"},{"id":"72.5","n":"००२","text":"शिरसा पयसस्तीरे निधायास्त्रेण शोधयेत्निजास्त्रेण विशोधयेदिति ख, ग, चिह्नितपुस्तकपाठः(२) ॥७२.००२","tr":"śirasā payasastīre nidhāyāstreṇa śodhayetnijāstreṇa viśodhayediti kha, ga, cihnitapustakapāṭhaḥ(2) ||72.002"},{"id":"72.6","n":"००३","text":"तृणानि शिखयोद्धृत्य वर्मणा विभजेत्त्रिधा ।७२.००३","tr":"tṛṇāni śikhayoddhṛtya varmaṇā vibhajettridhā |72.003"},{"id":"72.7","n":"००३","text":"एकया नाभिपादान्तं प्रक्षाल्य पुनरन्यया ॥७२.००३","tr":"ekayā nābhipādāntaṃ prakṣālya punaranyayā ||72.003"},{"id":"72.8","n":"००४","text":"अस्त्राभिलब्धयालभ्य दीप्तया सर्वविग्रहं ।७२.००४","tr":"astrābhilabdhayālabhya dīptayā sarvavigrahaṃ |72.004"},{"id":"72.9","n":"००४","text":"निरुद्धाक्षाणि पाणिभ्यां प्राणान् संयम्य वारिणि ॥७२.००४","tr":"niruddhākṣāṇi pāṇibhyāṃ prāṇān saṃyamya vāriṇi ||72.004"},{"id":"72.10","n":"००५","text":"निमज्यासीत हृद्यस्त्रं स्मरन् कालानलप्रभं ।७२.००५","tr":"nimajyāsīta hṛdyastraṃ smaran kālānalaprabhaṃ |72.005"},{"id":"72.11","n":"००५","text":"मलस्नानं विशोधयेत्थं समुत्थाय जलान्तरात् ॥७२.००५","tr":"malasnānaṃ viśodhayetthaṃ samutthāya jalāntarāt ||72.005"},{"id":"72.12","n":"००६","text":"अस्त्रसन्ध्यामुपास्याथ विधिस्नानं समाचरेत् ।७२.००६","tr":"astrasandhyāmupāsyātha vidhisnānaṃ samācaret |72.006"},{"id":"72.13","n":"००६","text":"सारस्वतादितीर्थानां एकमङ्कुशमुद्रया ॥७२.००६","tr":"sārasvatāditīrthānāṃ ekamaṅkuśamudrayā ||72.006"},{"id":"72.14","n":"००७","text":"हृदाकृष्य तथा स्नाप्य पुनः संहारमुद्रया ।७२.००७","tr":"hṛdākṛṣya tathā snāpya punaḥ saṃhāramudrayā |72.007"},{"id":"72.15","n":"००७","text":"शेषं मृद्भागमादाय प्रविश्य नाभिवारिणि ॥७२.००७","tr":"śeṣaṃ mṛdbhāgamādāya praviśya nābhivāriṇi ||72.007"},{"id":"72.16","n":"००८","text":"वामपाणितले कुर्याद्भागत्रयमुदङ्मुखः ।७२.००८","tr":"vāmapāṇitale kuryādbhāgatrayamudaṅmukhaḥ |72.008"},{"id":"72.17","n":"००८","text":"अङ्गैर्दक्षिणमेकाद्यं पूर्वमस्त्रेण सप्तधा ॥७२.००८","tr":"aṅgairdakṣiṇamekādyaṃ pūrvamastreṇa saptadhā ||72.008"},{"id":"72.18","n":"००९","text":"शिवेन दशधा सौम्यं जपेद्भागत्रयं क्रमात् ।७२.००९","tr":"śivena daśadhā saumyaṃ japedbhāgatrayaṃ kramāt |72.009"},{"id":"72.19","n":"००९","text":"सर्वदिक्षु क्षिपेत्पूर्वं हूं फडन्तशरात्मनाक्रूं फडन्तशरात्मना इति ख, ङ, चिह्नितपुस्तकद्वयपाठः(१) ॥७२.००९","tr":"sarvadikṣu kṣipetpūrvaṃ hūṃ phaḍantaśarātmanākrūṃ phaḍantaśarātmanā iti kha, ṅa, cihnitapustakadvayapāṭhaḥ(1) ||72.009"},{"id":"72.20","n":"०१०","text":"कुर्याच्छिवेन सौम्येन शिवतीर्थं भुजक्रमात् ।७२.०१०","tr":"kuryācchivena saumyena śivatīrthaṃ bhujakramāt |72.010"},{"id":"72.21","n":"०१०","text":"सर्वाङ्गमङ्गजप्तेन मूर्धादिचरणावधि ॥७२.०१०","tr":"sarvāṅgamaṅgajaptena mūrdhādicaraṇāvadhi ||72.010"},{"id":"72.22","n":"०११","text":"दक्षिणेन समालभ्य पठन्नङ्गचतुष्टयम् ।७२.०११","tr":"dakṣiṇena samālabhya paṭhannaṅgacatuṣṭayam |72.011"},{"id":"72.23","n":"०११","text":"पिधाय खानि सर्वाणि सम्मुखीकरणेन च ॥७२.०११","tr":"pidhāya khāni sarvāṇi sammukhīkaraṇena ca ||72.011"},{"id":"72.24","n":"०१२","text":"शिवं स्मरन्निमज्जेत हरिं गङ्गेति वा स्मरन् ।७२.०१२","tr":"śivaṃ smarannimajjeta hariṃ gaṅgeti vā smaran |72.012"},{"id":"72.25","n":"०१२","text":"वौषडन्तषडङ्गेन के कुर्यादभिषेचनं ॥७२.०१२","tr":"vauṣaḍantaṣaḍaṅgena ke kuryādabhiṣecanaṃ ||72.012"},{"id":"72.26","n":"०१३","text":"कुम्भमात्रेण रक्षार्थं पूर्वादौ निक्षिपेज्जलं ।७२.०१३","tr":"kumbhamātreṇa rakṣārthaṃ pūrvādau nikṣipejjalaṃ |72.013"},{"id":"72.27","n":"०१३","text":"स्नात्वा रजोपचारेण सुगन्धामलकादिभिः ॥७२.०१३","tr":"snātvā rajopacāreṇa sugandhāmalakādibhiḥ ||72.013"},{"id":"72.28","n":"०१४","text":"स्नात्वा चोत्तीर्य तत्तीर्थं संहारिण्योपसंहरेत् ।७२.०१४","tr":"snātvā cottīrya tattīrthaṃ saṃhāriṇyopasaṃharet |72.014"},{"id":"72.29","n":"०१४","text":"अथातो विधिशुद्धेन संहितामन्त्रितेन च ॥७२.०१४","tr":"athāto vidhiśuddhena saṃhitāmantritena ca ||72.014"},{"id":"72.30","n":"०१५","text":"निवृत्यादिविशुद्धेन भस्मना स्नानमाचरेत् ।७२.०१५","tr":"nivṛtyādiviśuddhena bhasmanā snānamācaret |72.015"},{"id":"72.31","n":"०१५","text":"शिरस्तः पादपर्यन्तं ह्रूं फडन्तशरात्मनाक्रूं फडन्तशरात्मना इति ख, ङ, चिह्नितपुस्तकद्वयपाठः(२) ॥७२.०१५","tr":"śirastaḥ pādaparyantaṃ hrūṃ phaḍantaśarātmanākrūṃ phaḍantaśarātmanā iti kha, ṅa, cihnitapustakadvayapāṭhaḥ(2) ||72.015"},{"id":"72.32","n":"०१६","text":"तेन कृत्वा मलस्नानं विधिस्नानं समाचरेत् ।७२.०१६","tr":"tena kṛtvā malasnānaṃ vidhisnānaṃ samācaret |72.016"},{"id":"72.33","n":"०१६","text":"ईशतत्पुरुषाघोरगुह्यकाजातसञ्चरैःगुह्यकाजातसंरवैरिति ख, चिह्नितपुस्तकपाठः(१) ॥७२.०१६","tr":"īśatatpuruṣāghoraguhyakājātasañcaraiḥguhyakājātasaṃravairiti kha, cihnitapustakapāṭhaḥ(1) ||72.016"},{"id":"72.34","n":"०१७","text":"क्रमेणोद्धूनयेन्मूर्ध्नि वक्त्रहृद्गुह्यविग्रहात् ।७२.०१७","tr":"krameṇoddhūnayenmūrdhni vaktrahṛdguhyavigrahāt |72.017"},{"id":"72.35","n":"०१७","text":"सन्ध्यात्रये निशीथे च वर्षापूर्वावसानयोः ॥७२.०१७","tr":"sandhyātraye niśīthe ca varṣāpūrvāvasānayoḥ ||72.017"},{"id":"72.36","n":"०१८","text":"सुप्त्वा भुक्त्वा पयः पीत्वा कृत्वा चावश्यकादिकम् ।७२.०१८","tr":"suptvā bhuktvā payaḥ pītvā kṛtvā cāvaśyakādikam |72.018"},{"id":"72.37","n":"०१८","text":"स्त्रीपुन्नपुंसकं शूद्रं विडालशशमूषिकम् ॥७२.०१८","tr":"strīpunnapuṃsakaṃ śūdraṃ viḍālaśaśamūṣikam ||72.018"},{"id":"72.38","n":"०१९","text":"स्नानमाग्नेयकं स्पृष्ट्वा शुचा वुद्धूलकं चरेत् ।७२.०१९","tr":"snānamāgneyakaṃ spṛṣṭvā śucā vuddhūlakaṃ caret |72.019"},{"id":"72.39","n":"०१९","text":"सूर्यांशुवर्षसम्पर्कैः प्राङ्मुखेनोर्ध्वबाहुना ॥७२.०१९","tr":"sūryāṃśuvarṣasamparkaiḥ prāṅmukhenordhvabāhunā ||72.019"},{"id":"72.40","n":"०२०","text":"माहेन्द्रं स्नानमैशेन कार्यं सप्तपदावधि ।७२.०२०","tr":"māhendraṃ snānamaiśena kāryaṃ saptapadāvadhi |72.020"},{"id":"72.41","n":"०२०","text":"गोसङ्घमध्यगः कुर्यात्खुरोत्खातकरेणुभिःतत्खरोत्खातरेणुभिरिति ख, चिह्नितपुस्तकपाठः(२) ॥७२.०२०","tr":"gosaṅghamadhyagaḥ kuryātkhurotkhātakareṇubhiḥtatkharotkhātareṇubhiriti kha, cihnitapustakapāṭhaḥ(2) ||72.020"},{"id":"72.42","n":"०२१","text":"पावनं नवमन्त्रेण स्नानन्तद्वर्मणाथवा ।७२.०२१","tr":"pāvanaṃ navamantreṇa snānantadvarmaṇāthavā |72.021"},{"id":"72.43","n":"०२१","text":"सद्योजातादिभिर्मन्त्रैरम्भोभिरभिषेचनम् ॥७२.०२१","tr":"sadyojātādibhirmantrairambhobhirabhiṣecanam ||72.021"},{"id":"72.44","n":"०२२","text":"मन्त्रस्नानं भवेदेवं वारुणाग्नेययोरपि ।७२.०२२","tr":"mantrasnānaṃ bhavedevaṃ vāruṇāgneyayorapi |72.022"},{"id":"72.45","n":"०२२","text":"मनसा मूलमन्त्रेण प्राणायामपुरःसरम् ॥७२.०२२","tr":"manasā mūlamantreṇa prāṇāyāmapuraḥsaram ||72.022"},{"id":"72.46","n":"०२३","text":"कुर्वीत मानसं स्नानं सर्वत्र विहितं च यत् ।७२.०२३","tr":"kurvīta mānasaṃ snānaṃ sarvatra vihitaṃ ca yat |72.023"},{"id":"72.47","n":"०२३","text":"वैष्णवादौ च तन्मन्त्रैरेवं स्नानादि कारयेत् ॥७२.०२३","tr":"vaiṣṇavādau ca tanmantrairevaṃ snānādi kārayet ||72.023"},{"id":"72.48","n":"०२४","text":"सन्ध्याविधिं प्रवक्ष्यामि मन्त्रैर्भिन्नैः समं गुह ।७२.०२४","tr":"sandhyāvidhiṃ pravakṣyāmi mantrairbhinnaiḥ samaṃ guha |72.024"},{"id":"72.49","n":"०२४","text":"संवीक्ष्य त्रिः पिवेदम्बु ब्रह्मतीर्थेन शङ्करैः ॥७२.०२४","tr":"saṃvīkṣya triḥ pivedambu brahmatīrthena śaṅkaraiḥ ||72.024"},{"id":"72.50","n":"०२५","text":"स्वधान्तैरात्मतत्त्वाद्यैस्ततः खानि स्पृशेद्धृदा ।७२.०२५","tr":"svadhāntairātmatattvādyaistataḥ khāni spṛśeddhṛdā |72.025"},{"id":"72.51","n":"०२५","text":"शकलीकरणं कृत्वा प्राणायामेन संस्थितः ॥७२.०२५","tr":"śakalīkaraṇaṃ kṛtvā prāṇāyāmena saṃsthitaḥ ||72.025"},{"id":"72.52","n":"०२६","text":"त्रिः समावर्तयेन्मन्त्री मनसा शिवसंहितां ।७२.०२६","tr":"triḥ samāvartayenmantrī manasā śivasaṃhitāṃ |72.026"},{"id":"72.53","n":"०२६","text":"आचम्य न्यस्य सन्ध्याञ्च ब्राह्मीं प्रातः स्मरेन्नरः\n३ स्मरेत्तत इति ग, चिह्नितपुस्तकपाठः(३) ॥७२.०२६","tr":"ācamya nyasya sandhyāñca brāhmīṃ prātaḥ smarennaraḥ\n3 smarettata iti ga, cihnitapustakapāṭhaḥ(3) ||72.026"},{"id":"72.54","n":"०२७","text":"हंसपद्मासनां रक्तां चतुर्वक्त्रां चतुर्भुजां ।७२.०२७","tr":"haṃsapadmāsanāṃ raktāṃ caturvaktrāṃ caturbhujāṃ |72.027"},{"id":"72.55","n":"०२७","text":"प्रस्कन्दमालिनीं दक्षे वामे दण्डकमण्डलुं ॥७२.०२७","tr":"praskandamālinīṃ dakṣe vāme daṇḍakamaṇḍaluṃ ||72.027"},{"id":"72.56","n":"०२८","text":"तार्क्ष्यपद्मासनां ध्यायेन्मध्याह्ने वैष्णवीं सितां ।७२.०२८","tr":"tārkṣyapadmāsanāṃ dhyāyenmadhyāhne vaiṣṇavīṃ sitāṃ |72.028"},{"id":"72.57","n":"०२८","text":"शङ्खचक्रधरां वामे दक्षिणे सगदाभयं ॥७२.०२८","tr":"śaṅkhacakradharāṃ vāme dakṣiṇe sagadābhayaṃ ||72.028"},{"id":"72.58","n":"०२९","text":"रौद्रीं ध्यायेद्वृषाब्जस्थां त्रिनेत्रां शशिभूषितां ।७२.०२९","tr":"raudrīṃ dhyāyedvṛṣābjasthāṃ trinetrāṃ śaśibhūṣitāṃ |72.029"},{"id":"72.59","n":"०२९","text":"त्रिशूलाक्षधरां दक्षे वामे साभयशक्तिकां ॥७२.०२९","tr":"triśūlākṣadharāṃ dakṣe vāme sābhayaśaktikāṃ ||72.029"},{"id":"72.60","n":"०३०","text":"साक्षिणीं कर्मणां सन्ध्यांदाक्षिण्यः कर्मणां सन्ध्या इति ख, चिह्नितपुस्तकपाठः(१) आत्मानं तत्प्रभानुगं ।७२.०३०","tr":"sākṣiṇīṃ karmaṇāṃ sandhyāṃdākṣiṇyaḥ karmaṇāṃ sandhyā iti kha, cihnitapustakapāṭhaḥ(1) ātmānaṃ tatprabhānugaṃ |72.030"},{"id":"72.61","n":"०३०","text":"चतुर्थी ज्ञानिनः सन्ध्या निशीथादौ विभाव्यते ॥७२.०३०","tr":"caturthī jñāninaḥ sandhyā niśīthādau vibhāvyate ||72.030"},{"id":"72.62","n":"०३१","text":"हृद्बिन्दुब्रह्मरन्ध्रेषु अरूपा तु परे स्थिता ।७२.०३१","tr":"hṛdbindubrahmarandhreṣu arūpā tu pare sthitā |72.031"},{"id":"72.63","n":"०३१","text":"शिवबोधपरा या तु सा सन्ध्या मरमोच्यते ॥७२.०३१","tr":"śivabodhaparā yā tu sā sandhyā maramocyate ||72.031"},{"id":"72.64","n":"०३२","text":"पैत्र्यं मूले प्रदेशिन्याः कनिष्ठायाः प्रजापतेः ।७२.०३२","tr":"paitryaṃ mūle pradeśinyāḥ kaniṣṭhāyāḥ prajāpateḥ |72.032"},{"id":"72.65","n":"०३२","text":"ब्राह्म्यमङ्गुष्ठमूलस्थं तीर्थं दैवं कराग्रतः ॥७२.०३२","tr":"brāhmyamaṅguṣṭhamūlasthaṃ tīrthaṃ daivaṃ karāgrataḥ ||72.032"},{"id":"72.66","n":"०३३","text":"सव्यपाणितले वह्नेस्तीर्थं सोमस्य वामतः ।७२.०३३","tr":"savyapāṇitale vahnestīrthaṃ somasya vāmataḥ |72.033"},{"id":"72.67","n":"०३३","text":"ऋषीणां तु समग्रेषु अङ्गुलीपर्वसन्धिषु ॥७२.०३३","tr":"ṛṣīṇāṃ tu samagreṣu aṅgulīparvasandhiṣu ||72.033"},{"id":"72.68","n":"०३४","text":"ततः शिवात्मकैर्मन्त्रैः कृत्वा तीर्थं शिवात्मकं ।७२.०३४","tr":"tataḥ śivātmakairmantraiḥ kṛtvā tīrthaṃ śivātmakaṃ |72.034"},{"id":"72.69","n":"०३४","text":"मार्जनं संहितामन्त्रैस्तत्तोयेन समाचरेत् ॥७२.०३४","tr":"mārjanaṃ saṃhitāmantraistattoyena samācaret ||72.034"},{"id":"72.70","n":"०३५","text":"वामपाणिपतत्तोययोजनं सव्यपाणिना ।७२.०३५","tr":"vāmapāṇipatattoyayojanaṃ savyapāṇinā |72.035"},{"id":"72.71","n":"०३५","text":"उत्तमाङ्गे क्रमान्मन्त्रैर्मार्जनं समुदाहृतं ॥७२.०३५","tr":"uttamāṅge kramānmantrairmārjanaṃ samudāhṛtaṃ ||72.035"},{"id":"72.72","n":"०३६","text":"नीत्वा तदुपनासाग्रं दक्षपाणिपुटस्थितं ।७२.०३६","tr":"nītvā tadupanāsāgraṃ dakṣapāṇipuṭasthitaṃ |72.036"},{"id":"72.73","n":"०३६","text":"बोधरूपं सितं तोयं वाममाकृष्य स्तम्भयेत्कुम्भयेदिति ख, ङ, चिह्नितपुस्तकपाठः(२) ॥७२.०३६","tr":"bodharūpaṃ sitaṃ toyaṃ vāmamākṛṣya stambhayetkumbhayediti kha, ṅa, cihnitapustakapāṭhaḥ(2) ||72.036"},{"id":"72.74","n":"०३७","text":"तत्पापं कज्जलाभासम्पिङ्गयारिच्य मुष्टिना ।७२.०३७","tr":"tatpāpaṃ kajjalābhāsampiṅgayāricya muṣṭinā |72.037"},{"id":"72.75","n":"०३७","text":"क्षिपेद्वज्रशिलायान्तु तद्भवेदघमर्षणं ॥७२.०३७","tr":"kṣipedvajraśilāyāntu tadbhavedaghamarṣaṇaṃ ||72.037"},{"id":"72.76","n":"०३८","text":"स्वाहान्तशिवमन्त्रेण कुशपुष्पाक्षतान्वितं ।७२.०३८","tr":"svāhāntaśivamantreṇa kuśapuṣpākṣatānvitaṃ |72.038"},{"id":"72.77","n":"०३८","text":"शिवायार्घ्याञ्जलिन्दत्वा गायत्रीं शक्तितो जपेत् ॥७२.०३८","tr":"śivāyārghyāñjalindatvā gāyatrīṃ śaktito japet ||72.038"},{"id":"72.78","n":"०३९","text":"तर्पणं सम्प्रवक्ष्यामि देवतीर्थेन मन्त्रकात् ।७२.०३९","tr":"tarpaṇaṃ sampravakṣyāmi devatīrthena mantrakāt |72.039"},{"id":"72.79","n":"०३९","text":"तर्पयेद्धौं शिवायेति स्वाहान्यान् स्वाहया युतान् ॥७२.०३९","tr":"tarpayeddhauṃ śivāyeti svāhānyān svāhayā yutān ||72.039"},{"id":"72.80","n":"०४०","text":"ह्रां हृद्याय ह्रीं शिरसे ह्रूं शिखायै ह्रैं कवचाय ।७२.०४०","tr":"hrāṃ hṛdyāya hrīṃ śirase hrūṃ śikhāyai hraiṃ kavacāya |72.040"},{"id":"72.81","n":"०४०","text":"अस्त्रायाष्टौ देवगणान् हृदादित्येभ्य एव च ॥७२.०४०","tr":"astrāyāṣṭau devagaṇān hṛdādityebhya eva ca ||72.040"},{"id":"72.82","n":"०४१","text":"हां वसुभ्योऽथ रुद्रेभ्यो विश्वेभ्यश्चैव मरुद्भ्यः ।७२.०४१","tr":"hāṃ vasubhyo'tha rudrebhyo viśvebhyaścaiva marudbhyaḥ |72.041"},{"id":"72.83","n":"०४१","text":"भृगुभ्यो हामङ्गिरोभ्य ऋषीन् कण्ठोपवीत्यथ ॥७२.०४१","tr":"bhṛgubhyo hāmaṅgirobhya ṛṣīn kaṇṭhopavītyatha ||72.041"},{"id":"72.84","n":"०४२","text":"अत्रेयेऽथ वसिष्ठाय नमश्चाथ पुलस्तयेमरीचये पुलस्त्यायेति ङ, चिह्नितपुस्तकपाठः(१) ।७२.०४२","tr":"atreye'tha vasiṣṭhāya namaścātha pulastayemarīcaye pulastyāyeti ṅa, cihnitapustakapāṭhaḥ(1) |72.042"},{"id":"72.85","n":"०४२","text":"कृतवे भारद्वजाय विश्वामित्राय वै नमः ॥७२.०४२","tr":"kṛtave bhāradvajāya viśvāmitrāya vai namaḥ ||72.042"},{"id":"72.86","n":"०४३","text":"प्रचेतसे मनुष्यांश्च सनकाय वषट्तथा ।७२.०४३","tr":"pracetase manuṣyāṃśca sanakāya vaṣaṭtathā |72.043"},{"id":"72.87","n":"०४३","text":"हां सनन्दाय वषट्सनातनाय वै वषट् ॥७२.०४३","tr":"hāṃ sanandāya vaṣaṭsanātanāya vai vaṣaṭ ||72.043"},{"id":"72.88","n":"०४४","text":"सनत्कुमाराय वषट्कपिलाय तथा वषट् ।७२.०४४","tr":"sanatkumārāya vaṣaṭkapilāya tathā vaṣaṭ |72.044"},{"id":"72.89","n":"०४४","text":"पञ्चशिखाय द्युभवे संलग्नकरमूलतः ॥७२.०४४","tr":"pañcaśikhāya dyubhave saṃlagnakaramūlataḥ ||72.044"},{"id":"72.90","n":"०४५","text":"सर्वेभ्यो भूतेभ्यो वौषट्भूतान् देवपितॄनथ ।७२.०४५","tr":"sarvebhyo bhūtebhyo vauṣaṭbhūtān devapitṝnatha |72.045"},{"id":"72.91","n":"०४५","text":"दक्षस्कन्धोपवीती च कुशमूलाग्रतस्तिलैः ॥७२.०४५","tr":"dakṣaskandhopavītī ca kuśamūlāgratastilaiḥ ||72.045"},{"id":"72.92","n":"०४६","text":"कव्यबालानलायाथ सोमाय च यमाय च ।७२.०४६","tr":"kavyabālānalāyātha somāya ca yamāya ca |72.046"},{"id":"72.93","n":"०४६","text":"अर्यम्णे चाग्निसोमाय वर्हिषद्भ्यः स्वधायुतान् ॥७२.०४६","tr":"aryamṇe cāgnisomāya varhiṣadbhyaḥ svadhāyutān ||72.046"},{"id":"72.94","n":"०४७","text":"आज्यपाय च सोमाय विशेषसुरवत्पितॄन् ।७२.०४७","tr":"ājyapāya ca somāya viśeṣasuravatpitṝn |72.047"},{"id":"72.95","n":"०४७","text":"ओं हां ईशानाय पित्रे स्वधा दद्यात्पितामहेहां ईशानाय पित्रे च सदाज्याय पितामहायेति ख, चिह्नितपुस्तकपाठः(२) ॥७२.०४७","tr":"oṃ hāṃ īśānāya pitre svadhā dadyātpitāmahehāṃ īśānāya pitre ca sadājyāya pitāmahāyeti kha, cihnitapustakapāṭhaḥ(2) ||72.047"},{"id":"72.96","n":"०४८","text":"शान्तप्रपितामहाय तथाप्रेतपितॄंस्तथा ।७२.०४८","tr":"śāntaprapitāmahāya tathāpretapitṝṃstathā |72.048"},{"id":"72.97","n":"०४८","text":"पितृभ्यः पितामहेभ्यः स्वधाथ प्रपितामहे ॥७२.०४८","tr":"pitṛbhyaḥ pitāmahebhyaḥ svadhātha prapitāmahe ||72.048"},{"id":"72.98","n":"०४९","text":"वृद्धप्रपितामहेभ्यो मातृभ्यश्च स्वधा तथा ।७२.०४९","tr":"vṛddhaprapitāmahebhyo mātṛbhyaśca svadhā tathā |72.049"},{"id":"72.99","n":"०४९","text":"हां मातामहेभ्यः स्वधा हां प्रमातामहेभ्यश्च ॥७२.०४९","tr":"hāṃ mātāmahebhyaḥ svadhā hāṃ pramātāmahebhyaśca ||72.049"},{"id":"72.100","n":"०५०","text":"वृद्धप्रमातामहेभ्यः सर्वेभ्यः पितृभ्यस्तथा ।७२.०५०","tr":"vṛddhapramātāmahebhyaḥ sarvebhyaḥ pitṛbhyastathā |72.050"},{"id":"72.101","n":"०५०","text":"सर्भेभ्यः स्वधा ज्ञातिभ्यः सर्वाचार्येभ्य एव च ।७२.०५०","tr":"sarbhebhyaḥ svadhā jñātibhyaḥ sarvācāryebhya eva ca |72.050"},{"id":"72.102","n":"०५०","text":"दिशां दिक्पतिसिद्धानां मातॄणां ग्रहरक्षसां ॥७२.०५०","tr":"diśāṃ dikpatisiddhānāṃ mātṝṇāṃ graharakṣasāṃ ||72.050"},{"id":"72.103","text":"इत्यादिमहापुराणे आग्नेये स्नानादिविधिर्नाम द्विसप्ततितमोऽध्यायः ॥","tr":"ityādimahāpurāṇe āgneye snānādividhirnāma dvisaptatitamo'dhyāyaḥ ||"}]}