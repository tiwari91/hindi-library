{"book":"agni-purana","n":240,"title":"अध्याय २४०","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A8%E0%A5%AA%E0%A5%A6","items":[{"id":"240.1","n":"००१","speaker":"राम उवाच","text":"मण्डलं चिन्तयेत्मुख्यं राजा द्वादशराजकं ।२४०.००१","tr":"maṇḍalaṃ cintayetmukhyaṃ rājā dvādaśarājakaṃ |240.001"},{"id":"240.2","n":"००१","text":"अरिर्मित्रमरेर्मित्रं मित्रमित्रमतः परं ॥२४०.००१","tr":"arirmitramarermitraṃ mitramitramataḥ paraṃ ||240.001"},{"id":"240.3","n":"००२","text":"तथारिमित्रमित्रञ्च विजिगीषोः पुरः स्मृताः(१) ।२४०.००२","tr":"tathārimitramitrañca vijigīṣoḥ puraḥ smṛtāḥ(1) |240.002"},{"id":"240.4","n":"००२","text":"पार्ष्णिग्राहः स्मृतः पश्चादाक्रन्दस्तदनन्तरं ॥२४०.००२","tr":"pārṣṇigrāhaḥ smṛtaḥ paścādākrandastadanantaraṃ ||240.002"},{"id":"240.5","n":"००३","text":"आसारावनयोश्चैवं विजगीषाश्च मण्डलं ।२४०.००३","tr":"āsārāvanayoścaivaṃ vijagīṣāśca maṇḍalaṃ |240.003"},{"id":"240.6","n":"००३","text":"अरेश्च विजिगीषोश्च मध्यमो भूम्यनन्तरः ॥२४०.००३","tr":"areśca vijigīṣośca madhyamo bhūmyanantaraḥ ||240.003"},{"id":"240.7","n":"००४","text":"अनुग्रहे संहतयोर्निग्रहे व्यस्तयोः प्रभुः ।२४०.००४","tr":"anugrahe saṃhatayornigrahe vyastayoḥ prabhuḥ |240.004"},{"id":"240.8","n":"००४","text":"मण्डलाद्वहिरेतेषामुदासीनो बलाधिकः ॥२४०.००४","tr":"maṇḍalādvahireteṣāmudāsīno balādhikaḥ ||240.004"},{"id":"240.9","n":"००५","text":"अनुग्रहे संहतानां व्यस्तानां च बुधे प्रभुः ।२४०.००५","tr":"anugrahe saṃhatānāṃ vyastānāṃ ca budhe prabhuḥ |240.005"},{"id":"240.10","n":"००५","text":"सन्धिञ्च विग्रहं यानमासानदि वदामि ते ॥२४०.००५","tr":"sandhiñca vigrahaṃ yānamāsānadi vadāmi te ||240.005"},{"id":"240.11","n":"००६","text":"बलवद्विग्रहीतेन सन्धिं कुर्याच्छिवाय च ।२४०.००६","tr":"balavadvigrahītena sandhiṃ kuryācchivāya ca |240.006"},{"id":"240.12","n":"००६","text":"कपाल उपहारश्च सन्तानः सङ्गतस्तथा ॥२४०.००६","tr":"kapāla upahāraśca santānaḥ saṅgatastathā ||240.006"},{"id":"240.13","n":"००७","text":"उपन्यासः प्रतीकारः संयोगः पुरुषान्तरः ।२४०.००७","tr":"upanyāsaḥ pratīkāraḥ saṃyogaḥ puruṣāntaraḥ |240.007"},{"id":"240.14","n":"००७","text":"अदृष्टनर आदिष्ट आत्मापि स उपग्रहः ॥२४०.००७","tr":"adṛṣṭanara ādiṣṭa ātmāpi sa upagrahaḥ ||240.007"},{"id":"240.15","n":"००८","text":"परिक्रमस्तथा छिन्नस्तथा च परदूषणं ।२४०.००८","tr":"parikramastathā chinnastathā ca paradūṣaṇaṃ |240.008"},{"id":"240.16","n":"००८","text":"स्कन्धोपयेयः सन्धिश्च सन्धयः षोडशेरिताः ॥२४०.००८","tr":"skandhopayeyaḥ sandhiśca sandhayaḥ ṣoḍaśeritāḥ ||240.008"},{"id":"240.17","n":"००९","text":"परस्परोपकारश्च मैत्रः सम्बन्धकस्तथा(२) ।२४०.००९","tr":"parasparopakāraśca maitraḥ sambandhakastathā(2) |240.009"},{"id":"240.18","n":"००९","text":"उपहाराश्च चत्वारस्तेषु मुख्याश्च सन्धयः ॥२४०.००९","tr":"upahārāśca catvārasteṣu mukhyāśca sandhayaḥ ||240.009"},{"id":"240.19","n":"०१०","text":"बालो वृद्धो दीर्घरोगस्तथा बन्धुवहिष्कृतः ।२४०.०१०","tr":"bālo vṛddho dīrgharogastathā bandhuvahiṣkṛtaḥ |240.010"},{"id":"240.20","n":"०१०","text":"मौरुको भीरुकजनो लुब्धो लुब्धजनस्तथा ॥२४०.०१०","tr":"mauruko bhīrukajano lubdho lubdhajanastathā ||240.010"},{"id":"240.21","n":"०११","text":"विरक्तप्रकृतिश्चैव विषयेष्वतिशक्तिमान् ।२४०.०११","tr":"viraktaprakṛtiścaiva viṣayeṣvatiśaktimān |240.011"},{"id":"240.22","n":"०११","text":"अनेकचित्तमन्त्रश्च देवब्राह्मणनिन्दकः ॥२४०.०११","tr":"anekacittamantraśca devabrāhmaṇanindakaḥ ||240.011"},{"id":"240.23","n":"०१२","text":"दैवोपहतकश्चैव दैवनिन्दक एव च ।२४०.०१२","tr":"daivopahatakaścaiva daivanindaka eva ca |240.012"},{"id":"240.24","n":"०१२","text":"दुर्भिक्षव्यसनोपेतो बलव्यसनसङ्कुलः ॥२४०.०१२","tr":"durbhikṣavyasanopeto balavyasanasaṅkulaḥ ||240.012"},{"id":"240.25","n":"०१३","text":"{{टिप्पणी|\n१ पुरःस्थिता इति ख.. , छ.. च\n२ मैत्रः सुखकरस्तथेति ग..\n}}\nस्वदेशस्थो बहुरिपुर्मुक्तः कालेन यश्च ह ।२४०.०१३","tr":"{{ṭippaṇī|\n1 puraḥsthitā iti kha.. , cha.. ca\n2 maitraḥ sukhakarastatheti ga..\n}}\nsvadeśastho bahuripurmuktaḥ kālena yaśca ha |240.013"},{"id":"240.26","n":"०१३","text":"सत्यधर्मव्यपेतश्च विंशतिः पुरुषा अमी ॥२४०.०१३","tr":"satyadharmavyapetaśca viṃśatiḥ puruṣā amī ||240.013"},{"id":"240.27","n":"०१४","text":"एर्तैः सन्धिं न कुर्वीत विगृह्णीयात्तु केबलं ।२४०.०१४","tr":"ertaiḥ sandhiṃ na kurvīta vigṛhṇīyāttu kebalaṃ |240.014"},{"id":"240.28","n":"०१४","text":"परस्परापकारेण पुंसां भवति विग्रहः ॥२४०.०१४","tr":"parasparāpakāreṇa puṃsāṃ bhavati vigrahaḥ ||240.014"},{"id":"240.29","n":"०१५","text":"आत्मनोऽभ्युदयाकाङ्क्षी पीड्यमानः परेण वा ।२४०.०१५","tr":"ātmano'bhyudayākāṅkṣī pīḍyamānaḥ pareṇa vā |240.015"},{"id":"240.30","n":"०१५","text":"देशकालबलोपेतः प्रारभेतेह विग्रहं(१) ॥२४०.०१५","tr":"deśakālabalopetaḥ prārabheteha vigrahaṃ(1) ||240.015"},{"id":"240.31","n":"०१६","text":"राज्यस्त्रीस्थानदेशानां ज्ञानस्य च बलस्य च ।२४०.०१६","tr":"rājyastrīsthānadeśānāṃ jñānasya ca balasya ca |240.016"},{"id":"240.32","n":"०१६","text":"अपहारी(२) मदो मानः पीडा वैषयिकी तथा ॥२४०.०१६","tr":"apahārī(2) mado mānaḥ pīḍā vaiṣayikī tathā ||240.016"},{"id":"240.33","n":"०१७","text":"ज्ञानात्मशक्तिधर्माणां(३) विघातो दैवमेव च ।२४०.०१७","tr":"jñānātmaśaktidharmāṇāṃ(3) vighāto daivameva ca |240.017"},{"id":"240.34","n":"०१७","text":"मित्रार्थञ्चापमानश्च तथा बन्धुविनाशनं ॥२४०.०१७","tr":"mitrārthañcāpamānaśca tathā bandhuvināśanaṃ ||240.017"},{"id":"240.35","n":"०१८","text":"भूतानुग्रहविच्छेदस्तथा मण्डलदूषणं ।२४०.०१८","tr":"bhūtānugrahavicchedastathā maṇḍaladūṣaṇaṃ |240.018"},{"id":"240.36","n":"०१८","text":"एकार्थाभिनिवेशत्वमिति विग्रहयोनयः ॥२४०.०१८","tr":"ekārthābhiniveśatvamiti vigrahayonayaḥ ||240.018"},{"id":"240.37","n":"०१९","text":"सापत्न्यं वास्तुजं स्त्रीजं वाग्जातमपराधजं ।२४०.०१९","tr":"sāpatnyaṃ vāstujaṃ strījaṃ vāgjātamaparādhajaṃ |240.019"},{"id":"240.38","n":"०१९","text":"वैरं पञ्चविधं प्रोक्तं साधनैः प्रशमन्नयेत् ॥२४०.०१९","tr":"vairaṃ pañcavidhaṃ proktaṃ sādhanaiḥ praśamannayet ||240.019"},{"id":"240.39","n":"०२०","text":"किञ्चित्फलं निष्फलं वा सन्दिग्धफलमेव च ।२४०.०२०","tr":"kiñcitphalaṃ niṣphalaṃ vā sandigdhaphalameva ca |240.020"},{"id":"240.40","n":"०२०","text":"तदात्वे दोषजननमायत्याञ्चैव निष्फलं ॥२४०.०२०","tr":"tadātve doṣajananamāyatyāñcaiva niṣphalaṃ ||240.020"},{"id":"240.41","n":"०२१","text":"आयत्याञ्च तदात्वे च दोषसञ्जननं तथा ।२४०.०२१","tr":"āyatyāñca tadātve ca doṣasañjananaṃ tathā |240.021"},{"id":"240.42","n":"०२१","text":"अपरिज्ञातवीर्येण परेण स्तोभितोऽपि वा ॥२४०.०२१","tr":"aparijñātavīryeṇa pareṇa stobhito'pi vā ||240.021"},{"id":"240.43","n":"०२२","text":"परार्थं स्त्रीनिमित्तञ्च दीर्घकालं द्विजैः सह ।२४०.०२२","tr":"parārthaṃ strīnimittañca dīrghakālaṃ dvijaiḥ saha |240.022"},{"id":"240.44","n":"०२२","text":"अकालदैवयुक्तेन बलोद्धतसखेन च ॥२४०.०२२","tr":"akāladaivayuktena baloddhatasakhena ca ||240.022"},{"id":"240.45","n":"०२३","text":"{{टिप्पणी|\n१ आत्मन इत्यदिः, विग्रहमित्यन्तः पाठः ग..पुस्तके नास्ति\n२ अवहार इति घ..\n३ ज्ञानार्थशक्तिधर्माणामिति ञ..\n}}\nतदात्वे फलसंयुक्तमायत्यां फलवर्जितं ।२४०.०२३","tr":"{{ṭippaṇī|\n1 ātmana ityadiḥ, vigrahamityantaḥ pāṭhaḥ ga..pustake nāsti\n2 avahāra iti gha..\n3 jñānārthaśaktidharmāṇāmiti ña..\n}}\ntadātve phalasaṃyuktamāyatyāṃ phalavarjitaṃ |240.023"},{"id":"240.46","n":"०२३","text":"आयत्यां फलसंयुक्तं तदात्वे निष्फलं तथा ॥२४०.०२३","tr":"āyatyāṃ phalasaṃyuktaṃ tadātve niṣphalaṃ tathā ||240.023"},{"id":"240.47","n":"०२४","text":"इतीमं षोडशविधन्नकुर्यादेव विग्रहं ।२४०.०२४","tr":"itīmaṃ ṣoḍaśavidhannakuryādeva vigrahaṃ |240.024"},{"id":"240.48","n":"०२४","text":"तदात्वायतिसंशुद्धं कर्म राजा सदाचरेत् ॥२४०.०२४","tr":"tadātvāyatisaṃśuddhaṃ karma rājā sadācaret ||240.024"},{"id":"240.49","n":"०२५","text":"हृष्टं पुष्टं बलं मत्वा गृह्णीयाद्विपरीतकं ।२४०.०२५","tr":"hṛṣṭaṃ puṣṭaṃ balaṃ matvā gṛhṇīyādviparītakaṃ |240.025"},{"id":"240.50","n":"०२५","text":"मित्रमाक्रन्द आसारो यदा स्युर्दृढभक्तयः ॥२४०.०२५","tr":"mitramākranda āsāro yadā syurdṛḍhabhaktayaḥ ||240.025"},{"id":"240.51","n":"०२६","text":"परस्य विपरीतञ्च तदा विग्रहमाचरेत् ।२४०.०२६","tr":"parasya viparītañca tadā vigrahamācaret |240.026"},{"id":"240.52","n":"०२६","text":"विगृह्य सन्धाय तथा सम्भूयाथ प्रसङ्गतः ॥२४०.०२६","tr":"vigṛhya sandhāya tathā sambhūyātha prasaṅgataḥ ||240.026"},{"id":"240.53","n":"०२७","text":"उपेक्षया च निपुणैर्यानं पञ्चविधं स्मृतं ।२४०.०२७","tr":"upekṣayā ca nipuṇairyānaṃ pañcavidhaṃ smṛtaṃ |240.027"},{"id":"240.54","n":"०२७","text":"परस्परस्य सामर्थ्यविघातादासनं स्मृतं ॥२४०.०२७","tr":"parasparasya sāmarthyavighātādāsanaṃ smṛtaṃ ||240.027"},{"id":"240.55","n":"०२८","text":"अरेश्च विजगीषोश्च यानवत्पञ्चधा स्मृतम् ।२४०.०२८","tr":"areśca vijagīṣośca yānavatpañcadhā smṛtam |240.028"},{"id":"240.56","n":"०२८","text":"बलिनीर्द्विषतोर्मध्ये वाचात्मानं समर्पयन् ॥२४०.०२८","tr":"balinīrdviṣatormadhye vācātmānaṃ samarpayan ||240.028"},{"id":"240.57","n":"०२९","text":"द्वैधीभावेन तिष्ठेत काकाक्षिवदलक्षितः ।२४०.०२९","tr":"dvaidhībhāvena tiṣṭheta kākākṣivadalakṣitaḥ |240.029"},{"id":"240.58","n":"०२९","text":"उभयोरपि सम्पाते सेवेत बलवत्तरं ॥२४०.०२९","tr":"ubhayorapi sampāte seveta balavattaraṃ ||240.029"},{"id":"240.59","n":"०३०","text":"यदा द्वावपि नेच्छेतां संश्लेषं जातसंविदौ ।२४०.०३०","tr":"yadā dvāvapi necchetāṃ saṃśleṣaṃ jātasaṃvidau |240.030"},{"id":"240.60","n":"०३०","text":"तदोपसर्पेत्तच्छत्रुमधिकं वा स्वयं व्रजेत्(१) ॥२४०.०३०","tr":"tadopasarpettacchatrumadhikaṃ vā svayaṃ vrajet(1) ||240.030"},{"id":"240.61","n":"०३१","text":"उच्छिद्यमानो बलिना निरुपायप्रतिक्रियः ।२४०.०३१","tr":"ucchidyamāno balinā nirupāyapratikriyaḥ |240.031"},{"id":"240.62","n":"०३१","text":"कुलोद्धतं सत्यमार्यमासेवेत बलोत्कटं(२) ॥२४०.०३१","tr":"kuloddhataṃ satyamāryamāseveta balotkaṭaṃ(2) ||240.031"},{"id":"240.63","n":"०३२","text":"तद्दर्शनोपास्तिकता नित्यन्तद्भावभाविता ।२४०.०३२","tr":"taddarśanopāstikatā nityantadbhāvabhāvitā |240.032"},{"id":"240.64","n":"०३२","text":"तत्कारितप्रश्रियता वृत्तं संश्रयिणः श्रुतं ॥२४०.०३२","tr":"tatkāritapraśriyatā vṛttaṃ saṃśrayiṇaḥ śrutaṃ ||240.032"},{"id":"240.65","text":"{{टिप्पणी|\n१ उभयोरित्यादिः, स्वयं व्रजेदित्यन्तः पाठः ज.. पुस्तके नास्ति\n२ बलोत्करमिति ग.. , घ.. , ज.. , ञ.. च\n}}","tr":"{{ṭippaṇī|\n1 ubhayorityādiḥ, svayaṃ vrajedityantaḥ pāṭhaḥ ja.. pustake nāsti\n2 balotkaramiti ga.. , gha.. , ja.. , ña.. ca\n}}"}]}