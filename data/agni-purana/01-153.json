{"book":"agni-purana","n":153,"title":"अध्याय १५३","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A7%E0%A5%AB%E0%A5%A9","items":[{"id":"153.1","text":"ब्रह्मचर्याश्रमधर्मः","tr":"brahmacaryāśramadharmaḥ"},{"id":"153.2","n":"००१","speaker":"पुष्कर उवाच","text":"धर्ममाश्रमिणां वक्ष्ये भुक्तिमुक्तिप्रदं शृणु ।१५३.००१","tr":"dharmamāśramiṇāṃ vakṣye bhuktimuktipradaṃ śṛṇu |153.001"},{"id":"153.3","n":"००१","text":"षोडशर्तुनिशा स्त्रीणामाद्यस्तिस्रस्तु गर्हिताः ॥१५३.००१","tr":"ṣoḍaśartuniśā strīṇāmādyastisrastu garhitāḥ ||153.001"},{"id":"153.4","n":"००२","text":"व्रजेद्युग्मासु पुत्रार्थी कर्माधानिकमिष्यते ।१५३.००२","tr":"vrajedyugmāsu putrārthī karmādhānikamiṣyate |153.002"},{"id":"153.5","n":"००२","text":"गर्भस्य स्पष्टताज्ञाने सवनं स्पन्दनात्पुरा ॥१५३.००२","tr":"garbhasya spaṣṭatājñāne savanaṃ spandanātpurā ||153.002"},{"id":"153.6","n":"००३","text":"षष्ठेऽष्टमे वा सीमन्तं पुत्रीयं नामभं शुभं ।१५३.००३","tr":"ṣaṣṭhe'ṣṭame vā sīmantaṃ putrīyaṃ nāmabhaṃ śubhaṃ |153.003"},{"id":"153.7","n":"००३","text":"अच्छिन्ननाड्यां कर्तव्यं जातकर्म विचक्षणैः ॥१५३.००३","tr":"acchinnanāḍyāṃ kartavyaṃ jātakarma vicakṣaṇaiḥ ||153.003"},{"id":"153.8","n":"००४","text":"अशौचे तु व्यतिक्रान्ते नामकर्म विधीयते ।१५३.००४","tr":"aśauce tu vyatikrānte nāmakarma vidhīyate |153.004"},{"id":"153.9","n":"००४","text":"शर्मान्तं ब्राह्मणस्योक्तं वर्मान्तं क्षत्रियस्य तु ॥१५३.००४","tr":"śarmāntaṃ brāhmaṇasyoktaṃ varmāntaṃ kṣatriyasya tu ||153.004"},{"id":"153.10","n":"००५","text":"गुप्तदासात्मकं नाम प्रशस्तं वैश्यशूद्रयोः ।१५३.००५","tr":"guptadāsātmakaṃ nāma praśastaṃ vaiśyaśūdrayoḥ |153.005"},{"id":"153.11","n":"००६","text":"xxxxx\nबालं निवेदयेद्भर्त्रे तव पुत्रोऽयमित्युत ॥१५३.००६","tr":"xxxxx\nbālaṃ nivedayedbhartre tava putro'yamityuta ||153.006"},{"id":"153.12","n":"००७","text":"यथाकुलन्तु चूडाकृद्ब्राह्मणस्योपनायनं ।१५३.००७","tr":"yathākulantu cūḍākṛdbrāhmaṇasyopanāyanaṃ |153.007"},{"id":"153.13","n":"००७","text":"गर्भाष्टमेऽष्टमे वाब्दे गर्भादेकादशे नृपे ॥१५३.००७","tr":"garbhāṣṭame'ṣṭame vābde garbhādekādaśe nṛpe ||153.007"},{"id":"153.14","n":"००८","text":"गर्भात्तु द्वादशे वैश्ये षोडशाब्दादितो न हि ।१५३.००८","tr":"garbhāttu dvādaśe vaiśye ṣoḍaśābdādito na hi |153.008"},{"id":"153.15","n":"००८","text":"मुञ्जानां वल्कलानान्तु क्रमान्मौज्ज्याः प्रकीर्तिताः ॥१५३.००८","tr":"muñjānāṃ valkalānāntu kramānmaujjyāḥ prakīrtitāḥ ||153.008"},{"id":"153.16","n":"००९","text":"मार्गवैयाघ्रबास्तानि चर्माणि व्रतचारिणां ।१५३.००९","tr":"mārgavaiyāghrabāstāni carmāṇi vratacāriṇāṃ |153.009"},{"id":"153.17","n":"००९","text":"पर्णपिप्पलबिल्वानां क्रमाद्दण्डाः प्रकीर्तिताः ॥१५३.००९","tr":"parṇapippalabilvānāṃ kramāddaṇḍāḥ prakīrtitāḥ ||153.009"},{"id":"153.18","n":"०१०","text":"केशदेशललाटास्यतुल्याः प्रोक्ताः क्रमेण तु ।१५३.०१०","tr":"keśadeśalalāṭāsyatulyāḥ proktāḥ krameṇa tu |153.010"},{"id":"153.19","n":"०१०","text":"अवक्राः सत्वचः सर्वे नाविप्लुष्टास्तु दण्डकाः ॥१५३.०१०","tr":"avakrāḥ satvacaḥ sarve nāvipluṣṭāstu daṇḍakāḥ ||153.010"},{"id":"153.20","n":"०११","text":"वासोपवीते कार्पासक्षौमोर्णानां यथाक्रमं ।१५३.०११","tr":"vāsopavīte kārpāsakṣaumorṇānāṃ yathākramaṃ |153.011"},{"id":"153.21","n":"०११","text":"आदिमध्यावसानेषु भवच्छब्दोपलक्षितं ॥१५३.०११","tr":"ādimadhyāvasāneṣu bhavacchabdopalakṣitaṃ ||153.011"},{"id":"153.22","n":"०१२","text":"प्रथमं तत्र भिक्षेत यत्र भिक्षा ध्रुवं भवेत् ।१५३.०१२","tr":"prathamaṃ tatra bhikṣeta yatra bhikṣā dhruvaṃ bhavet |153.012"},{"id":"153.23","n":"०१२","text":"स्त्रीणाममन्त्रतस्तानि विवाहस्तु समन्त्रकः ॥१५३.०१२","tr":"strīṇāmamantratastāni vivāhastu samantrakaḥ ||153.012"},{"id":"153.24","n":"०१३","text":"उपनीय गुरुः शिष्यं शिक्षयेच्छौचमादितः ।१५३.०१३","tr":"upanīya guruḥ śiṣyaṃ śikṣayecchaucamāditaḥ |153.013"},{"id":"153.25","n":"०१३","text":"आचारमग्निकार्यं च सन्ध्योपासनमेव च ॥१५३.०१३","tr":"ācāramagnikāryaṃ ca sandhyopāsanameva ca ||153.013"},{"id":"153.26","n":"०१४","text":"आयुष्यं प्राङ्मुखो भुङ्क्ते यशस्यं दक्षिणामुखः ।१५३.०१४","tr":"āyuṣyaṃ prāṅmukho bhuṅkte yaśasyaṃ dakṣiṇāmukhaḥ |153.014"},{"id":"153.27","n":"०१४","text":"श्रियं प्रत्यङ्मुखो भुङ्क्ते ऋतं भुङ्क्ते उदङ्मुखः ॥१५३.०१४","tr":"śriyaṃ pratyaṅmukho bhuṅkte ṛtaṃ bhuṅkte udaṅmukhaḥ ||153.014"},{"id":"153.28","n":"०१५","text":"सायं प्रातश्च जुहुयान्नामेध्यं व्यस्तहस्तकं ।१५३.०१५","tr":"sāyaṃ prātaśca juhuyānnāmedhyaṃ vyastahastakaṃ |153.015"},{"id":"153.29","n":"०१५","text":"मधु मांसं जनैः सार्धं गीतं नृत्यञ्च वै त्यजेत्(१) ॥१५३.०१५","tr":"madhu māṃsaṃ janaiḥ sārdhaṃ gītaṃ nṛtyañca vai tyajet(1) ||153.015"},{"id":"153.30","n":"०१६","text":"टिप्पणी\n१ नृत्यञ्च वर्जयेदिति ख.. , ग.. , घ.. , ङ.. , छ.. , ञ.. , ट.. च । सायं प्रातश्चेत्यादिः, नृत्यञ्च वै त्यजेदित्यन्तः पाठः ज.. पुस्तके नास्ति\nहिंसां परापवादं च अश्लीलं च विशेषतः ।१५३.०१६","tr":"ṭippaṇī\n1 nṛtyañca varjayediti kha.. , ga.. , gha.. , ṅa.. , cha.. , ña.. , ṭa.. ca | sāyaṃ prātaścetyādiḥ, nṛtyañca vai tyajedityantaḥ pāṭhaḥ ja.. pustake nāsti\nhiṃsāṃ parāpavādaṃ ca aślīlaṃ ca viśeṣataḥ |153.016"},{"id":"153.31","n":"०१६","text":"दण्डादि धारयेन्नष्टमप्सु क्षिप्त्वान्यधारणं ॥१५३.०१६","tr":"daṇḍādi dhārayennaṣṭamapsu kṣiptvānyadhāraṇaṃ ||153.016"},{"id":"153.32","n":"०१७","text":"वेदस्वीकरणं कृत्वा स्रायाद्वै दत्तदक्षिणः ।१५३.०१७","tr":"vedasvīkaraṇaṃ kṛtvā srāyādvai dattadakṣiṇaḥ |153.017"},{"id":"153.33","n":"०१७","text":"नैष्ठिको ब्रह्मचारी वा देहान्तं निवसेद्गुरौ ॥१५३.०१७","tr":"naiṣṭhiko brahmacārī vā dehāntaṃ nivasedgurau ||153.017"},{"id":"153.34","text":"इत्याग्नेये महापुराणे ब्रह्मचर्याश्रमो नाम त्रिपञ्चाशदधिकशततमोऽध्यायः ॥","tr":"ityāgneye mahāpurāṇe brahmacaryāśramo nāma tripañcāśadadhikaśatatamo'dhyāyaḥ ||"}]}