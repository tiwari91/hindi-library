{"book":"agni-purana","n":219,"title":"अध्याय २१९","src":"https://sa.wikisource.org/wiki/%E0%A4%85%E0%A4%97%E0%A5%8D%E0%A4%A8%E0%A4%BF%E0%A4%AA%E0%A5%81%E0%A4%B0%E0%A4%BE%E0%A4%A3%E0%A4%AE%E0%A5%8D/%E0%A4%85%E0%A4%A7%E0%A5%8D%E0%A4%AF%E0%A4%BE%E0%A4%AF%E0%A4%83_%E0%A5%A8%E0%A5%A7%E0%A5%AF","items":[{"id":"219.1","n":"००१","speaker":"पुष्कर उवाच","text":"राजदेवाद्यभिषेकमन्त्रान्वक्ष्येऽघमर्दनान् ।२१९.००१","tr":"rājadevādyabhiṣekamantrānvakṣye'ghamardanān |219.001"},{"id":"219.2","n":"००१","text":"कुम्भात्कुशोदकैः सिञ्चेत्तेन सर्वं हि सिद्ध्यति ॥२१९.००१","tr":"kumbhātkuśodakaiḥ siñcettena sarvaṃ hi siddhyati ||219.001"},{"id":"219.3","n":"००२","text":"सुरास्त्वामभिषिञ्चन्तु ब्रह्मविष्णुमहेश्वराः ।२१९.००२","tr":"surāstvāmabhiṣiñcantu brahmaviṣṇumaheśvarāḥ |219.002"},{"id":"219.4","n":"००२","text":"वासुदेवः सङ्कर्षणः प्रद्युम्नश्चानिरुद्धकः ॥२१९.००२","tr":"vāsudevaḥ saṅkarṣaṇaḥ pradyumnaścāniruddhakaḥ ||219.002"},{"id":"219.5","n":"००३","text":"भवन्तु विजयायैते इन्द्राद्या दशदिग्गताः ।२१९.००३","tr":"bhavantu vijayāyaite indrādyā daśadiggatāḥ |219.003"},{"id":"219.6","n":"००३","text":"रुद्रो धर्मो मनुर्दक्षो रुचिः श्रद्धा च सर्वदा ॥२१९.००३","tr":"rudro dharmo manurdakṣo ruciḥ śraddhā ca sarvadā ||219.003"},{"id":"219.7","n":"००४","text":"भृगुरत्रिर्वसिष्ठश्च सनकश्च सनन्दनः ।२१९.००४","tr":"bhṛguratrirvasiṣṭhaśca sanakaśca sanandanaḥ |219.004"},{"id":"219.8","n":"००४","text":"सनत्कुमारोऽङ्गिराश्च पुलस्त्यः पुलहः क्रतुः ॥२१९.००४","tr":"sanatkumāro'ṅgirāśca pulastyaḥ pulahaḥ kratuḥ ||219.004"},{"id":"219.9","n":"००५","text":"मरीचिः कश्यपः पान्तु प्रजेशाः पृथिवीपतिः ।२१९.००५","tr":"marīciḥ kaśyapaḥ pāntu prajeśāḥ pṛthivīpatiḥ |219.005"},{"id":"219.10","n":"००५","text":"प्रभासुरा वहिर्षद अग्निष्वात्ताश्च पान्तु ते ॥२१९.००५","tr":"prabhāsurā vahirṣada agniṣvāttāśca pāntu te ||219.005"},{"id":"219.11","n":"००६","text":"क्रव्यादाश्चोपहूताश्च आज्यपाश्च सुकालिनः ।२१९.००६","tr":"kravyādāścopahūtāśca ājyapāśca sukālinaḥ |219.006"},{"id":"219.12","n":"००६","text":"अग्निभिश्चाभिषिञ्चन्तु लक्ष्म्याद्या धर्मवल्लभाः ॥२१९.००६","tr":"agnibhiścābhiṣiñcantu lakṣmyādyā dharmavallabhāḥ ||219.006"},{"id":"219.13","n":"००७","text":"आदित्याद्याः कश्यपस्य बहुपुत्रस्य(१) वल्लभाः ।२१९.००७","tr":"ādityādyāḥ kaśyapasya bahuputrasya(1) vallabhāḥ |219.007"},{"id":"219.14","n":"००७","text":"कृशाश्वस्याग्निपुत्रस्य भार्याश्चारिष्ठनेमिनः ॥२१९.००७","tr":"kṛśāśvasyāgniputrasya bhāryāścāriṣṭhaneminaḥ ||219.007"},{"id":"219.15","n":"००८","text":"अश्विन्याद्याश्च चन्द्रस्य पुलहस्य(२) तथा प्रियाः ।२१९.००८","tr":"aśvinyādyāśca candrasya pulahasya(2) tathā priyāḥ |219.008"},{"id":"219.16","n":"००८","text":"भूता च कपिशा दंष्ट्री सुरसा सरमा दनुः ॥२१९.००८","tr":"bhūtā ca kapiśā daṃṣṭrī surasā saramā danuḥ ||219.008"},{"id":"219.17","n":"००९","text":"श्येनी भासी तथा क्रौञ्ची धृतराष्ट्री शुकी तथा ।२१९.००९","tr":"śyenī bhāsī tathā krauñcī dhṛtarāṣṭrī śukī tathā |219.009"},{"id":"219.18","n":"००९","text":"पत्न्यस्त्वामभिषिञ्चन्तु अरुणश्चार्कसारथिः ॥२१९.००९","tr":"patnyastvāmabhiṣiñcantu aruṇaścārkasārathiḥ ||219.009"},{"id":"219.19","n":"०१०","text":"आयतिर्नियतीरात्रिर्निद्रा लोकस्थितौ स्थिताः ।२१९.०१०","tr":"āyatirniyatīrātrirnidrā lokasthitau sthitāḥ |219.010"},{"id":"219.20","n":"०१०","text":"उमा मेना शची पान्तु धूमोर्नानिर्ऋतिर्जये ॥२१९.०१०","tr":"umā menā śacī pāntu dhūmornānirṛtirjaye ||219.010"},{"id":"219.21","n":"०११","text":"गौरी शिवा च ऋद्धिश्च वेला चैव नड्वला ।२१९.०११","tr":"gaurī śivā ca ṛddhiśca velā caiva naḍvalā |219.011"},{"id":"219.22","n":"०११","text":"अशिक्नी च(३) तथा ज्योत्स्ना देवपत्न्यो वनस्पतिः ॥२१९.०११","tr":"aśiknī ca(3) tathā jyotsnā devapatnyo vanaspatiḥ ||219.011"},{"id":"219.23","n":"०१२","text":"महाकल्पश्च कल्पश्च मन्वन्तरयुगानि च ।२१९.०१२","tr":"mahākalpaśca kalpaśca manvantarayugāni ca |219.012"},{"id":"219.24","n":"०१२","text":"संवत्सराणि वर्षाणि पान्तु त्वामयनद्वयं ॥२१९.०१२","tr":"saṃvatsarāṇi varṣāṇi pāntu tvāmayanadvayaṃ ||219.012"},{"id":"219.25","n":"०१३","text":"ऋतवश्च तथा मासा पक्षा रात्र्यहनी तथा ।२१९.०१३","tr":"ṛtavaśca tathā māsā pakṣā rātryahanī tathā |219.013"},{"id":"219.26","n":"०१३","text":"सन्ध्यातिथिमुहूर्ताच्च कालस्यावयवाकृतिः ॥२१९.०१३","tr":"sandhyātithimuhūrtācca kālasyāvayavākṛtiḥ ||219.013"},{"id":"219.27","n":"०१४","text":"सूर्याद्याश्च ग्रहाः पान्तु मनुः स्वायम्भुवादिकः ।२१९.०१४","tr":"sūryādyāśca grahāḥ pāntu manuḥ svāyambhuvādikaḥ |219.014"},{"id":"219.28","n":"०१४","text":"स्वायम्भुवः स्वारोचिष औत्तमिस्तामसो मनुः ॥२१९.०१४","tr":"svāyambhuvaḥ svārociṣa auttamistāmaso manuḥ ||219.014"},{"id":"219.29","n":"०१५","text":"रैवतश्चाक्षुषः षष्ठो वैवस्वत इहेरितः ।२१९.०१५","tr":"raivataścākṣuṣaḥ ṣaṣṭho vaivasvata iheritaḥ |219.015"},{"id":"219.30","n":"०१५","text":"सावर्णो ब्रह्मपुत्रश्च धर्मपुत्रश्च रुद्रजः ॥२१९.०१५","tr":"sāvarṇo brahmaputraśca dharmaputraśca rudrajaḥ ||219.015"},{"id":"219.31","n":"०१६","text":"दक्षजो रौच्यभौत्यौ च मनवस्तु चतुर्दश ।२१९.०१६","tr":"dakṣajo raucyabhautyau ca manavastu caturdaśa |219.016"},{"id":"219.32","n":"०१६","text":"विश्वभुक्च विपश्चिच्च सुचित्तिश्च शिखी विभुः ॥२१९.०१६","tr":"viśvabhukca vipaścicca sucittiśca śikhī vibhuḥ ||219.016"},{"id":"219.33","n":"०१७","text":"मनोजवस्तथौजस्वी बलिरद्भुतशान्तयः ।२१९.०१७","tr":"manojavastathaujasvī baliradbhutaśāntayaḥ |219.017"},{"id":"219.34","n":"०१७","text":"वृषश्च ऋतधामा च दिवस्पृक्कविरिन्द्रकः ॥२१९.०१७","tr":"vṛṣaśca ṛtadhāmā ca divaspṛkkavirindrakaḥ ||219.017"},{"id":"219.35","n":"०१८","text":"रेवन्तश्च कुमारश्च तथा वत्सविनायकः ।२१९.०१८","tr":"revantaśca kumāraśca tathā vatsavināyakaḥ |219.018"},{"id":"219.36","n":"०१९","text":"वीरभद्रश्च नन्दी च विश्वकर्मा पुरोजवः ॥२१९.०१८ ब्\nएते त्वामभिषिञ्चन्तु सुरमुख्याः समागताः ।२१९.०१९","tr":"vīrabhadraśca nandī ca viśvakarmā purojavaḥ ||219.018 b\nete tvāmabhiṣiñcantu suramukhyāḥ samāgatāḥ |219.019"},{"id":"219.37","n":"०१९","text":"नासत्यौ देवभिषजौ ध्रुवाद्या वसवोऽष्ट च ॥२१९.०१९","tr":"nāsatyau devabhiṣajau dhruvādyā vasavo'ṣṭa ca ||219.019"},{"id":"219.38","n":"०२०","text":"दश चाङ्गिरसो वेदास्त्वाभिषिञ्चन्तु सिद्धये ।२१९.०२०","tr":"daśa cāṅgiraso vedāstvābhiṣiñcantu siddhaye |219.020"},{"id":"219.39","n":"०२०","text":"आत्मा ह्यायुर्मनो दक्षो मदः प्राणस्तथैव च ॥२१९.०२०","tr":"ātmā hyāyurmano dakṣo madaḥ prāṇastathaiva ca ||219.020"},{"id":"219.40","n":"०२१","text":"हविष्मांश्च गरिष्ठश्च ऋतः सत्यश्च पान्तु वः ।२१९.०२१","tr":"haviṣmāṃśca gariṣṭhaśca ṛtaḥ satyaśca pāntu vaḥ |219.021"},{"id":"219.41","n":"०२१","text":"क्रतुर्दक्षो वसुः सत्यः कालकामो धुरिर्जये ॥२१९.०२१","tr":"kraturdakṣo vasuḥ satyaḥ kālakāmo dhurirjaye ||219.021"},{"id":"219.42","n":"०२२","text":"पुरूरवा माद्रवाश्च विश्वेदेवाश्च रोचनः ।२१९.०२२","tr":"purūravā mādravāśca viśvedevāśca rocanaḥ |219.022"},{"id":"219.43","n":"०२२","text":"अङ्गारकाद्याः सूर्यस्त्वान्निर्ऋतिश्च तथा यमः ॥२१९.०२२","tr":"aṅgārakādyāḥ sūryastvānnirṛtiśca tathā yamaḥ ||219.022"},{"id":"219.44","n":"०२३","text":"अजैकपादहिर्व्रध्रो धूमकेतुश्च रुद्रजाः(१) ।२१९.०२३","tr":"ajaikapādahirvradhro dhūmaketuśca rudrajāḥ(1) |219.023"},{"id":"219.45","n":"०२३","text":"भरतश्च तथा मृत्युः कापालिरथ किङ्किणिः ॥२१९.०२३","tr":"bharataśca tathā mṛtyuḥ kāpāliratha kiṅkiṇiḥ ||219.023"},{"id":"219.46","n":"०२४","text":"भवनो भावनः पान्तु स्वजन्यः स्वजनस्तथा(१) ।२१९.०२४","tr":"bhavano bhāvanaḥ pāntu svajanyaḥ svajanastathā(1) |219.024"},{"id":"219.47","n":"०२४","text":"क्रतुश्रवाश्च मूर्धा च याजनोऽभ्युशनास्तथा ॥२१९.०२४","tr":"kratuśravāśca mūrdhā ca yājano'bhyuśanāstathā ||219.024"},{"id":"219.48","n":"०२५","text":"प्रसवश्चाव्ययश्चैव दक्षश्च भृगवः सुराः ।२१९.०२५","tr":"prasavaścāvyayaścaiva dakṣaśca bhṛgavaḥ surāḥ |219.025"},{"id":"219.49","n":"०२५","text":"मनोऽनुमन्ता प्राणश्च नवोपानश्च वीर्यवान् ॥२१९.०२५","tr":"mano'numantā prāṇaśca navopānaśca vīryavān ||219.025"},{"id":"219.50","n":"०२६","text":"वीतिहोत्रो नयः साध्यो हंसो नारायणोऽवतु ।२१९.०२६","tr":"vītihotro nayaḥ sādhyo haṃso nārāyaṇo'vatu |219.026"},{"id":"219.51","n":"०२६","text":"विभुश्चैव प्रभुश्चैव देवश्रेष्ठा जगद्धिताः ॥२१९.०२६","tr":"vibhuścaiva prabhuścaiva devaśreṣṭhā jagaddhitāḥ ||219.026"},{"id":"219.52","n":"०२७","text":"धाता मित्रोऽर्यमा पूषा शक्रोऽथ वरुणो भगः ।२१९.०२७","tr":"dhātā mitro'ryamā pūṣā śakro'tha varuṇo bhagaḥ |219.027"},{"id":"219.53","n":"०२७","text":"त्वष्टा विवस्वान् सविता विष्णुर्द्वादश भास्कराः ॥२१९.०२७","tr":"tvaṣṭā vivasvān savitā viṣṇurdvādaśa bhāskarāḥ ||219.027"},{"id":"219.54","n":"०२८","text":"एकज्योतिश्च द्विज्योतिस्त्रिश्चतुर्ज्योतिरेव च ।२१९.०२८","tr":"ekajyotiśca dvijyotistriścaturjyotireva ca |219.028"},{"id":"219.55","n":"०२८","text":"एकशक्रो द्विशक्रश्च त्रिशक्रश्च महाबलः ॥२१९.०२८","tr":"ekaśakro dviśakraśca triśakraśca mahābalaḥ ||219.028"},{"id":"219.56","n":"०२९","text":"इन्द्रश्च मेत्यादिशतु ततः प्रतिमकृत्तथा ।२१९.०२९","tr":"indraśca metyādiśatu tataḥ pratimakṛttathā |219.029"},{"id":"219.57","n":"०२९","text":"मितश्च सम्मितश्चैव अमितश्च महाबलः ॥२१९.०२९","tr":"mitaśca sammitaścaiva amitaśca mahābalaḥ ||219.029"},{"id":"219.58","n":"०३०","text":"ऋतजित्सत्यजिच्चैव सुषेणः सेनजित्तथा ।२१९.०३०","tr":"ṛtajitsatyajiccaiva suṣeṇaḥ senajittathā |219.030"},{"id":"219.59","n":"०३०","text":"अतिमित्रोऽनुमित्रश्च पुरुमित्रोऽपराजितः ॥२१९.०३०","tr":"atimitro'numitraśca purumitro'parājitaḥ ||219.030"},{"id":"219.60","n":"०३१","text":"ऋतश्च ऋतवाग्धाता विधाता(२) धारणो ध्रुवः ।२१९.०३१","tr":"ṛtaśca ṛtavāgdhātā vidhātā(2) dhāraṇo dhruvaḥ |219.031"},{"id":"219.61","n":"०३१","text":"विधारणो महातेजा वासवस्य परः सखा ॥२१९.०३१","tr":"vidhāraṇo mahātejā vāsavasya paraḥ sakhā ||219.031"},{"id":"219.62","n":"०३२","text":"ईदृक्षश्चाप्यदृक्षश्च(३) एतादृगमिताशनः ।२१९.०३२","tr":"īdṛkṣaścāpyadṛkṣaśca(3) etādṛgamitāśanaḥ |219.032"},{"id":"219.63","n":"०३२","text":"क्रीडितश्च सदृक्षश्च सरभश्च महातपाः ॥२१९.०३२","tr":"krīḍitaśca sadṛkṣaśca sarabhaśca mahātapāḥ ||219.032"},{"id":"219.64","n":"०३३","text":"धर्ता धुर्यो धुरिर्भीम अभिमुक्तः क्षपात्सह(१) ।२१९.०३३","tr":"dhartā dhuryo dhurirbhīma abhimuktaḥ kṣapātsaha(1) |219.033"},{"id":"219.65","n":"०३३","text":"धृतिर्वसुरनाधृष्यो(२) रामः कामो जयो विराट् ॥२१९.०३३","tr":"dhṛtirvasuranādhṛṣyo(2) rāmaḥ kāmo jayo virāṭ ||219.033"},{"id":"219.66","n":"०३४","text":"देवा एकोनपञ्चाशन्मरुतस्त्वामवन्तु ते ।२१९.०३४","tr":"devā ekonapañcāśanmarutastvāmavantu te |219.034"},{"id":"219.67","n":"०३४","text":"चित्राङ्गदश्चित्ररथः चित्रसेनश्च वै कलिः ॥२१९.०३४","tr":"citrāṅgadaścitrarathaḥ citrasenaśca vai kaliḥ ||219.034"},{"id":"219.68","n":"०३५","text":"उर्णायुरुग्रसेनश्च धृतराष्ट्रश्च नन्दकः ।२१९.०३५","tr":"urṇāyurugrasenaśca dhṛtarāṣṭraśca nandakaḥ |219.035"},{"id":"219.69","n":"०३५","text":"हाहा हूहूर्नारदश्च विश्वावसुश्च तुम्बुरुः ॥२१९.०३५","tr":"hāhā hūhūrnāradaśca viśvāvasuśca tumburuḥ ||219.035"},{"id":"219.70","n":"०३६","text":"एते त्वामभिषिञ्चन्तु गन्धर्वा विजयाय ते ।२१९.०३६","tr":"ete tvāmabhiṣiñcantu gandharvā vijayāya te |219.036"},{"id":"219.71","n":"०३६","text":"पान्तु ते कुरुपा मुख्या दिव्याश्चाप्सरसाङ्गणाः ॥२१९.०३६","tr":"pāntu te kurupā mukhyā divyāścāpsarasāṅgaṇāḥ ||219.036"},{"id":"219.72","n":"०३७","text":"अनवद्या सुकेशी च मेनकाः सह जन्यया(३) ।२१९.०३७","tr":"anavadyā sukeśī ca menakāḥ saha janyayā(3) |219.037"},{"id":"219.73","n":"०३७","text":"क्रतुस्थला घृताची च विश्वाची पुञ्जिकस्थला ॥२१९.०३७","tr":"kratusthalā ghṛtācī ca viśvācī puñjikasthalā ||219.037"},{"id":"219.74","n":"०३८","text":"प्रम्लोचा चोर्वशी रम्भा पञ्चचूडा तिलोत्तमा ।२१९.०३८","tr":"pramlocā corvaśī rambhā pañcacūḍā tilottamā |219.038"},{"id":"219.75","n":"०३८","text":"चित्रलेखा लक्ष्मणा च पुण्डरीका च वारुणी ॥२१९.०३८","tr":"citralekhā lakṣmaṇā ca puṇḍarīkā ca vāruṇī ||219.038"},{"id":"219.76","n":"०३९","text":"प्रह्लादो विरोचनोऽथ बलिर्वाणोऽथ तत्सुताः ।२१९.०३९","tr":"prahlādo virocano'tha balirvāṇo'tha tatsutāḥ |219.039"},{"id":"219.77","n":"०३९","text":"एते चान्येऽभिषिञ्चन्तु दानवा राक्षसास्तथा ॥२१९.०३९","tr":"ete cānye'bhiṣiñcantu dānavā rākṣasāstathā ||219.039"},{"id":"219.78","n":"०४०","text":"हेतिश्चैव प्रहेतिश्च विद्युत्स्फुर्जथुरग्रकाः ।२१९.०४०","tr":"hetiścaiva prahetiśca vidyutsphurjathuragrakāḥ |219.040"},{"id":"219.79","n":"०४०","text":"यक्षः सिद्धार्मकः पातु माणिभद्रश्च नन्दनः ॥२१९.०४०","tr":"yakṣaḥ siddhārmakaḥ pātu māṇibhadraśca nandanaḥ ||219.040"},{"id":"219.80","n":"०४१","text":"पिङ्गाक्षो द्युतिमांश्चैव पुष्पवन्तो जयावहः ।२१९.०४१","tr":"piṅgākṣo dyutimāṃścaiva puṣpavanto jayāvahaḥ |219.041"},{"id":"219.81","n":"०४१","text":"शङ्खः पद्मश्च मकरः कच्छपश्च निधिर्जये ॥२१९.०४१","tr":"śaṅkhaḥ padmaśca makaraḥ kacchapaśca nidhirjaye ||219.041"},{"id":"219.82","n":"०४२","text":"पिशाचा ऊर्ध्वकेशाद्या भूता भूम्यादिवासिनः ।२१९.०४२","tr":"piśācā ūrdhvakeśādyā bhūtā bhūmyādivāsinaḥ |219.042"},{"id":"219.83","n":"०४२","text":"महाकालं पुरस्कृत्य नरसिंहञ्च मातरः ॥२१९.०४२","tr":"mahākālaṃ puraskṛtya narasiṃhañca mātaraḥ ||219.042"},{"id":"219.84","n":"०४३","text":"गुहः स्कन्दो विशाखस्त्वान्नैगमेयोऽभिषिञ्चतु ।२१९.०४३","tr":"guhaḥ skando viśākhastvānnaigameyo'bhiṣiñcatu |219.043"},{"id":"219.85","n":"०४३","text":"डाकिन्यो याश्च योगिन्यः खेचरा भूचराश्च याः ॥२१९.०४३","tr":"ḍākinyo yāśca yoginyaḥ khecarā bhūcarāśca yāḥ ||219.043"},{"id":"219.86","n":"०४४","text":"गरुडश्चारुणः पान्तु सम्पातिप्रमुखाः खगाः ।२१९.०४४","tr":"garuḍaścāruṇaḥ pāntu sampātipramukhāḥ khagāḥ |219.044"},{"id":"219.87","n":"०४४","text":"अनन्ताद्या महानागाः शेषवासुकितक्षकाः ॥२१९.०४४","tr":"anantādyā mahānāgāḥ śeṣavāsukitakṣakāḥ ||219.044"},{"id":"219.88","n":"०४५","text":"ऐरावतो महापद्मः कम्बलाश्वतरावुभौ ।२१९.०४५","tr":"airāvato mahāpadmaḥ kambalāśvatarāvubhau |219.045"},{"id":"219.89","n":"०४५","text":"शङ्खः कर्कोटकश्चैव धृतराष्ट्रो धनञ्जयः ॥२१९.०४५","tr":"śaṅkhaḥ karkoṭakaścaiva dhṛtarāṣṭro dhanañjayaḥ ||219.045"},{"id":"219.90","n":"०४६","text":"कुमुदैरावणौ पद्मः पुष्पदन्तोऽथ वामनः ।२१९.०४६","tr":"kumudairāvaṇau padmaḥ puṣpadanto'tha vāmanaḥ |219.046"},{"id":"219.91","n":"०४६","text":"सुप्रतीकोऽञ्जनो नागाः पान्तु त्वां सर्वतः सदा ॥२१९.०४६","tr":"supratīko'ñjano nāgāḥ pāntu tvāṃ sarvataḥ sadā ||219.046"},{"id":"219.92","n":"०४७","text":"पैतामहस्तथा हंसो वृषभः शङ्करस्य च ।२१९.०४७","tr":"paitāmahastathā haṃso vṛṣabhaḥ śaṅkarasya ca |219.047"},{"id":"219.93","n":"०४७","text":"दुर्गासिंहश्च पान्तु त्वां यमस्य महिषस्तथा ॥२१९.०४७","tr":"durgāsiṃhaśca pāntu tvāṃ yamasya mahiṣastathā ||219.047"},{"id":"219.94","n":"०४८","text":"उच्चैःश्रवाश्चाश्वपतिस्तथा धन्वन्तरिः सदा ।२१९.०४८","tr":"uccaiḥśravāścāśvapatistathā dhanvantariḥ sadā |219.048"},{"id":"219.95","n":"०४८","text":"कौस्तुभः शङ्कराजश्च वज्रं शूलञ्च चक्रकं ॥२१९.०४८","tr":"kaustubhaḥ śaṅkarājaśca vajraṃ śūlañca cakrakaṃ ||219.048"},{"id":"219.96","n":"०४९","text":"नन्दकोऽस्त्राणि रक्षन्तु धर्मश्च व्यवसायकः ।२१९.०४९","tr":"nandako'strāṇi rakṣantu dharmaśca vyavasāyakaḥ |219.049"},{"id":"219.97","n":"०४९","text":"चित्रगुप्तश्च दण्डश्च पिङ्गलो मृत्युकालकौ ॥२१९.०४९","tr":"citraguptaśca daṇḍaśca piṅgalo mṛtyukālakau ||219.049"},{"id":"219.98","n":"०५०","text":"बालखिल्यादिमुनयो व्यासवाल्मीकिमुख्यकाः ।२१९.०५०","tr":"bālakhilyādimunayo vyāsavālmīkimukhyakāḥ |219.050"},{"id":"219.99","n":"०५०","text":"पृथुर्दिलीपो भरतो दुष्यन्तः शक्रजिद्वली(१) ॥२१९.०५०","tr":"pṛthurdilīpo bharato duṣyantaḥ śakrajidvalī(1) ||219.050"},{"id":"219.100","n":"०५१","text":"मल्लः ककुत्स्थश्चानेन युवनाश्वो जयद्रथः ।२१९.०५१","tr":"mallaḥ kakutsthaścānena yuvanāśvo jayadrathaḥ |219.051"},{"id":"219.101","n":"०५१","text":"मान्धाता मुचुकुन्दश्च पान्तु त्वाञ्च पुरूरवाः ॥२१९.०५१","tr":"māndhātā mucukundaśca pāntu tvāñca purūravāḥ ||219.051"},{"id":"219.102","n":"०५२","text":"वास्तुदेवाः पञ्चविंशत्तत्त्वानि विजयाय ते ।२१९.०५२","tr":"vāstudevāḥ pañcaviṃśattattvāni vijayāya te |219.052"},{"id":"219.103","n":"०५२","text":"रुक्मभौमः शिलाभौमः पतालो नीलमूर्तिकः(२) ॥२१९.०५२","tr":"rukmabhaumaḥ śilābhaumaḥ patālo nīlamūrtikaḥ(2) ||219.052"},{"id":"219.104","n":"०५३","text":"पीतरक्तः क्षितिश्चैव श्वेतभौमो रसातलं ।२१९.०५३","tr":"pītaraktaḥ kṣitiścaiva śvetabhaumo rasātalaṃ |219.053"},{"id":"219.105","n":"०५३","text":"भूल्लोकोऽथ भुवर्मुख्या जम्वूद्वीपादयः श्रिये ॥२१९.०५३","tr":"bhūlloko'tha bhuvarmukhyā jamvūdvīpādayaḥ śriye ||219.053"},{"id":"219.106","n":"०५४","text":"उत्तराः कुरवः पान्तु रम्या हिरण्यकस्तथा(१) ।२१९.०५४","tr":"uttarāḥ kuravaḥ pāntu ramyā hiraṇyakastathā(1) |219.054"},{"id":"219.107","n":"०५४","text":"भद्राश्वः केतुमालश्च वर्षश्चैव वलाहकः ॥२१९.०५४","tr":"bhadrāśvaḥ ketumālaśca varṣaścaiva valāhakaḥ ||219.054"},{"id":"219.108","n":"०५५","text":"हरिवर्षः किम्पुरुष इन्द्रद्वीपः कशेरुमान् ।२१९.०५५","tr":"harivarṣaḥ kimpuruṣa indradvīpaḥ kaśerumān |219.055"},{"id":"219.109","n":"०५५","text":"ताम्रवर्णो गभस्तिमान्नागद्वीपश्च सौम्यकः ॥२१९.०५५","tr":"tāmravarṇo gabhastimānnāgadvīpaśca saumyakaḥ ||219.055"},{"id":"219.110","n":"०५६","text":"गन्धर्वो वरुणो यश्च नवमः पान्तु राज्यदाः ।२१९.०५६","tr":"gandharvo varuṇo yaśca navamaḥ pāntu rājyadāḥ |219.056"},{"id":"219.111","n":"०५६","text":"हिमवान् हेमकूटश्च निषधो नील एव च ॥२१९.०५६","tr":"himavān hemakūṭaśca niṣadho nīla eva ca ||219.056"},{"id":"219.112","n":"०५७","text":"श्वेतश्च शृङवान्मेरुर्माल्यवान् गन्धमादनः ।२१९.०५७","tr":"śvetaśca śṛṅavānmerurmālyavān gandhamādanaḥ |219.057"},{"id":"219.113","n":"०५७","text":"महेन्द्रो मलयः सह्यः शक्तिमानृक्षवान् गिरिः ॥२१९.०५७","tr":"mahendro malayaḥ sahyaḥ śaktimānṛkṣavān giriḥ ||219.057"},{"id":"219.114","n":"०५८","text":"विन्ध्यश्च पारिपात्रश्च गिरयः शान्तिदास्तु ते ।२१९.०५८","tr":"vindhyaśca pāripātraśca girayaḥ śāntidāstu te |219.058"},{"id":"219.115","n":"०५८","text":"ऋग्वेदाद्याः षडङ्गानि इतिहासपुराणकं ॥२१९.०५८","tr":"ṛgvedādyāḥ ṣaḍaṅgāni itihāsapurāṇakaṃ ||219.058"},{"id":"219.116","n":"०५९","text":"आयुर्वेदश्च गन्धर्वधनुर्वेदोपवेदकाः ।२१९.०५९","tr":"āyurvedaśca gandharvadhanurvedopavedakāḥ |219.059"},{"id":"219.117","n":"०५९","text":"शिक्षा कल्पो व्याकरणं निरुक्तं ज्योतिषाङ्गतिः ॥२१९.०५९","tr":"śikṣā kalpo vyākaraṇaṃ niruktaṃ jyotiṣāṅgatiḥ ||219.059"},{"id":"219.118","n":"०६०","text":"छन्दोगानि च वेदाश्च मीमांसा न्यायविस्तरः ।२१९.०६०","tr":"chandogāni ca vedāśca mīmāṃsā nyāyavistaraḥ |219.060"},{"id":"219.119","n":"०६०","text":"धर्मशास्त्रं पुराणञ्च विद्या ह्येताश्चतुर्दश ॥२१९.०६०","tr":"dharmaśāstraṃ purāṇañca vidyā hyetāścaturdaśa ||219.060"},{"id":"219.120","n":"०६१","text":"साङ्ख्यं योगः पाशुपतं वेदा वै पञ्चरात्रकं ।२१९.०६१","tr":"sāṅkhyaṃ yogaḥ pāśupataṃ vedā vai pañcarātrakaṃ |219.061"},{"id":"219.121","n":"०६१","text":"कृतान्तपञ्चकं ह्येतद्गायत्री च शिवा तथा ॥२१९.०६१","tr":"kṛtāntapañcakaṃ hyetadgāyatrī ca śivā tathā ||219.061"},{"id":"219.122","n":"०६२","text":"दुर्गा विद्या च गान्धारी पान्तु त्वां शान्तिदाश्च ते ।२१९.०६२","tr":"durgā vidyā ca gāndhārī pāntu tvāṃ śāntidāśca te |219.062"},{"id":"219.123","n":"०६२","text":"लवणेक्षुसुरासर्पिदधिदुग्धजलाब्धयः ॥२१९.०६२","tr":"lavaṇekṣusurāsarpidadhidugdhajalābdhayaḥ ||219.062"},{"id":"219.124","n":"०६३","text":"चत्वारः सागराः पान्तु तीर्थानि विविधानि च ।२१९.०६३","tr":"catvāraḥ sāgarāḥ pāntu tīrthāni vividhāni ca |219.063"},{"id":"219.125","n":"०६३","text":"पुष्करश्च प्रयागश्च प्रभासो नैमिषः परः ॥२१९.०६३","tr":"puṣkaraśca prayāgaśca prabhāso naimiṣaḥ paraḥ ||219.063"},{"id":"219.126","n":"०६४","text":"गयाशीर्षो ब्रह्मशिरस्तीर्थमुत्त्रमानसं ।२१९.०६४","tr":"gayāśīrṣo brahmaśirastīrthamuttramānasaṃ |219.064"},{"id":"219.127","n":"०६४","text":"कालोदको नन्दिकुण्डस्तीर्थं पञ्चनदस्तथा ॥२१९.०६४","tr":"kālodako nandikuṇḍastīrthaṃ pañcanadastathā ||219.064"},{"id":"219.128","n":"०६५","text":"भृगुतीर्थं प्रभासञ्च तथा चामरकण्टकं ।२१९.०६५","tr":"bhṛgutīrthaṃ prabhāsañca tathā cāmarakaṇṭakaṃ |219.065"},{"id":"219.129","n":"०६५","text":"जम्बुमार्गश्च विमलः कपिलस्य तथाश्रमः ॥२१९.०६५","tr":"jambumārgaśca vimalaḥ kapilasya tathāśramaḥ ||219.065"},{"id":"219.130","n":"०६६","text":"गङ्गाद्वारकुशावर्तौ विन्ध्यको नीलपर्वतः ।२१९.०६६","tr":"gaṅgādvārakuśāvartau vindhyako nīlaparvataḥ |219.066"},{"id":"219.131","n":"०६६","text":"वराहपर्वतश्चैव तीर्थङ्कणखलं तथा ॥२१९.०६६","tr":"varāhaparvataścaiva tīrthaṅkaṇakhalaṃ tathā ||219.066"},{"id":"219.132","n":"०६७","text":"कालञ्जरश्च केदारो रुद्रकोटिस्तथैव च ।२१९.०६७","tr":"kālañjaraśca kedāro rudrakoṭistathaiva ca |219.067"},{"id":"219.133","n":"०६७","text":"वाराणसी महातीर्थं वदर्याश्रम एव च ॥२१९.०६७","tr":"vārāṇasī mahātīrthaṃ vadaryāśrama eva ca ||219.067"},{"id":"219.134","n":"०६८","text":"द्वारका श्रीगिरिस्तीर्थं तीर्थञ्च पुरुषोत्तमः ।२१९.०६८","tr":"dvārakā śrīgiristīrthaṃ tīrthañca puruṣottamaḥ |219.068"},{"id":"219.135","n":"०६८","text":"शालग्रामोथ वाराहः सिन्धुसागरसङ्गमः ॥२१९.०६८","tr":"śālagrāmotha vārāhaḥ sindhusāgarasaṅgamaḥ ||219.068"},{"id":"219.136","n":"०६९","text":"फल्गुतीर्थं बिन्दुसरः करवीराश्रमस्तथा ।२१९.०६९","tr":"phalgutīrthaṃ bindusaraḥ karavīrāśramastathā |219.069"},{"id":"219.137","n":"०६९","text":"नद्यो गङ्गासरस्वत्यः शतदुर्गण्डकी तथा ॥२१९.०६९","tr":"nadyo gaṅgāsarasvatyaḥ śatadurgaṇḍakī tathā ||219.069"},{"id":"219.138","n":"०७०","text":"अच्छोदा च विपाशा च वितस्ता देविका नदी ।२१९.०७०","tr":"acchodā ca vipāśā ca vitastā devikā nadī |219.070"},{"id":"219.139","n":"०७०","text":"कावेरी वरुणा चैव निश्चरा गोमती नदी ॥२१९.०७०","tr":"kāverī varuṇā caiva niścarā gomatī nadī ||219.070"},{"id":"219.140","n":"०७१","text":"पारा चर्मण्वती रूपा मन्दाकिनी महानदी ।२१९.०७१","tr":"pārā carmaṇvatī rūpā mandākinī mahānadī |219.071"},{"id":"219.141","n":"०७१","text":"तापी पयोष्णी वेणा च गौरी वैतरणी तथा ॥२१९.०७१","tr":"tāpī payoṣṇī veṇā ca gaurī vaitaraṇī tathā ||219.071"},{"id":"219.142","n":"०७२","text":"गोदावरी भीमरथी तुङ्गभद्रा प्रणी तथा ।२१९.०७२","tr":"godāvarī bhīmarathī tuṅgabhadrā praṇī tathā |219.072"},{"id":"219.143","n":"०७२","text":"चन्द्रभागा शिवा गौरी अभिषिञ्चन्तु पान्तु वः(१) ॥२१९.०७२","tr":"candrabhāgā śivā gaurī abhiṣiñcantu pāntu vaḥ(1) ||219.072"},{"id":"219.144","text":"इत्याग्नेये महापुराणे अभिषेकमन्त्रा नामोनविंशत्यधिकद्विशततमोऽध्यायः ॥\n{{टिप्पणी|\n१ अभिषिञ्चन्तु पान्त चेति ख.. , ग.. , घ.. , ङ.. , छ.. , ज.. , ञ.. , ट.. च\n}}","tr":"ityāgneye mahāpurāṇe abhiṣekamantrā nāmonaviṃśatyadhikadviśatatamo'dhyāyaḥ ||\n{{ṭippaṇī|\n1 abhiṣiñcantu pānta ceti kha.. , ga.. , gha.. , ṅa.. , cha.. , ja.. , ña.. , ṭa.. ca\n}}"}]}